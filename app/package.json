{
  "name": "keel-app",
  "version": "0.2.0",
  "private": true,
  "description": "Keel 买家端（uni-app x）",
  "scripts": {
    "build:h5": "uni build --platform h5",
    "dev:h5": "uni dev --platform h5",
    "build:app-android": "uni build --platform app-android",
    "build:mp-weixin": "uni build --platform mp-weixin",
    "test:e2e": "UNI_PLATFORM=app-plus UNI_APP_PLATFORM=android UNI_OS_NAME=android UNI_APP_X=true UNI_AUTOMATOR_CONFIG=$PWD/e2e/automator.config.js jest -c e2e/jest.config.js -i --forceExit",
    "test:e2e:ios": "UNI_PLATFORM=app-plus UNI_APP_PLATFORM=ios UNI_OS_NAME=ios UNI_APP_X=true UNI_AUTOMATOR_CONFIG=$PWD/e2e/automator.config.js jest -c e2e/jest.config.js -i --forceExit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-uts": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-vite": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-x": "0.7.135",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5-vite": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-vite": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@dcloudio/uni-uts-v1": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "vite": "5.2.8",
    "vue": "3.4.21"
  },
  "optionalDependencies": {
    "@dcloudio/uts-linux-x64-gnu": "3.0.0-5020620260917001"
  },
  "devDependencies": {
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "adbkit": "2.11.1",
    "jest": "27.0.4",
    "jest-environment-node": "27.5.1",
    "playwright": "1.63.0"
  }
}
