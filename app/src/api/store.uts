// 「当前门店」：这台设备现在由哪家店服务。
//
// ## 为什么要有这一层
//
// 多门店（00020）之后，价格与可见性都按门店算：SKU 基准价 → 大区价 → 门店价，
// 大区与门店各有一层下架。下单时 store_id 是必填（契约 OrderCreateRequest），
// 而列表、详情、搜索三个读接口的 store_id 是可选的 —— 不带就回落默认店。
//
// 「可选」是个陷阱。浏览不带、结算带的话，列表按默认店算价、结算按定位解析出来
// 的那家店算价，**用户在列表上看到的价格与最后扣的钱可以不一样**，而且不报错。
// 所以这里只解析一次，四个地方用同一个 id。
//
// ## 解析规则是用户定的，不是这里发明的
//
// 服务端的 GET /stores/resolve 按下面四条回答（它们的执行者在后端测试里）：
//   1. 围栏重叠 → 按距离排，最近的那家排第一；
//   2. 不在任何围栏内 → 回落「全国配送」的默认店；
//   3. **拒绝授权定位 → 与第 2 条同一条路径**；
//   4. 商家没配默认店 → match_type = none，不在服务范围。
//
// 所以这一层只做一件事：**尽量拿到坐标，拿不到就不给**。「拿不到」不是错误，
// 它是第 3 条规则的正常入口，不弹窗、不重试、不卡住页面。
//
// ## 坐标系：必须是 WGS-84，不能是 GCJ-02
//
// 围栏存的是 GEOGRAPHY(POLYGON, 4326)，SRID 4326 就是 WGS-84。而国内的地图 SDK
// 与不少定位接口默认给的是 GCJ-02（「火星坐标」），两者在城区相差一两百米到
// 五六百米 —— **足够把一个站在门店 A 围栏里的人判到门店 B，或者判到围栏外**。
// 这种错不报错，只是「附近那家店」时对时不对。
//
// 所以 getLocation 显式传 type: 'wgs84'。它同时是不需要地图 SDK key 的那一种：
// 原生端取的是系统定位，H5 端浏览器 Geolocation 本来就是 WGS-84。
//
// **另一半在后台**：运营在地图上画围栏时，那张地图如果是高德 / 腾讯 / 百度，
// 画出来的顶点是 GCJ-02（百度还是 BD-09），存进 4326 的列之前必须换算。
// 那一侧还没做（后台的门店页目前只留了位置），做的时候这件事不能漏。
//
// ## 作用域是服务地址
//
// 和 config.uts 里的会话同一条理由：门店 id 是某一家商家的，换了服务地址
// （= 换了租户），上一家店的 store_id 在这一家毫无意义，带过去只会拿到 404
// 或者更糟的「恰好也有一个 id = 1 的门店」。所以缓存连同它是给哪个 base URL
// 解析的一起存，对不上就当没有。
//
// 只存在内存里，**不落盘**：定位会变。一个上周在公司解析出来的门店，
// 这周在家里打开 App 还用它，就是把上面第 1 条规则悄悄关掉了。每次冷启动
// 重新解析一次，代价是一次定位加一个 GET。

import { resolveStore, ApiFailure } from './client.uts'
import { getBaseUrl } from './config.uts'

/** 解析结果。页面只读它，不碰契约类型（那是 view.uts 的约定）。 */
export type CurrentStore = {
  /** 这份结果是给哪个服务地址解析的。 */
  baseUrl : string
  /** 为 null ⇔ match_type = none：这家商家不送这里，也没配默认店。 */
  storeId : number | null
  /** 展示用，比如「由 xx 门店配送」。none 时是空串。 */
  name : string
  /** fence / fallback_default / none，原样来自契约。 */
  matchType : string
}

type Pending = {
  ok : (s : CurrentStore) => void
  err : (f : ApiFailure) => void
}

let current : CurrentStore | null = null
let pending : Pending[] = []
let inFlight = false

/**
 * 定位最多等这么久。
 *
 * 有的 Android 机在没开 GPS 的时候 getLocation 既不成功也不失败，就那么挂着。
 * 首页的商品列表要等门店解析完才发请求，挂着就是白屏。所以超时之后按
 * 「拿不到坐标」处理 —— 也就是第 3 条规则，回落默认店。
 */
const LOCATE_TIMEOUT_MS = 5000

/**
 * 拿到当前门店。已经解析过（且服务地址没换）就同步回调；
 * 正在解析就排队，**不会弹第二次定位授权**。
 *
 * 解析失败（网络、服务端 5xx）走 onErr，而且**不缓存** —— 下一次调用会重来。
 * 注意这和「不在服务范围」是两回事：后者是一个成功的结果，storeId 为 null。
 */
export function ensureStore(onReady : (s : CurrentStore) => void, onErr : (f : ApiFailure) => void) {
  const base = getBaseUrl()
  if (current != null && current!.baseUrl == base) {
    onReady(current!)
    return
  }
  pending.push({ ok: onReady, err: onErr } as Pending)
  if (inFlight) {
    return
  }
  inFlight = true
  locate((lat : number | null, lng : number | null) => {
    resolveStore(lat, lng,
      (res) => {
        let id : number | null = null
        let name = ''
        if (res.stores.length > 0) {
          // 服务端已经按距离排好了（第 1 条规则），第一家就是最近的那家。
          // 这里**不**自己再排一次：两份排序实现迟早分叉。
          id = res.stores[0].id
          name = res.stores[0].name
        }
        const s : CurrentStore = {
          baseUrl: base,
          storeId: id,
          name: name,
          matchType: res.match_type,
        }
        // 解析期间服务地址被换掉了的话，这份结果属于上一个地址，不能缓存。
        if (getBaseUrl() == base) {
          current = s
        }
        flush(s, null)
      },
      (f : ApiFailure) => {
        flush(null, f)
      })
  })
}

/** 当前缓存的门店 id，没解析过或者不在服务范围时为 null。 */
export function currentStoreId() : number | null {
  const base = getBaseUrl()
  if (current != null && current!.baseUrl == base) {
    return current!.storeId
  }
  return null
}

function flush(s : CurrentStore | null, f : ApiFailure | null) {
  const waiting = pending
  pending = []
  inFlight = false
  for (let i = 0; i < waiting.length; i++) {
    if (s != null) {
      waiting[i].ok(s!)
    } else {
      waiting[i].err(f!)
    }
  }
}

/**
 * 尽量拿坐标。成功、失败、超时三条路径**恰好只回调一次**。
 *
 * 失败的原因不区分（用户拒绝授权、没开定位、没声明权限、超时）：对这一层来说
 * 它们都是「没有坐标」，而没有坐标的处理方式只有一种。
 */
function locate(done : (lat : number | null, lng : number | null) => void) {
  let settled = false
  const timer = setTimeout(() => {
    if (settled) return
    settled = true
    done(null, null)
  }, LOCATE_TIMEOUT_MS)
  uni.getLocation({
    type: 'wgs84',
    success: (res) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      done(res.latitude, res.longitude)
    },
    fail: (_err) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      done(null, null)
    },
  })
}
