// 由 scripts/gen_uts_schema.py 从 docs/电商系统-OpenAPI.yaml 生成。**请勿手改。**
//
// 手改会被 scripts/check_uts_contract.py 抓住：那个闸门把契约重新生成到临时目录
// 再和这个文件比对，对不上就红。改契约 -> `make generate-uts` -> 一起提交。
//
// 这里只有类型，没有一行运行时代码 —— 运行时在 app/src/api/client.uts。

export type Address = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  /** 门牌号等 */
  detail : string
  /** 行政区划码。比省市区三个字符串可靠 ——「内蒙古」与「内蒙古自治区」 */
  region_code? : string
  postal_code? : string
  /** 0 无 / 1 家 / 2 公司 / 3 学校 */
  tag? : number
  /** 仅在**新增**时有效（服务端同事务内先清旧默认再置新）。 */
  is_default : boolean
  id : number
  created_at? : string
  updated_at? : string
}

export type AddressInput = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  /** 门牌号等 */
  detail : string
  /** 行政区划码。比省市区三个字符串可靠 ——「内蒙古」与「内蒙古自治区」 */
  region_code? : string
  postal_code? : string
  /** 0 无 / 1 家 / 2 公司 / 3 学校 */
  tag? : number
  /** 仅在**新增**时有效（服务端同事务内先清旧默认再置新）。 */
  is_default? : boolean
}

/** 后台视角的分类，**扁平**。与前台的 `Category` 不同，它不嵌 `children`： */
export type AdminCategory = {
  id : number
  /** 为 null 即根分类。 */
  parent_id? : number | null
  name : string
  /** 物化路径，形如 `/1/23/456/`（数据模型 §3）。 */
  path : string
  /** 层级，根为 1。同样由服务端从 `parent_id` 算出。 */
  level : number
  sort_order : number
  /** `categories.status`：0 停用 / 1 启用。 */
  status : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
export type CouponType = number

/** 金额，单位「分」。禁止使用浮点。 */
export type Money = number

/** 一条适用范围规则（数据模型 §7 `coupon_scopes`）。1–4 决定哪几行商品参与计算， */
export type CouponScope = {
  /** 1全场 2分类（含子孙） 3商品 4品牌 5大区 6门店 */
  scope_type : number
  /** 全场为 null；其余按 `scope_type` 指向分类 / 商品 / 品牌 / 大区 / 门店的 id */
  target_id : number | null
  include : boolean
  /** 目标的展示名（分类名、商品标题、大区名、门店名），只读。品牌没有目录，不返回； */
  target_name? : string
}

/** 发放与核销统计。`issued = claimed + granted = unused + locked + used + expired`。 */
export type CouponTemplateStats = {
  /** 已发出（与 `issued_count` 相等） */
  issued : number
  /** 其中买家在领券中心领的 */
  claimed : number
  /** 其中商家定向发放的 */
  granted : number
  /** 未使用且未过期 */
  unused : number
  /** 被待支付订单占用中 */
  locked : number
  /** 已核销（订单已支付） */
  used : number
  /** 未使用且已过期 */
  expired : number
}

export type AdminCouponTemplate = {
  id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days : number
  /** 总量，0 = 不限 */
  total_count : number
  issued_count : number
  per_user_limit : number
  claimable : boolean
  /** 1 启用 · 0 停用（停止领取与发放，不回收已发出的券） */
  status : number
  /** 已发出过券，券面字段与范围不能再改 */
  locked : boolean
  scopes : CouponScope[]
  /** 发放与核销统计。`issued = claimed + granted = unused + locked + used + expired`。 */
  stats : CouponTemplateStats
  created_at : string
  updated_at : string
}

export type AdminInventory = {
  sku_id : number
  sku_code? : string
  /** 这一行库存属于哪家门店。**必返。** */
  store_id : number
  /** 这家门店的可售量。**这一行不存在时视同 0，不是「这家店不卖」**—— */
  available_qty : number
  warning_qty : number
  updated_at : string
}

/** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
export type OrderStatus = number

/** **资金维度** —— 钱退了多少，与 `status` 正交，由退款单驱动。 */
export type OrderRefundStatus = number

/** 下单瞬间从 `user_addresses` 拷贝的收货信息快照，落在 */
export type ReceiverSnapshot = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  detail : string
  region_code? : string
  postal_code? : string
}

/** 下单那一瞬间的门店与大区展示信息，取自 `orders.store_snapshot`。 */
export type OrderStoreSnapshot = {
  store_name : string
  store_phone? : string
  store_address? : string
  region_name? : string
}

export type OrderItem = {
  id : number
  sku_id : number
  product_id? : number
  /** 下单时快照 */
  title : string
  spec_values? : UTSJSONObject
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 已退款完成的件数 */
  refunded_qty? : number
  /** 退款流程中（退款单尚未到达 `40 已退款` 或终态）占用的件数。 */
  refunding_qty? : number
}

export type PaymentRecord = {
  payment_no? : string
  /** 对外字符串 ↔ `payments.channel`：wechat=1 / alipay=2 / balance=3 */
  channel? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents? : Money
  /** 0待支付 1成功 2失败 3已关闭 */
  status? : number
  paid_at? : string
}

export type Shipment = {
  id : number
  /** 承运商标识，如 sf / jd / yto */
  carrier_code : string
  tracking_no : string
  /** 1 已发出 · 2 已签收 · 3 异常 */
  status : number
  shipped_at : string
  delivered_at? : string
}

/** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
export type RefundType = number

/** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
export type RefundStatus = number

export type RefundItem = {
  order_item_id : number
  /** 下单时的商品标题快照 */
  title? : string
  image_url? : string
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
}

/** 对应 `refunds.reason_code`： */
export type RefundReasonCode = number

export type ReturnShipment = {
  carrier_code : string
  tracking_no : string
  /** 买家最近一次填写（或修改）的时间。不是承运商揽收时间 —— 那要查物流，一期不做 */
  submitted_at : string
}

/** 审计字段里的「谁」。`name` 取员工此刻的名字；平台级员工（不属于这家店） */
export type StaffRef = {
  id : number
  name? : string
}

/** 后台视角的退款单：买家侧 `Refund` 的全部字段，加上履约门店与审核记录。 */
export type AdminRefund = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
  /** 所属订单的履约门店（后台判权按它） */
  store_id : number
  /** 所属订单下单时的门店快照 */
  store : OrderStoreSnapshot
  /** 所属订单此刻的履约状态 */
  order_status : OrderStatus
  /** 通过或驳回这张单的员工（与 `audited_at` 同一次动作） */
  audited_by? : StaffRef
  /** 确认收到退货的时间（退货退款 `20 → 30` 那一步） */
  received_at? : string
  /** 确认收到退货的员工 */
  received_by? : StaffRef
}

export type AdminOrderDetail = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver : ReceiverSnapshot
  /** 下单时的门店与大区展示快照 */
  store : OrderStoreSnapshot
  /** 有没有处于 10 待审核 / 20 待买家退货 / 30 退款中的退款单 */
  has_open_refund : boolean
  /** 订单行，含优惠分摊（`discount_cents`）与已退 / 在途件数 */
  items : OrderItem[]
  payments : PaymentRecord[]
  /** 发货包裹，按发货先后。一期整单发货，至多一个 */
  shipments : Shipment[]
  /** 该订单下的全部退款单，按申请时间倒序 */
  refunds : AdminRefund[]
}

/** 后台视角的订单摘要：买家侧 `Order` 的全部字段，加上收货人与门店的**下单时快照**， */
export type AdminOrderSummary = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver : ReceiverSnapshot
  /** 下单时的门店与大区展示快照 */
  store : OrderStoreSnapshot
  /** 有没有处于 10 待审核 / 20 待买家退货 / 30 退款中的退款单 */
  has_open_refund : boolean
}

/** 后台视角的商品。与 `ProductSummary` 的差别是状态面： */
export type AdminProduct = {
  id : number
  title : string
  subtitle? : string
  description? : string
  category_id : number
  /** 品牌，可空。一期没有品牌管理接口，只透传。 */
  brand_id? : number | null
  /** `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** **首次**上架时间。为 null 表示从未上架过（即 `status` 一直是 0 草稿）。 */
  published_at? : string | null
  /** 软删时间。非 null 时该商品只在 `include_deleted=true` 的后台列表里出现。 */
  deleted_at? : string | null
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents : Money
  /** 未软删 SKU 的 `inventories.available_qty` 之和，服务端按需现算。 */
  total_stock : number
  /** 冗余字段，由订单变更时同步。不接受写入。 */
  sales_count : number
  created_at : string
  updated_at? : string
}

/** 后台视角的 SKU。比前台的 `Sku` 多出成本、重量、售卖开关与库存预警位—— */
export type AdminSku = {
  id : number
  product_id : number
  /** 商家自己的货号，租户内唯一（`uk_skus_code`），不是全局唯一。 */
  sku_code : string
  /** `skus.spec_values`（JSONB）。键名不由契约规定。 */
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  weight_gram? : number
  /** 该规格的小图，形如 `/api/v1/uploads/{upload_id}`。 */
  image_url? : string
  /** `skus.status`：0 停售 / 1 在售。停售的规格仍在规格矩阵里显示，但不可加购。 */
  status : number
  /** 来自 `inventories.available_qty`。改它要走 `PUT /admin/skus/{sku_id}/inventory`。 */
  available_qty : number
  /** 低库存预警线。一期只是一个存着的数，没有接到任何告警。 */
  warning_qty? : number
  created_at? : string
  updated_at? : string
}

/** 商品图与商品的关联。落地在数据模型 §3 的 `product_images` 表上—— */
export type ProductImage = {
  /** `uploads.id`。由 `POST /admin/uploads` 得到。 */
  upload_id : number
  /** 形如 `/api/v1/uploads/{upload_id}`，与 `Upload.url` 同一个形状： */
  url : string
  /** 展示顺序，从 0 起。**0 就是主图**，没有单独的 `is_primary`。 */
  sort_order : number
}

export type AdminProductDetail = {
  id : number
  title : string
  subtitle? : string
  description? : string
  category_id : number
  /** 品牌，可空。一期没有品牌管理接口，只透传。 */
  brand_id? : number | null
  /** `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** **首次**上架时间。为 null 表示从未上架过（即 `status` 一直是 0 草稿）。 */
  published_at? : string | null
  /** 软删时间。非 null 时该商品只在 `include_deleted=true` 的后台列表里出现。 */
  deleted_at? : string | null
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents : Money
  /** 未软删 SKU 的 `inventories.available_qty` 之和，服务端按需现算。 */
  total_stock : number
  /** 冗余字段，由订单变更时同步。不接受写入。 */
  sales_count : number
  created_at : string
  updated_at? : string
  /** 含已软删的 SKU 吗——**不含**。软删的 SKU 不在任何视图里返回。 */
  skus : AdminSku[]
  /** 按展示顺序，`images[0]` 是主图。 */
  images : ProductImage[]
}

export type AdminRefundDetail = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
  /** 所属订单的履约门店（后台判权按它） */
  store_id : number
  /** 所属订单下单时的门店快照 */
  store : OrderStoreSnapshot
  /** 所属订单此刻的履约状态 */
  order_status : OrderStatus
  /** 通过或驳回这张单的员工（与 `audited_at` 同一次动作） */
  audited_by? : StaffRef
  /** 确认收到退货的时间（退货退款 `20 → 30` 那一步） */
  received_at? : string
  /** 确认收到退货的员工 */
  received_by? : StaffRef
  /** 所属订单的摘要。审核退货退款时裁定运费要看 `freight_cents`（订单实收运费）； */
  order : AdminOrderSummary
}

/** 后台视角的大区。**没有几何**——大区是门店的分组， */
export type AdminRegion = {
  id : number
  /** 租户内唯一（软删的不占用）。 */
  code : string
  name : string
  /** 0 停用 / 1 启用。 */
  status : number
  /** 名下未软删的门店数。删大区时会因为它非零而被拒（409）， */
  store_count : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 后台视角的门店，**含围栏**。与买家侧的 `Store` 分成两个 schema， */
export type AdminStore = {
  id : number
  /** 所属大区，**必填且不可空**（`stores.region_id NOT NULL`）。 */
  region_id : number
  region_name? : string
  /** 租户内唯一（软删的不占用）。 */
  code : string
  name : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 电子围栏。**为 null 且 `is_default = false` 的门店是一家永远接不到单的店**—— */
  fence? : any
  /** 是否是「全国配送」的回落门店。每个商家**至多一个** */
  is_default : boolean
  /** 0 停业 / 1 营业。停业的门店不参与围栏判定，也不能下单。 */
  status : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 门店列表。比一般的分页响应多一个 `has_default`—— */
export type AdminStoreList = {
  page : number
  page_size : number
  total : number
  items : AdminStore[]
  /** 这家商家有没有默认门店。**必返。** */
  has_default : boolean
}

export type ApplicableCoupon = {
  id : number
  coupon_code : string
  template_id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比，850 = 8.5 折 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 未使用 · 2 锁定 · 3 已使用 · 4 已过期 */
  status : number
  /** 1 领券中心领取 · 2 商家定向发放 */
  source : number
  valid_start_at : string
  valid_end_at : string
  used_at? : string
  /** 这张券的适用范围（来自模板）。空数组即全场、全店。 */
  scopes : CouponScope[]
  /** 金额，单位「分」。禁止使用浮点。 */
  applicable_discount_cents : Money
}

/** 这一行此刻能不能买，按响应里 `store` 那家门店判。判定顺序即下表顺序， */
export type CartItemStatus = string

export type CartItem = {
  id : number
  sku_id : number
  product_id? : number
  title? : string
  spec_values? : UTSJSONObject
  image_url? : string
  /** **实时价，不是加购时的快照。** 购物车刻意不存价格快照（见数据模型 §10）， */
  price_cents : number | null
  quantity : number
  /** 是否勾选结算，对应 `cart_items.selected`。 */
  selected : boolean
  /** 此刻能否按 `quantity` 买下这一行，恒等于 `status == available`。 */
  available : boolean
  /** 这一行此刻能不能买，按响应里 `store` 那家门店判。判定顺序即下表顺序， */
  status : CartItemStatus
}

/** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
export type StoreMatchType = string

/** 每一条会受门店影响的读接口都回显它。**没有它，客户端拿到的 */
export type StoreContext = {
  /** 本次响应是按哪家门店算的。`match_type = none` 时为 null。 */
  store_id? : number | null
  /** 那家门店所属大区。价格的中间一层按它算。 */
  region_id? : number | null
  /** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
  match_type : StoreMatchType
}

export type Cart = {
  items : CartItem[]
  /** 本次的价格与可买状态是按哪家门店算的。**必返**，理由同 `GET /products`。 */
  store : StoreContext
  /** **全车**商品金额合计，与 `selected` 无关。 */
  total_cents : Money
  /** **仅已勾选**（`selected: true`）条目的金额合计，即点「去结算」时的预估金额。 */
  selected_total_cents : Money
}

export type Category = {
  id : number
  name : string
  level : number
  children? : Category[]
}

/** **没有 `path` 与 `level`**，它们由服务端从 `parent_id` 算出。 */
export type CategoryCreateRequest = {
  name : string
  /** 省略或为 null 即建根分类。必须属于当前租户。 */
  parent_id? : number | null
  sort_order? : number
}

/** 传 `parent_id` 就是**移动子树**，服务端会在同一事务里重写整棵子树的 */
export type CategoryUpdateRequest = {
  name? : string
  /** 显式传 `null` 表示移到根。**不传这个字段则不动层级** —— */
  parent_id? : number | null
  sort_order? : number
  /** 0 停用 / 1 启用 */
  status? : number
}

export type ProductSummary = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
}

export type ChatReplyAction = {
  type? : string
  params? : UTSJSONObject
}

export type ChatReply = {
  session_id : string
  /** 面向用户的自然语言回复 */
  reply : string
  /** 真实检索结果，非模型生成 */
  products? : ProductSummary[]
  /** 解析出的结构化意图 */
  intent? : UTSJSONObject
  /** 写操作路由指令。前端据此跳转到对应表单并预填参数， */
  action? : ChatReplyAction
}

export type ClaimableCouponTemplate = {
  id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 绝对时间 · 2 领取后 N 天 */
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days : number
  /** 还剩多少张；`null` 表示不限量 */
  remaining : number | null
  per_user_limit : number
  /** 当前买家已持有这个模板的券数（含商家定向发放的） */
  claimed_count : number
  /** 当前买家现在能不能领（没到每人限领） */
  can_claim : boolean
  scopes : CouponScope[]
}

export type OrderItemInput = {
  sku_id : number
  quantity : number
}

export type CouponApplicableRequest = {
  items : OrderItemInput[]
  /** 履约门店，必填。理由同 `OrderCreateRequest.store_id`。 */
  store_id : number
}

export type CouponGrantItem = {
  phone : string
  user_id : number
  user_coupon_id : number
  coupon_code : string
}

export type CouponGrantRequest = {
  phones : string[]
}

export type CouponGrantResult = {
  template_id : number
  /** 本次发出的张数 */
  granted : number
  coupons : CouponGrantItem[]
}

export type CouponScopeInput = {
  scope_type : number
  target_id? : number | null
  include? : boolean
}

export type CouponScopesSetRequest = {
  scopes : CouponScopeInput[]
}

export type CouponTemplateCreateRequest = {
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  discount_rate? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents? : Money
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days? : number
  /** 0 = 不限 */
  total_count? : number
  per_user_limit? : number
  claimable? : boolean
}

/** 只改传了的字段。有效期整组替换：改 `valid_mode` 时要把那一模式的字段一起给。 */
export type CouponTemplatePatchRequest = {
  name? : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type? : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  discount_rate? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents? : Money
  valid_mode? : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days? : number
  total_count? : number
  per_user_limit? : number
  claimable? : boolean
  status? : number
}

/** 一条字段级错误。`field` 是请求体（或商品对象）里的字段名。 */
export type FieldError = {
  field? : string
  message? : string
  /** 命中位置（Unicode 码点下标，从 0 开始） */
  offset? : number
  /** 命中长度（Unicode 码点数） */
  length? : number
}

/** GeoJSON Polygon，SRID 固定 4326。落库成 `GEOGRAPHY(POLYGON, 4326)`。 */
export type GeoPolygon = {
  type : string
  /** 环的数组。第一个是外环。 */
  coordinates : number[][][]
}

/** 第三方身份来源，对应 `user_identities.provider`： */
export type IdentityProvider = number

export type InventoryConflict = {
  type : string
  title : string
  status : number
  detail? : string
  instance? : string
  trace_id? : string
  /** 字段级校验错误 */
  errors? : FieldError[]
  current : AdminInventory
}

/** 比较并设置。两个数量都是必填，缺一不可——只给 `available_qty` 就退化成 */
export type InventorySetRequest = {
  /** **我看到的那个值。** 服务端把它作为 UPDATE 的条件； */
  expected_available_qty : number
  /** 要写进去的新值（绝对值，不是增量）。 */
  available_qty : number
  /** 低库存预警线。省略则不动。 */
  warning_qty? : number
}

export type User = {
  id : number
  nickname : string
  avatar_url? : string
  /** 脱敏返回，如 138****8000。完整号码只在绑定流程中由用户自己输入 */
  phone? : string
  /** 0 未知 / 1 男 / 2 女 */
  gender? : number
  /** `users.password_hash` 可空 —— 仅第三方登录的用户没有密码。 */
  has_password? : boolean
  created_at? : string
  last_login_at? : string
}

export type LoginResponse = {
  /** JWT，放进 Authorization: Bearer 头 */
  access_token : string
  refresh_token? : string
  token_type : string
  /** access_token 有效期，单位秒 */
  expires_in : number
  user : User
  /** 首登即注册时为 true，供前端引导补全资料 */
  is_new_user? : boolean
}

export type Merchant = {
  id : number
  /** 短标识，全局唯一，用于域名或路径路由 */
  code : string
  name : string
  /** 1 正常 2 停用 3 待审核 */
  status : number
  /** 自定义域名；为空则走 `/s/{code}` 路径路由 */
  domain? : string
  created_at : string
  /** 最近一次改名或改状态的时间（最新一行 `merchant_revisions` 的时间）。从没改过时缺席。 */
  updated_at? : string
}

export type MerchantCreateRequest = {
  code : string
  name : string
  /** 该店第一个管理员的邮箱，建好后给他发登录链接 */
  admin_email : string
}

export type MerchantList = {
  page : number
  page_size : number
  total : number
  items : Merchant[]
  /** 这套部署是不是单商家形态（配了 `KEEL_DEFAULT_MERCHANT`）。**必返。** */
  single_merchant_mode : boolean
}

export type MerchantUpdateRequest = {
  name? : string
  /** 1 正常 2 停用。没有 3：审核流程本轮不存在。 */
  status? : number
}

/** 通知的种类。**文案不要按它拼**（服务端已渲染好 `title` / `body`）， */
export type NotificationKind = string

/** 点了这条通知跳到哪里。四个定位字段都一定出现，用不上的是 `null`： */
export type NotificationTarget = {
  type : string
  order_no : string | null
  refund_no : string | null
  store_id : number | null
  sku_id : number | null
}

export type Notification = {
  id : number
  /** 通知的种类。**文案不要按它拼**（服务端已渲染好 `title` / `body`）， */
  kind : NotificationKind
  /** 服务端渲染好的中文标题，原样展示 */
  title : string
  /** 服务端渲染好的中文正文，原样展示 */
  body : string
  /** 点了这条通知跳到哪里。四个定位字段都一定出现，用不上的是 `null`： */
  target : NotificationTarget
  /** 已读时间；`null` 即未读。后台是**调用者自己**的已读时间。 */
  read_at : string | null
  created_at : string
}

export type NotificationList = {
  page : number
  page_size : number
  total : number
  items : Notification[]
  /** 调用者的未读总数（与 `unread_only` 无关，也不受分页影响）。 */
  unread_count : number
}

export type NotificationUnreadCount = {
  unread_count : number
}

export type Order = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
}

export type OrderCreateRequest = {
  items : OrderItemInput[]
  /** 由哪家门店履约。**必填，服务端不替客户端猜。** */
  store_id : number
  address_id : number
  /** 第一期仅支持单张券。 */
  user_coupon_id? : number
  remark? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  expected_payable_cents? : Money
}

export type Refund = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
}

export type OrderDetail = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver? : ReceiverSnapshot
  /** 下单时的门店与大区展示信息快照。 */
  store? : OrderStoreSnapshot
  items? : OrderItem[]
  payments? : PaymentRecord[]
  /** 该订单下的全部退款单，按申请时间倒序。 */
  refunds? : Refund[]
}

export type OrderPreviewItemsItem = {
  sku_id? : number
  quantity? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
}

export type OrderPreview = {
  /** 本次试算按哪家门店算的（回显请求里的 `store_id`）。 */
  store_id : number
  /** 那家门店所属大区。价格的中间一层按它算（数据模型 §4）。 */
  region_id? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 含优惠分摊结果。 */
  items : OrderPreviewItemsItem[]
  /** 本次试算用上的券（回显请求里的 `user_coupon_id`）。没带券时不出现。 */
  user_coupon_id? : number
  /** 这个买家手里本单可用的全部券，按优惠额降序——与 `POST /coupons/applicable` */
  applicable_coupons? : ApplicableCoupon[]
}

export type PageMeta = {
  page : number
  page_size : number
  total : number
}

export type PaymentCreateRequest = {
  /** 渠道。**沙箱与否不在这个枚举里** —— 「用哪个渠道付」和「这是不是 */
  channel : string
}

export type PaymentIntent = {
  payment_no : string
  /** 对外字符串 ↔ `payments.channel`：wechat=1 / alipay=2 / balance=3 */
  channel : string
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 渠道特定的调起参数（如微信 JSAPI 的 prepay 参数） */
  payload? : UTSJSONObject
}

/** RFC 9457 Problem Details */
export type Problem = {
  type : string
  title : string
  status : number
  detail? : string
  instance? : string
  trace_id? : string
  /** 字段级校验错误 */
  errors? : FieldError[]
}

/** **没有 `status` 也没有 `merchant_id`。** 前者因为创建与发布是两个动作， */
export type ProductCreateRequest = {
  /** 必填。`products.category_id` 是 NOT NULL 的复合外键，没有「未分类」这个态。 */
  category_id : number
  title : string
  subtitle? : string
  description? : string
  brand_id? : number | null
}

export type Sku = {
  id : number
  sku_code : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  available_qty : number
  image_url? : string
}

export type ProductDetail = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  description? : string
  category_id? : number
  images? : string[]
  skus : Sku[]
}

/** 只收 `upload_id`，不收 URL。收 URL 意味着客户端能往商品上挂任意地址， */
export type ProductImageInput = {
  upload_id : number
}

export type ProductImagesReplaceRequest = {
  /** **整组替换**，数组顺序即展示顺序，第 0 个是主图。 */
  images : ProductImageInput[]
}

/** `listed = false` 写一行排除，`listed = true` 删掉那一行。 */
export type ProductListingRequest = {
  /** 这一层卖不卖它。注意这不保证买家看得见—— */
  listed : boolean
}

export type ProductPublicationRequest = {
  /** `publish` → `status = 1`；`unpublish` → `status = 2`。 */
  action : string
}

/** 只改文案与归属。**不含 `status` / `published_at` / `deleted_at`**， */
export type ProductUpdateRequest = {
  title? : string
  subtitle? : string
  description? : string
  category_id? : number
  brand_id? : number | null
}

export type RefundItemInput = {
  /** 必须属于该订单。服务端强制校验「该 item 属于该 order */
  order_item_id : number
  quantity : number
}

export type RefundCreateRequest = {
  items : RefundItemInput[]
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 对应 `refunds.reason_code`： */
  reason_code : RefundReasonCode
  /** 补充说明。reason_code=5（其他）时建议必填 */
  reason_text? : string
  /** 凭证图片，先走 `POST /uploads`（`purpose=3 退款凭证`）拿到 `Upload.url`，原样填在这里。 */
  evidence_urls? : string[]
}

export type RegionCreateRequest = {
  code : string
  name : string
}

/** 只给要改的字段。`code` 改了要重查唯一性。 */
export type RegionUpdateRequest = {
  code? : string
  name? : string
  status? : number
}

export type ReportInventoryAlert = {
  store_id : number
  store_name : string
  region_id : number
  sku_id : number
  sku_code : string
  /** SKU 的规格值，如 `{"颜色":"红","尺码":"M"}` */
  spec_values : UTSJSONObject
  product_id : number
  product_title : string
  available_qty : number
  warning_qty : number
}

export type ReportInventoryAlerts = {
  /** 符合条件的总条数（不受 limit 影响） */
  total : number
  items : ReportInventoryAlert[]
}

/** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
export type ReportMetrics = {
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  /** 支付订单数：上述订单的笔数。 */
  order_count : number
  /** 支付买家数：上述订单的下单买家去重数。 */
  buyer_count : number
  /** 金额，单位「分」。禁止使用浮点。 */
  avg_order_value_cents : Money
  /** 退款笔数：窗口内到账的退款单张数。 */
  refund_count : number
  /** 退款率 = 退款金额 ÷ 支付金额（同一窗口），支付金额为 0 时为 `null`（不是 0）。 */
  refund_rate : number | null
}

/** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
export type ReportRange = {
  /** 区间起点（含），UTC */
  start_at : string
  /** 区间终点（**不含**），UTC */
  end_at : string
  /** 起点在店铺时区里的日期 */
  start_date : string
  /** 最后一个被覆盖的自然日（含），店铺时区 */
  end_date : string
}

/** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
export type ReportWindow = {
  period : string
  timezone : string
  /** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
  current : ReportRange
  /** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
  previous : ReportRange
}

export type ReportOverview = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  /** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
  current : ReportMetrics
  /** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
  previous : ReportMetrics
}

export type ReportProductRankItem = {
  /** 名次，从 1 开始 */
  rank : number
  product_id : number
  /** 商品当前的标题 */
  title : string
  category_id : number
  /** 销量（件） */
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 含这件商品的支付订单数 */
  order_count : number
  /** 这些订单行截至查询时已退的件数。 */
  refunded_quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_amount_cents : Money
}

export type ReportProductRanking = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  sort_by : string
  items : ReportProductRankItem[]
}

export type ReportRegionRow = {
  region_id : number
  region_name : string
  /** 这个大区在 stores 里出现的门店数 */
  store_count : number
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportSearchTerm = {
  /** 归并后的搜索词（去首尾空白、小写） */
  query : string
  search_count : number
  zero_result_count : number
}

export type ReportSearchOverview = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  search_count : number
  zero_result_count : number
  /** 无结果次数 ÷ 搜索次数；没有搜索时为 `null`。 */
  zero_result_rate : number | null
  click_count : number
  /** 热门搜索词 Top N。 */
  top_queries : ReportSearchTerm[]
  /** 无结果搜索词 Top N（按无结果次数排）。 */
  zero_result_queries : ReportSearchTerm[]
}

export type ReportStoreRow = {
  store_id : number
  store_name : string
  store_code : string
  /** 门店此刻所属的大区 */
  region_id : number
  region_name : string
  /** 门店已删除（只在窗口内有成交或退款时出现） */
  deleted : boolean
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportStoreComparison = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  stores : ReportStoreRow[]
  regions : ReportRegionRow[]
}

export type ReportTrendPoint = {
  /** 桶的起点，UTC */
  bucket_start_at : string
  /** 桶在店铺时区里的显示名：按天是 `MM-DD`，按小时是 `HH:00`。 */
  label : string
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportTrend = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  /** 窗口只有一个自然日时按小时，否则按天。 */
  granularity : string
  /** 按时间升序，每个桶一个点，没有数据的桶是 0。 */
  points : ReportTrendPoint[]
}

export type ReturnShipmentRequest = {
  /** 承运商标识，如 sf / jd / yto（与发货的 `Shipment.carrier_code` 同一套） */
  carrier_code : string
  tracking_no : string
}

/** 一件商品在某个作用域（大区或门店）下的可见性与生效价。 */
export type ScopedProductListing = {
  product_id : number
  title : string
  image_url? : string
  /** 租户级的 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status? : number
  /** **本作用域**有没有把它下架。`true` 表示这一层没有排除它—— */
  listed : boolean
  /** 两层都算完之后买家到底看不看得见。 */
  effective_listed : boolean
  /** 本作用域下这件商品各 SKU 生效价的最小值。 */
  min_price_cents? : Money
  /** 最大值。 */
  max_price_cents? : Money
  /** 这个价来自哪一层：**1 基准价 / 2 大区价 / 3 门店价**。 */
  price_source : number
}

/** 一个 SKU 在某个作用域（大区或门店）下的价格覆盖与生效价。 */
export type ScopedSkuPrice = {
  sku_id : number
  sku_code? : string
  /** `skus.price_cents`，最外层的基准价。 */
  base_price_cents? : Money
  /** **本作用域**自己定的价。为 null 表示这一层没有覆盖， */
  override_price_cents? : number | null
  /** 三层 `COALESCE` 之后真正生效的价。 */
  effective_price_cents : Money
  /** 1 基准价 / 2 大区价 / 3 门店价。 */
  price_source : number
}

export type SearchFilters = {
  category_id? : number
  /** 按**当前门店的生效价**过滤（三层 `COALESCE` 之后的值）， */
  min_price_cents? : Money
  /** 同上。 */
  max_price_cents? : Money
  /** 只要当前门店有货的。**默认值本轮从 `true` 改成 `false`**， */
  in_stock_only? : boolean
}

export type SearchHitScores = {
  vector? : number
  keyword? : number
  rrf? : number
  rerank? : number
  business? : number
  final? : number
}

export type SearchHit = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** explain=true 时返回，用于效果调优 */
  scores? : SearchHitScores
  /** 该结果来自哪一路召回，`explain=true` 时返回。 */
  recall_source? : string
}

/** `POST /search` 的请求体。**本轮从内联 schema 提成具名的**—— */
export type SearchRequest = {
  query : string
  /** 按哪家门店检索。与 `GET /products` 的同名查询参数逐字同义、 */
  store_id? : number
  filters? : SearchFilters
  size? : number
  /** 排序策略标识，用于 A/B 对比。记入检索日志后可按策略分组 */
  strategy? : string
  /** 返回各阶段得分，用于调试与效果评估 */
  explain? : boolean
}

/** 一期不接受发货明细——整单发货，包裹内容即订单全部商品。 */
export type ShipmentCreateRequest = {
  carrier_code : string
  tracking_no : string
}

/** `available_qty` 在这里是**允许的**，而在 `SkuUpdateRequest` 里不允许： */
export type SkuCreateRequest = {
  sku_code : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  weight_gram? : number
  /** 该规格小图的 `uploads.id`，服务端据此写出 `skus.image_url`。 */
  image_upload_id? : number | null
  /** 初始库存。服务端在同一事务里建出 `inventories` 行，省略即 0。 */
  available_qty? : number
  /** 低库存预警线，省略即 0。 */
  warning_qty? : number
}

/** 设置本作用域的价格覆盖（upsert）。 */
export type SkuPriceSetRequest = {
  /** 本作用域的价，单位分，非负。 */
  price_cents : Money
}

/** **刻意没有 `available_qty`**：库存有自己的端点，因为它要表达乐观并发。 */
export type SkuUpdateRequest = {
  sku_code? : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  weight_gram? : number
  image_upload_id? : number | null
  /** 0 停售 / 1 在售 */
  status? : number
}

/** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
export type StaffRole = number

export type Staff = {
  id : number
  email : string
  name? : string
  /** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
  role : StaffRole
  /** 1 正常 2 停用 */
  status : number
  /** 所属商家。**为 null 表示平台级操作员**——他不属于任何一家店， */
  merchant_id : number | null
  /** 管辖的大区（仅 role 3 非空）。按 id 升序 */
  region_ids : number[]
  /** 管辖的门店（仅 role 4 非空）。按 id 升序 */
  store_ids : number[]
  last_login_at? : string
  created_at : string
}

/** **没有 `merchant_id` 字段，这是刻意的。** 租户归属从调用者的会话继承。 */
export type StaffCreateRequest = {
  email : string
  name? : string
  /** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
  role : StaffRole
  /** role 3 必填且至少一个；其余角色不带 */
  region_ids? : number[]
  /** role 4 必填且至少一个；其余角色不带 */
  store_ids? : number[]
}

/** 一串一次性登录 token，与新建员工时服务端签的那一串同一种（15 分钟、用掉即失效）， */
export type StaffLoginToken = {
  /** 这串 token 属于谁 */
  staff_id : number
  /** 一次性登录 token 明文。**服务端只存它的 sha256**，明文只在这一次响应 */
  token : string
  expire_at : string
}

export type StaffSession = {
  /** 会话 token，放进 `Authorization: Bearer`。默认 7 天。 */
  token : string
  expire_at : string
  staff : Staff
}

/** 买家视角的门店。不含围栏——围栏是运营数据，不该发给客户端。 */
export type Store = {
  id : number
  name : string
  phone? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 是否是这家商家的「全国配送」回落门店。 */
  is_default : boolean
}

/** **围栏不在这里传**，走 `PUT /admin/stores/{store_id}/fence`。 */
export type StoreCreateRequest = {
  /** 必填。大区不存在或不属于当前租户时返回 422。 */
  region_id : number
  code : string
  name : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  /** 门店自身坐标的纬度，`/stores/resolve` 的 `distance_m` 按它算。 */
  lat? : number
  /** 经度。与 `lat` 同时给或同时不给。 */
  lng? : number
  /** 建出来就是默认门店。已经有一家时返回 409——切换默认店请用 */
  is_default? : boolean
}

/** 整体替换这家门店的围栏。 */
export type StoreFenceRequest = {
  /** 传 `null` 即清空围栏。**清空只对默认门店合法**—— */
  fence : any
}

export type StoreMatch = {
  id : number
  name : string
  phone? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 是否是这家商家的「全国配送」回落门店。 */
  is_default : boolean
  /** 买家坐标到门店坐标的球面距离，**单位米**。 */
  distance_m : number | null
}

export type StoreResolveResult = {
  /** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
  match_type : StoreMatchType
  /** `fence` 时是命中的全部门店按 `distance_m` 升序； */
  stores : StoreMatch[]
}

/** 只给要改的字段。**改不了两样**：`fence` 走 `PUT .../fence`（要过 */
export type StoreUpdateRequest = {
  region_id? : number
  code? : string
  name? : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  lat? : number
  lng? : number
  status? : number
}

export type Upload = {
  id : number
  /** 可直接写入业务字段（如 `evidence_urls`、`avatar_url`）的访问地址， */
  url : string
  content_type : string
  size_bytes : number
  created_at : string
}

/** 文件用途，取值与 `uploads.purpose` 逐值一致： */
export type UploadTarget = number

export type UserCoupon = {
  id : number
  coupon_code : string
  template_id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比，850 = 8.5 折 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 未使用 · 2 锁定 · 3 已使用 · 4 已过期 */
  status : number
  /** 1 领券中心领取 · 2 商家定向发放 */
  source : number
  valid_start_at : string
  valid_end_at : string
  used_at? : string
  /** 这张券的适用范围（来自模板）。空数组即全场、全店。 */
  scopes : CouponScope[]
}

export type UserIdentity = {
  id : number
  /** 第三方身份来源，对应 `user_identities.provider`： */
  provider : IdentityProvider
  /** 是否已取到 unionid（能否跨应用打通） */
  has_union_id? : boolean
  /** 绑定时间 */
  created_at : string
}

/** GET /products 的 query 参数 */
export type ListProductsQuery = {
  page? : number
  page_size? : number
  store_id? : number
  in_stock_only? : boolean
  category_id? : number
  sort? : string
  min_price_cents? : number
  max_price_cents? : number
}

/** GET /products 的 200 响应体 */
export type ListProductsResponse = {
  page : number
  page_size : number
  total : number
  items : ProductSummary[]
  /** 本次结果是按哪家门店算的。**必返。** */
  store : StoreContext
}

/** GET /products/{product_id} 的 query 参数 */
export type GetProductQuery = {
  store_id? : number
}

/** POST /auth/login 的请求体 */
export type LoginRequest = {
  phone : string
  /** 短信验证码 */
  code? : string
  password? : string
}

/** POST /auth/refresh 的请求体 */
export type RefreshTokenRequest = {
  refresh_token : string
}

/** GET /orders 的 query 参数 */
export type ListOrdersQuery = {
  page? : number
  page_size? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status? : OrderStatus
  /** **资金维度** —— 钱退了多少，与 `status` 正交，由退款单驱动。 */
  refund_status? : OrderRefundStatus
}

/** GET /orders 的 200 响应体 */
export type ListOrdersResponse = {
  page : number
  page_size : number
  total : number
  items : Order[]
}

/** POST /search 的 200 响应体 */
export type SearchResponse = {
  items : SearchHit[]
  /** 本次检索是按哪家门店算的。**必返**，与 `GET /products` */
  store : StoreContext
  latency_ms : number
  /** 本次召回并排序后的结果总数（上限即 `size`）。 */
  total? : number
  /** 本次实际生效的策略标识（回显）。服务端做分流时， */
  strategy : string
  /** 本次检索在 `search_logs` 里那一行的定位键（128 位随机数的十六进制， */
  trace_id? : string
}

/** POST /search/events 的请求体 */
export type ReportSearchEventRequest = {
  /** `POST /search` 响应里的 `trace_id`，原样带回 */
  trace_id : string
  event : string
  /** 被点击 / 加购 / 下单的商品。必须是这次检索返回的 `items[].id` 之一。 */
  product_id : number
}

/** GET /coupon-templates 的 query 参数 */
export type ListCouponTemplatesQuery = {
  page? : number
  page_size? : number
}

/** GET /coupon-templates 的 200 响应体 */
export type ListCouponTemplatesResponse = {
  page : number
  page_size : number
  total : number
  items : ClaimableCouponTemplate[]
}

/** GET /coupons 的 query 参数 */
export type ListCouponsQuery = {
  page? : number
  page_size? : number
  status? : string
}

/** GET /coupons 的 200 响应体 */
export type ListCouponsResponse = {
  page : number
  page_size : number
  total : number
  items : UserCoupon[]
}

/** PATCH /me 的请求体 */
export type UpdateMeRequest = {
  nickname? : string
  avatar_url? : string
  /** 0 未知 / 1 男 / 2 女 */
  gender? : number
}

/** GET /cart 的 query 参数 */
export type GetCartQuery = {
  store_id? : number
}

/** POST /cart/items 的 query 参数 */
export type AddCartItemQuery = {
  store_id? : number
}

/** POST /cart/items 的请求体 */
export type AddCartItemRequest = {
  sku_id : number
  quantity : number
}

/** PATCH /cart/items/{item_id} 的 query 参数 */
export type UpdateCartItemQuery = {
  store_id? : number
}

/** PATCH /cart/items/{item_id} 的请求体 */
export type UpdateCartItemRequest = {
  quantity? : number
  selected? : boolean
}

/** PUT /cart/selection 的 query 参数 */
export type SelectCartItemsQuery = {
  store_id? : number
}

/** PUT /cart/selection 的请求体 */
export type SelectCartItemsRequest = {
  selected : boolean
  /** 省略则作用于全部条目 */
  item_ids? : number[]
}

/** POST /cart/items/batch-delete 的 query 参数 */
export type BatchDeleteCartItemsQuery = {
  store_id? : number
}

/** POST /cart/items/batch-delete 的请求体 */
export type BatchDeleteCartItemsRequest = {
  item_ids? : number[]
  /** 为 true 时删除全部已勾选条目，与 `item_ids` 互斥 */
  selected? : boolean
}

/** GET /refunds 的 query 参数 */
export type ListRefundsQuery = {
  page? : number
  page_size? : number
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status? : RefundStatus
}

/** GET /refunds 的 200 响应体 */
export type ListRefundsResponse = {
  page : number
  page_size : number
  total : number
  items : Refund[]
}
