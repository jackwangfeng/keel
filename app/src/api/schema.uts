// 由 scripts/gen_uts_schema.py 从 docs/电商系统-OpenAPI.yaml 生成。**请勿手改。**
//
// 手改会被 scripts/check_uts_contract.py 抓住：那个闸门把契约重新生成到临时目录
// 再和这个文件比对，对不上就红。改契约 -> `make generate-uts` -> 一起提交。
//
// 这里只有类型，没有一行运行时代码 —— 运行时在 app/src/api/client.uts。

export type Address = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  /** 门牌号等 */
  detail : string
  /** 行政区划码。比省市区三个字符串可靠 ——「内蒙古」与「内蒙古自治区」 */
  region_code? : string
  postal_code? : string
  /** 0 无 / 1 家 / 2 公司 / 3 学校 */
  tag? : number
  /** 仅在**新增**时有效（服务端同事务内先清旧默认再置新）。 */
  is_default : boolean
  id : number
  created_at? : string
  updated_at? : string
}

export type AddressInput = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  /** 门牌号等 */
  detail : string
  /** 行政区划码。比省市区三个字符串可靠 ——「内蒙古」与「内蒙古自治区」 */
  region_code? : string
  postal_code? : string
  /** 0 无 / 1 家 / 2 公司 / 3 学校 */
  tag? : number
  /** 仅在**新增**时有效（服务端同事务内先清旧默认再置新）。 */
  is_default? : boolean
}

export type AgentKey = {
  id : number
  name : string
  /** 明文前 12 位（含 kagt_），给人认是哪一把 */
  prefix : string
  expires_at? : string
  revoked_at? : string
  last_used_at? : string
  created_at : string
}

export type AdminAgent = {
  /** 即 staff_id */
  id : number
  name : string
  /** 2 操作员 / 3 大区管理员 / 4 门店管理员 */
  role : number
  /** 1 正常 / 2 停用 */
  status : number
  region_ids : number[]
  store_ids : number[]
  /** 没吊销、没过期的密钥数 */
  live_keys : number
  /** 任一把密钥最近一次被用的时间（分钟级节流） */
  last_used_at? : string
  created_at : string
  /** 只在详情里给（列表里缺席）。 */
  keys? : AgentKey[]
}

/** 后台视角的分类，**扁平**。与前台的 `Category` 不同，它不嵌 `children`： */
export type AdminCategory = {
  id : number
  /** 为 null 即根分类。 */
  parent_id? : number | null
  name : string
  /** 物化路径，形如 `/1/23/456/`（数据模型 §3）。 */
  path : string
  /** 层级，根为 1。同样由服务端从 `parent_id` 算出。 */
  level : number
  sort_order : number
  /** `categories.status`：0 停用 / 1 启用。 */
  status : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
export type CouponType = number

/** 金额，单位「分」。禁止使用浮点。 */
export type Money = number

/** 一条适用范围规则（数据模型 §7 `coupon_scopes`）。1–4 决定哪几行商品参与计算， */
export type CouponScope = {
  /** 1全场 2分类（含子孙） 3商品 4品牌 5大区 6门店 */
  scope_type : number
  /** 全场为 null；其余按 `scope_type` 指向分类 / 商品 / 品牌 / 大区 / 门店的 id */
  target_id : number | null
  include : boolean
  /** 目标的展示名（分类名、商品标题、大区名、门店名），只读。品牌没有目录，不返回； */
  target_name? : string
}

/** 发放与核销统计。`issued = claimed + granted = unused + locked + used + expired`。 */
export type CouponTemplateStats = {
  /** 已发出（与 `issued_count` 相等） */
  issued : number
  /** 其中买家在领券中心领的 */
  claimed : number
  /** 其中商家定向发放的 */
  granted : number
  /** 未使用且未过期 */
  unused : number
  /** 被待支付订单占用中 */
  locked : number
  /** 已核销（订单已支付） */
  used : number
  /** 未使用且已过期 */
  expired : number
}

export type AdminCouponTemplate = {
  id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days : number
  /** 总量，0 = 不限 */
  total_count : number
  issued_count : number
  per_user_limit : number
  claimable : boolean
  /** 1 启用 · 0 停用（停止领取与发放，不回收已发出的券） */
  status : number
  /** 已发出过券，券面字段与范围不能再改 */
  locked : boolean
  scopes : CouponScope[]
  /** 发放与核销统计。`issued = claimed + granted = unused + locked + used + expired`。 */
  stats : CouponTemplateStats
  created_at : string
  updated_at : string
}

/** 1 按件 · 2 按重量（单位克，取 SKU 的 `weight_gram`） */
export type FreightChargeMode = number

/** 省级行政区划码（GB/T 2260 的 6 位码，后四位为 0），如 `110000` 北京、`440000` 广东、 */
export type ProvinceCode = string

/** 一条计费规则：管哪些省、首件（首重）多少钱、续件（续重）多少钱、满什么条件包邮。 */
export type FreightRule = {
  /** 这条规则管哪些省。**空数组 = 默认规则**（其余地区），一个模板恰好一条。 */
  region_codes : ProvinceCode[]
  /** 首件件数（按件）或首重克数（按重量） */
  first_unit : number
  /** 金额，单位「分」。禁止使用浮点。 */
  first_fee_cents : Money
  /** 续件件数或续重克数：每超出这么多收一次续费，不足一个单位按一个算 */
  additional_unit : number
  /** 金额，单位「分」。禁止使用浮点。 */
  additional_fee_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  free_threshold_cents : Money
  /** 满件包邮：整单件数 ≥ 它即这条规则免运费。0 = 不设 */
  free_quantity : number
}

export type AdminFreightTemplate = {
  id : number
  name : string
  /** null = 全店模板 */
  store_id : number | null
  /** 1 按件 · 2 按重量（单位克，取 SKU 的 `weight_gram`） */
  charge_mode : FreightChargeMode
  /** 是不是全店默认模板 */
  is_default : boolean
  /** 默认规则（`region_codes` 为空）排在最后，其余按录入顺序 */
  rules : FreightRule[]
  undeliverable_region_codes : ProvinceCode[]
  /** 挂着这个模板的未删除商品数。大于 0 时不能删除 */
  product_count : number
  created_at : string
  updated_at : string
}

export type AdminInventory = {
  sku_id : number
  sku_code? : string
  /** 这一行库存属于哪家门店。**必返。** */
  store_id : number
  /** 这家门店的可售量。**这一行不存在时视同 0，不是「这家店不卖」**—— */
  available_qty : number
  warning_qty : number
  updated_at : string
}

/** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
export type OrderStatus = number

/** **资金维度** —— 钱退了多少，与 `status` 正交，由退款单驱动。 */
export type OrderRefundStatus = number

/** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
export type PromotionType = number

/** 订单上命中的活动，**下单时的快照**（活动之后改名、改规则、下线都不影响它）。 */
export type OrderPromotion = {
  promotion_id : number
  name : string
  /** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
  promotion_type : PromotionType
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  sku_ids : number[]
}

/** 下单瞬间从 `user_addresses` 拷贝的收货信息快照，落在 */
export type ReceiverSnapshot = {
  receiver_name : string
  phone : string
  province : string
  city : string
  district : string
  street? : string
  detail : string
  region_code? : string
  postal_code? : string
}

/** 下单那一瞬间的门店与大区展示信息，取自 `orders.store_snapshot`。 */
export type OrderStoreSnapshot = {
  store_name : string
  store_phone? : string
  store_address? : string
  region_name? : string
}

/** 这一组为什么免运费：`threshold` 满额包邮、`quantity` 满件包邮、 */
export type FreightFreeReason = string

/** 按运费模板分的一组商品及其运费。一单里的商品挂不同模板时分成几组， */
export type FreightGroup = {
  /** 用的是哪个模板；`free_reason = no_template` 时为 null */
  template_id? : number | null
  /** 模板名（订单上是下单那一刻的名字） */
  template_name? : string
  /** 1 按件 · 2 按重量（单位克，取 SKU 的 `weight_gram`） */
  charge_mode? : FreightChargeMode
  sku_ids : number[]
  /** 计费量：按件是件数，按重量是克数 */
  units : number
  /** 命中的那一条规则（`region_codes` 为空即默认规则）。没有模板时不出现 */
  rule? : FreightRule
  /** 金额，单位「分」。禁止使用浮点。 */
  fee_cents : Money
  /** 这一组为什么免运费：`threshold` 满额包邮、`quantity` 满件包邮、 */
  free_reason? : FreightFreeReason
}

/** 运费是怎么算出来的。试算与购物车里是**现算**的，订单上是**下单那一刻的快照** */
export type FreightBreakdown = {
  /** 收货地址归到的省。地址既没有可用的 `region_code` 也匹配不上省名时不出现（此时按各模板的默认规则算） */
  province_code? : ProvinceCode
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents : Money
  groups : FreightGroup[]
}

export type OrderItem = {
  id : number
  sku_id : number
  product_id? : number
  /** 下单时快照 */
  title : string
  spec_values? : UTSJSONObject
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  list_price_cents? : Money
  /** 改了这一行单价的限时折扣 / 秒杀活动。没有就不出现。 */
  price_promotion_id? : number
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents? : Money
  /** 已退款完成的件数 */
  refunded_qty? : number
  /** 退款流程中（退款单尚未到达 `40 已退款` 或终态）占用的件数。 */
  refunding_qty? : number
}

export type PaymentRecord = {
  payment_no? : string
  /** 对外字符串 ↔ `payments.channel`：wechat=1 / alipay=2 / balance=3 */
  channel? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents? : Money
  /** 0待支付 1成功 2失败 3已关闭 */
  status? : number
  paid_at? : string
}

export type Shipment = {
  id : number
  /** 承运商标识，如 sf / jd / yto */
  carrier_code : string
  tracking_no : string
  /** 1 已发出 · 2 已签收 · 3 异常 */
  status : number
  shipped_at : string
  delivered_at? : string
}

/** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
export type RefundType = number

/** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
export type RefundStatus = number

export type RefundItem = {
  order_item_id : number
  /** 下单时的商品标题快照 */
  title? : string
  image_url? : string
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
}

/** 对应 `refunds.reason_code`： */
export type RefundReasonCode = number

export type ReturnShipment = {
  carrier_code : string
  tracking_no : string
  /** 买家最近一次填写（或修改）的时间。不是承运商揽收时间 —— 那要查物流，一期不做 */
  submitted_at : string
}

/** 审计字段里的「谁」。`name` 取员工此刻的名字；平台级员工（不属于这家店） */
export type StaffRef = {
  id : number
  name? : string
}

/** 后台视角的退款单：买家侧 `Refund` 的全部字段，加上履约门店与审核记录。 */
export type AdminRefund = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 寄回截止时间：退货退款停在 `20 待买家退货`、且还没填寄回物流时才出现， */
  return_deadline_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
  /** 所属订单的履约门店（后台判权按它） */
  store_id : number
  /** 所属订单下单时的门店快照 */
  store : OrderStoreSnapshot
  /** 所属订单此刻的履约状态 */
  order_status : OrderStatus
  /** 通过或驳回这张单的员工（与 `audited_at` 同一次动作） */
  audited_by? : StaffRef
  /** 确认收到退货的时间（退货退款 `20 → 30` 那一步） */
  received_at? : string
  /** 确认收到退货的员工 */
  received_by? : StaffRef
}

export type AdminOrderDetail = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents? : Money
  /** 这一单命中的活动，**下单时的快照**。没命中任何活动时为空数组。 */
  promotions? : OrderPromotion[]
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver : ReceiverSnapshot
  /** 下单时的门店与大区展示快照 */
  store : OrderStoreSnapshot
  /** 有没有处于 10 待审核 / 20 待买家退货 / 30 退款中的退款单 */
  has_open_refund : boolean
  /** 下单那一刻的运费计算明细快照，同买家侧 `OrderDetail.freight` */
  freight? : FreightBreakdown
  /** 订单行，含优惠分摊（`discount_cents`）与已退 / 在途件数 */
  items : OrderItem[]
  payments : PaymentRecord[]
  /** 发货包裹，按发货先后。一期整单发货，至多一个 */
  shipments : Shipment[]
  /** 该订单下的全部退款单，按申请时间倒序 */
  refunds : AdminRefund[]
}

/** 后台视角的订单摘要：买家侧 `Order` 的全部字段，加上收货人与门店的**下单时快照**， */
export type AdminOrderSummary = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents? : Money
  /** 这一单命中的活动，**下单时的快照**。没命中任何活动时为空数组。 */
  promotions? : OrderPromotion[]
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver : ReceiverSnapshot
  /** 下单时的门店与大区展示快照 */
  store : OrderStoreSnapshot
  /** 有没有处于 10 待审核 / 20 待买家退货 / 30 退款中的退款单 */
  has_open_refund : boolean
}

/** 后台视角的商品。与 `ProductSummary` 的差别是状态面： */
export type AdminProduct = {
  id : number
  title : string
  subtitle? : string
  description? : string
  category_id : number
  /** 品牌，可空。一期没有品牌管理接口，只透传。 */
  brand_id? : number | null
  /** 这件商品单独挂的运费模板（只能是全店模板）。null = 不单独挂：按履约门店的门店模板、 */
  freight_template_id? : number | null
  /** `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** **首次**上架时间。为 null 表示从未上架过（即 `status` 一直是 0 草稿）。 */
  published_at? : string | null
  /** 软删时间。非 null 时该商品只在 `include_deleted=true` 的后台列表里出现。 */
  deleted_at? : string | null
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents : Money
  /** 未软删 SKU 的 `inventories.available_qty` 之和，服务端按需现算。 */
  total_stock : number
  /** 冗余字段，由订单变更时同步。不接受写入。 */
  sales_count : number
  created_at : string
  updated_at? : string
}

/** 后台视角的 SKU。比前台的 `Sku` 多出成本、重量、售卖开关与库存预警位—— */
export type AdminSku = {
  id : number
  product_id : number
  /** 商家自己的货号，租户内唯一（`uk_skus_code`），不是全局唯一。 */
  sku_code : string
  /** `skus.spec_values`（JSONB）。键名不由契约规定。 */
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  /** 重量（克）。按重量计费的运费模板按它算；0 表示没填，按重量计费时这一件按 0 克计（只收首重费） */
  weight_gram? : number
  /** 该规格的小图，形如 `/api/v1/uploads/{upload_id}`。 */
  image_url? : string
  /** `skus.status`：0 停售 / 1 在售。停售的规格仍在规格矩阵里显示，但不可加购。 */
  status : number
  /** 来自 `inventories.available_qty`。改它要走 `PUT /admin/skus/{sku_id}/inventory`。拆分部署下库存服务不可用时，`PATCH /admin/skus/{sku_id}` 回显里的这个数按 0 给出（以随后的 GET 为准）。 */
  available_qty : number
  /** 低库存预警线。一期只是一个存着的数，没有接到任何告警。 */
  warning_qty? : number
  created_at? : string
  updated_at? : string
}

/** 商品图与商品的关联。落地在数据模型 §3 的 `product_images` 表上—— */
export type ProductImage = {
  /** `uploads.id`。由 `POST /admin/uploads` 得到。 */
  upload_id : number
  /** 形如 `/api/v1/uploads/{upload_id}`，与 `Upload.url` 同一个形状： */
  url : string
  /** 展示顺序，从 0 起。**0 就是主图**，没有单独的 `is_primary`。 */
  sort_order : number
}

export type AdminProductDetail = {
  id : number
  title : string
  subtitle? : string
  description? : string
  category_id : number
  /** 品牌，可空。一期没有品牌管理接口，只透传。 */
  brand_id? : number | null
  /** 这件商品单独挂的运费模板（只能是全店模板）。null = 不单独挂：按履约门店的门店模板、 */
  freight_template_id? : number | null
  /** `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** **首次**上架时间。为 null 表示从未上架过（即 `status` 一直是 0 草稿）。 */
  published_at? : string | null
  /** 软删时间。非 null 时该商品只在 `include_deleted=true` 的后台列表里出现。 */
  deleted_at? : string | null
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents : Money
  /** 未软删 SKU 的 `inventories.available_qty` 之和，服务端按需现算。 */
  total_stock : number
  /** 冗余字段，由订单变更时同步。不接受写入。 */
  sales_count : number
  created_at : string
  updated_at? : string
  /** 含已软删的 SKU 吗——**不含**。软删的 SKU 不在任何视图里返回。 */
  skus : AdminSku[]
  /** 按展示顺序，`images[0]` 是主图。 */
  images : ProductImage[]
}

/** 满减 / 满折的一档。`threshold` 的单位由活动的 `threshold_unit` 决定（1 分 / 2 件）。 */
export type PromotionTier = {
  threshold : number
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  discount_rate : number
}

/** 限时折扣 / 秒杀的一个 SKU。`promo_price_cents`（特价，分）与 `discount_rate`（千分比）二选一， */
export type PromotionSku = {
  sku_id : number
  /** 金额，单位「分」。禁止使用浮点。 */
  promo_price_cents : Money
  discount_rate : number
  /** 每人限购件数（同一活动、同一 SKU），0 = 不限。只计未关闭的订单。 */
  per_user_limit : number
  /** 秒杀配额（件）。**不是独立的实物库存**：秒杀成交的每一件仍然从门店库存扣， */
  stock_qty : number
  /** 已按活动价售出（含待支付）的件数，只读。关单与 SAGA 补偿会放回。 */
  sold_qty : number
  /** 商品标题（只读，展示用）。 */
  title? : string
  /** SKU 编码（只读，展示用）。 */
  sku_code? : string
}

export type AdminPromotion = {
  id : number
  name : string
  /** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
  promotion_type : PromotionType
  /** 满减满折的门槛单位：1 金额（分）· 2 件数。其他类型为 0。 */
  threshold_unit : number
  /** 能否与优惠券同享。命中了一个 `false` 的活动，这一单就不能再用券 */
  stack_with_coupon : boolean
  starts_at : string
  ends_at : string
  /** 1 上线 · 0 下线。上线且在有效期内才生效（见 `phase`）。 */
  status : number
  /** 现算的阶段：`offline` 下线；`scheduled` 已上线、未开始；`running` 进行中；`ended` 已上线、已结束。 */
  phase : string
  /** 满减满折的阶梯，按门槛升序。其他类型为空数组。 */
  tiers : PromotionTier[]
  /** 适用范围（与券同一套语义）。空数组即全场、全店。 */
  scopes : CouponScope[]
  /** 限时折扣 / 秒杀的活动商品。其他类型为空数组。 */
  skus : PromotionSku[]
  /** 新人礼发哪一批券。其他类型不出现。 */
  gift_coupon_template_id? : number
  /** 新人礼已经发出的张数。其他类型不出现。 */
  gift_granted_count? : number
  created_at : string
  updated_at : string
}

export type AdminRefundDetail = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 寄回截止时间：退货退款停在 `20 待买家退货`、且还没填寄回物流时才出现， */
  return_deadline_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
  /** 所属订单的履约门店（后台判权按它） */
  store_id : number
  /** 所属订单下单时的门店快照 */
  store : OrderStoreSnapshot
  /** 所属订单此刻的履约状态 */
  order_status : OrderStatus
  /** 通过或驳回这张单的员工（与 `audited_at` 同一次动作） */
  audited_by? : StaffRef
  /** 确认收到退货的时间（退货退款 `20 → 30` 那一步） */
  received_at? : string
  /** 确认收到退货的员工 */
  received_by? : StaffRef
  /** 所属订单的摘要。审核退货退款时裁定运费要看订单实收运费 */
  order : AdminOrderSummary
}

/** 后台视角的大区。**没有几何**——大区是门店的分组， */
export type AdminRegion = {
  id : number
  /** 租户内唯一（软删的不占用）。 */
  code : string
  name : string
  /** 0 停用 / 1 启用。 */
  status : number
  /** 名下未软删的门店数。删大区时会因为它非零而被拒（409）， */
  store_count : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 后台视角的门店，**含围栏**。与买家侧的 `Store` 分成两个 schema， */
export type AdminStore = {
  id : number
  /** 所属大区，**必填且不可空**（`stores.region_id NOT NULL`）。 */
  region_id : number
  region_name? : string
  /** 租户内唯一（软删的不占用）。 */
  code : string
  name : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 电子围栏。**为 null 且 `is_default = false` 的门店是一家永远接不到单的店**—— */
  fence? : any
  /** 是否是「全国配送」的回落门店。每个商家**至多一个** */
  is_default : boolean
  /** 0 停业 / 1 营业。停业的门店不参与围栏判定，也不能下单。 */
  status : number
  deleted_at? : string | null
  created_at : string
  updated_at? : string
}

/** 门店列表。比一般的分页响应多一个 `has_default`—— */
export type AdminStoreList = {
  page : number
  page_size : number
  total : number
  items : AdminStore[]
  /** 这家商家有没有默认门店。**必返。** */
  has_default : boolean
}

export type AgentBrief = {
  id : number
  agent_staff_id : number
  agent_name : string
  title : string
  /** markdown（按不可信输入渲染，不渲染 HTML） */
  body : string
  period_start : string
  period_end : string
  created_at : string
}

export type AgentCreateRequest = {
  name : string
  role : number
  region_ids? : number[]
  store_ids? : number[]
}

export type AgentKeyCreateRequest = {
  name : string
  /** 0 = 不过期 */
  expires_in_days? : number
}

export type AgentKeyCreated = {
  id : number
  name : string
  /** 明文前 12 位（含 kagt_），给人认是哪一把 */
  prefix : string
  expires_at? : string
  revoked_at? : string
  last_used_at? : string
  created_at : string
  /** 明文，只在这一次响应里出现 */
  secret : string
}

export type AgentProposal = {
  id : number
  agent_staff_id : number
  agent_name : string
  /** M9 只有加库存一种 */
  kind : string
  store_id : number
  store_name : string
  sku_id? : number
  /** 执行参数。inventory_adjust 是 {store_id, sku_id, delta, reason} */
  payload : UTSJSONObject
  /** 一句话，如「北京门店：颜色：黑 / 尺码：M 补 40 件」 */
  title : string
  /** AI 员工写的证据（markdown，按不可信输入渲染） */
  evidence : string
  expected_impact : string
  /** 10 待处理 / 15 执行中 / 20 已执行 / 30 已驳回 / 40 执行失败 / 50 已过期 */
  status : number
  decided_by? : number
  decided_by_name? : string
  decided_at? : string
  reject_reason? : string
  /** 执行结果：{before_available, after_available} 或 {error_type, error} */
  result? : UTSJSONObject
  expires_at : string
  created_at : string
  updated_at : string
}

export type AgentProposalRejectRequest = {
  reason : string
}

export type AgentUpdateRequest = {
  name? : string
  role? : number
  status? : number
  region_ids? : number[]
  store_ids? : number[]
}

export type AgentWhoAmI = {
  staff_id : number
  name : string
  role : number
  region_ids : number[]
  store_ids : number[]
  key_id : number
}

export type ApplicableCoupon = {
  id : number
  coupon_code : string
  template_id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比，850 = 8.5 折 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 未使用 · 2 锁定 · 3 已使用 · 4 已过期 */
  status : number
  /** 1 领券中心领取 · 2 商家定向发放 · 3 新人礼（营销活动自动发放，数据模型 §7） */
  source : number
  valid_start_at : string
  valid_end_at : string
  used_at? : string
  /** 这张券的适用范围（来自模板）。空数组即全场、全店。 */
  scopes : CouponScope[]
  /** 金额，单位「分」。禁止使用浮点。 */
  applicable_discount_cents : Money
}

/** 这一行此刻能不能买，按响应里 `store` 那家门店判。判定顺序即下表顺序， */
export type CartItemStatus = string

export type FreightUndeliverableLine = {
  sku_id : number
  /** `region_excluded`：这件商品用的运费模板把收货地址所在的省列为不配送； */
  reason_code : string
  /** 给人看的一句话，如「新疆维吾尔自治区不在「默认运费」的配送范围」 */
  reason : string
}

export type CartItem = {
  id : number
  sku_id : number
  product_id? : number
  title? : string
  spec_values? : UTSJSONObject
  image_url? : string
  /** **实时价，不是加购时的快照。** 购物车刻意不存价格快照（见数据模型 §10）， */
  price_cents : number | null
  /** 门店最终价。只有 `price_cents` 是活动价时才出现（用来划线展示原价）。 */
  list_price_cents? : number | null
  /** 给出活动价的那个限时折扣 / 秒杀活动。与 `list_price_cents` 同进同出。 */
  price_promotion_id? : number
  quantity : number
  /** 是否勾选结算，对应 `cart_items.selected`。 */
  selected : boolean
  /** 此刻能否按 `quantity` 买下这一行，恒等于 `status == available`。 */
  available : boolean
  /** 这一行此刻能不能买，按响应里 `store` 那家门店判。判定顺序即下表顺序， */
  status : CartItemStatus
  /** 这一行送不到 `Cart.address_id` 那个地址（运费模板把那个省列为不配送，或地址归不到省）。 */
  undeliverable? : FreightUndeliverableLine
}

/** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
export type StoreMatchType = string

/** 每一条会受门店影响的读接口都回显它。**没有它，客户端拿到的 */
export type StoreContext = {
  /** 本次响应是按哪家门店算的。`match_type = none` 时为 null。 */
  store_id? : number | null
  /** 那家门店所属大区。价格的中间一层按它算。 */
  region_id? : number | null
  /** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
  match_type : StoreMatchType
}

/** 一个活动在这一单（或购物车已勾选的行）上的结果。试算、购物车、下单用的是同一份计算 */
export type PromotionHit = {
  promotion_id : number
  name : string
  /** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
  promotion_type : PromotionType
  applied : boolean
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  stack_with_coupon? : boolean
  threshold_unit? : number
  /** 命中的那一档门槛。未命中不出现。 */
  reached_threshold? : number
  /** 下一档（未命中时即最低一档）的门槛。已是最高档不出现。 */
  next_threshold? : number
  /** 离 `next_threshold` 还差多少（分或件，见 `threshold_unit`）。 */
  shortfall? : number
  /** 参与这个活动的行（SKU）。 */
  sku_ids : number[]
  /** 给人看的一句话，例如「已减 10 元，再买 50 元可减 30 元」「还差 1 件享 9 折」。 */
  message : string
}

export type Cart = {
  items : CartItem[]
  /** 本次的价格与可买状态是按哪家门店算的。**必返**，理由同 `GET /products`。 */
  store : StoreContext
  /** **全车**商品金额合计，与 `selected` 无关。 */
  total_cents : Money
  /** **仅已勾选**（`selected: true`）条目的金额合计，即点「去结算」时的预估金额。 */
  selected_total_cents : Money
  /** 已勾选、可买的行命中满减满折的优惠合计（不含券）。把这些行送进 `/orders/preview`， */
  promotion_discount_cents : Money
  /** 已勾选、可买的行上各活动的结果：命中了哪些、各减多少、还差多少凑满（`PromotionHit`）。 */
  promotions : PromotionHit[]
  /** 本次按哪个收货地址算的运费（回显 `address_id` 参数，或买家的默认地址）。没有地址时不出现。 */
  address_id? : number
  /** 已勾选、可买、送得到的那些行按 `address_id` 那个地址算出的**预估运费**。 */
  freight? : FreightBreakdown
}

export type Category = {
  id : number
  name : string
  level : number
  children? : Category[]
}

/** **没有 `path` 与 `level`**，它们由服务端从 `parent_id` 算出。 */
export type CategoryCreateRequest = {
  name : string
  /** 省略或为 null 即建根分类。必须属于当前租户。 */
  parent_id? : number | null
  sort_order? : number
}

/** 传 `parent_id` 就是**移动子树**，服务端会在同一事务里重写整棵子树的 */
export type CategoryUpdateRequest = {
  name? : string
  /** 显式传 `null` 表示移到根。**不传这个字段则不动层级** —— */
  parent_id? : number | null
  sort_order? : number
  /** 0 停用 / 1 启用 */
  status? : number
}

/** 商品当前生效的活动标签（商品列表 / 详情）。按响应里 `store` 那家门店判： */
export type PromotionTag = {
  promotion_id : number
  /** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
  promotion_type : PromotionType
  /** 给人看的标签，例如「满100减10」「满2件9折」「限时特价 ¥39.90」「秒杀 ¥9.90」。 */
  label : string
  ends_at? : string
}

export type ProductSummary = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  /** 这家店里任意一个在售 SKU 可售数 > 0。`GET /products` 与 `POST /search` 都按解析出的门店填 */
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** 这件商品在响应里 `store` 那家门店**此刻生效**的活动标签（满减满折、限时折扣、秒杀）。 */
  promotion_tags? : PromotionTag[]
}

export type ChatReplyAction = {
  type? : string
  params? : UTSJSONObject
}

export type ChatReply = {
  session_id : string
  /** 面向用户的自然语言回复 */
  reply : string
  /** 真实检索结果，非模型生成 */
  products? : ProductSummary[]
  /** 解析出的结构化意图 */
  intent? : UTSJSONObject
  /** 写操作路由指令。前端据此跳转到对应表单并预填参数， */
  action? : ChatReplyAction
}

export type ClaimableCouponTemplate = {
  id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 绝对时间 · 2 领取后 N 天 */
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days : number
  /** 还剩多少张；`null` 表示不限量 */
  remaining : number | null
  per_user_limit : number
  /** 当前买家已持有这个模板的券数（含商家定向发放的） */
  claimed_count : number
  /** 当前买家现在能不能领（没到每人限领） */
  can_claim : boolean
  scopes : CouponScope[]
}

export type OrderItemInput = {
  sku_id : number
  quantity : number
}

export type CouponApplicableRequest = {
  items : OrderItemInput[]
  /** 履约门店，必填。理由同 `OrderCreateRequest.store_id`。 */
  store_id : number
  /** 收货地址，可选。**包邮券要它**：包邮券能抵多少取决于运费，运费取决于地址。 */
  address_id? : number
}

export type CouponGrantItem = {
  phone : string
  user_id : number
  user_coupon_id : number
  coupon_code : string
}

export type CouponGrantRequest = {
  phones : string[]
}

export type CouponGrantResult = {
  template_id : number
  /** 本次发出的张数 */
  granted : number
  coupons : CouponGrantItem[]
}

export type CouponScopeInput = {
  scope_type : number
  target_id? : number | null
  include? : boolean
}

export type CouponScopesSetRequest = {
  scopes : CouponScopeInput[]
}

export type CouponTemplateCreateRequest = {
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  discount_rate? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents? : Money
  valid_mode : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days? : number
  /** 0 = 不限 */
  total_count? : number
  per_user_limit? : number
  claimable? : boolean
}

/** 只改传了的字段。有效期整组替换：改 `valid_mode` 时要把那一模式的字段一起给。 */
export type CouponTemplatePatchRequest = {
  name? : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type? : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  discount_rate? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents? : Money
  valid_mode? : number
  valid_start_at? : string
  valid_end_at? : string
  valid_days? : number
  total_count? : number
  per_user_limit? : number
  claimable? : boolean
  status? : number
}

/** 一条字段级错误。`field` 是请求体（或商品对象）里的字段名。 */
export type FieldError = {
  field? : string
  message? : string
  /** 命中位置（Unicode 码点下标，从 0 开始） */
  offset? : number
  /** 命中长度（Unicode 码点数） */
  length? : number
}

/** 新建与整体替换共用。字段含义见 `POST /admin/freight-templates`。 */
export type FreightTemplateInput = {
  name : string
  /** null 或不填 = 全店模板；非 null = 这家门店的门店模板（每店至多一个）。 */
  store_id? : number | null
  /** 1 按件 · 2 按重量（单位克，取 SKU 的 `weight_gram`） */
  charge_mode : FreightChargeMode
  /** 设为全店默认模板（只有全店模板能设）。同一时刻至多一个：设了这一个， */
  is_default? : boolean
  rules : FreightRule[]
  /** 不配送的省。不能与任何一条规则的 `region_codes` 重叠。 */
  undeliverable_region_codes? : ProvinceCode[]
}

/** GeoJSON Polygon，SRID 固定 4326。落库成 `GEOGRAPHY(POLYGON, 4326)`。 */
export type GeoPolygon = {
  type : string
  /** 环的数组。第一个是外环。 */
  coordinates : number[][][]
}

/** 第三方身份来源，对应 `user_identities.provider`： */
export type IdentityProvider = number

/** 相对调整。只有一个必填字段：加减多少。**不带「我看到的那个值」**—— */
export type InventoryAdjustRequest = {
  /** 可售量的增量，正数进货、负数扣减。**不能为 0**（一次什么都不改的调整 */
  delta : number
  /** 这次调整的原因（「3 月进货」「盘点盘亏」「退货验货入库」），写进 */
  reason? : string
}

export type InventoryConflict = {
  type : string
  title : string
  status : number
  detail? : string
  instance? : string
  trace_id? : string
  /** 字段级校验错误 */
  errors? : FieldError[]
  /** 只在 `region-not-deliverable`（试算 / 下单时有商品送不到这个收货地址）时出现： */
  undeliverable_items? : FreightUndeliverableLine[]
  current : AdminInventory
}

/** 比较并设置。两个数量都是必填，缺一不可——只给 `available_qty` 就退化成 */
export type InventorySetRequest = {
  /** **我看到的那个值。** 服务端把它作为 UPDATE 的条件； */
  expected_available_qty : number
  /** 要写进去的新值（绝对值，不是增量）。 */
  available_qty : number
  /** 低库存预警线。省略则不动。 */
  warning_qty? : number
}

export type User = {
  id : number
  nickname : string
  avatar_url? : string
  /** 脱敏返回，如 138****8000。完整号码只在绑定流程中由用户自己输入 */
  phone? : string
  /** 0 未知 / 1 男 / 2 女 */
  gender? : number
  /** `users.password_hash` 可空 —— 仅第三方登录的用户没有密码。 */
  has_password? : boolean
  created_at? : string
  last_login_at? : string
}

export type LoginResponse = {
  /** JWT，放进 Authorization: Bearer 头 */
  access_token : string
  refresh_token? : string
  token_type : string
  /** access_token 有效期，单位秒 */
  expires_in : number
  user : User
  /** 首登即注册时为 true，供前端引导补全资料 */
  is_new_user? : boolean
}

export type Merchant = {
  id : number
  /** 短标识，全局唯一，用于域名或路径路由 */
  code : string
  name : string
  /** 1 正常 2 停用 3 待审核 */
  status : number
  /** 自定义域名；为空则走 `/s/{code}` 路径路由 */
  domain? : string
  created_at : string
  /** 最近一次改名或改状态的时间（最新一行 `merchant_revisions` 的时间）。从没改过时缺席。 */
  updated_at? : string
}

export type MerchantCreateRequest = {
  code : string
  name : string
  /** 该店第一个管理员的邮箱，建好后给他发登录链接 */
  admin_email : string
}

export type MerchantList = {
  page : number
  page_size : number
  total : number
  items : Merchant[]
  /** 这套部署是不是单商家形态（配了 `KEEL_DEFAULT_MERCHANT`）。**必返。** */
  single_merchant_mode : boolean
}

export type MerchantUpdateRequest = {
  name? : string
  /** 1 正常 2 停用。没有 3：审核流程本轮不存在。 */
  status? : number
}

/** 通知的种类。**文案不要按它拼**（服务端已渲染好 `title` / `body`）， */
export type NotificationKind = string

/** 点了这条通知跳到哪里。四个定位字段都一定出现，用不上的是 `null`： */
export type NotificationTarget = {
  type : string
  order_no : string | null
  refund_no : string | null
  store_id : number | null
  sku_id : number | null
}

export type Notification = {
  id : number
  /** 通知的种类。**文案不要按它拼**（服务端已渲染好 `title` / `body`）， */
  kind : NotificationKind
  /** 服务端渲染好的中文标题，原样展示 */
  title : string
  /** 服务端渲染好的中文正文，原样展示 */
  body : string
  /** 点了这条通知跳到哪里。四个定位字段都一定出现，用不上的是 `null`： */
  target : NotificationTarget
  /** 已读时间；`null` 即未读。后台是**调用者自己**的已读时间。 */
  read_at : string | null
  created_at : string
}

export type NotificationList = {
  page : number
  page_size : number
  total : number
  items : Notification[]
  /** 调用者的未读总数（与 `unread_only` 无关，也不受分页影响）。 */
  unread_count : number
}

export type NotificationUnreadCount = {
  unread_count : number
}

export type Order = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents? : Money
  /** 这一单命中的活动，**下单时的快照**。没命中任何活动时为空数组。 */
  promotions? : OrderPromotion[]
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
}

export type OrderCreateRequest = {
  items : OrderItemInput[]
  /** 由哪家门店履约。**必填，服务端不替客户端猜。** */
  store_id : number
  address_id : number
  /** 第一期仅支持单张券。 */
  user_coupon_id? : number
  remark? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  expected_payable_cents? : Money
}

export type Refund = {
  /** 对外编号，不可枚举 */
  refund_no : string
  order_no : string
  /** 原路退回的落点 —— 退的是哪一笔支付。一个订单可能有多次支付尝试， */
  payment_no? : string
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status : RefundStatus
  /** 退款明细，对应 `refund_items`。申请时按明细提交了，查询时就要能拿回来， */
  items : RefundItem[]
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 退款渠道，冗余自原支付单（对账按渠道跑）。 */
  channel? : string
  /** 渠道退款流水号，由退款回调写入。用户报障与客服对账要这个号。 */
  channel_refund_id? : string
  /** 对应 `refunds.reason_code`： */
  reason_code? : RefundReasonCode
  reason_text? : string
  evidence_urls? : string[]
  /** 买家寄回退货的物流（`POST /refunds/{refund_no}/return-shipment` 填的那一份）。 */
  return_shipment? : ReturnShipment
  /** 审核驳回理由，`status=50 已拒绝` 时返回。 */
  reject_reason? : string
  /** 审核时间 */
  audited_at? : string
  /** 寄回截止时间：退货退款停在 `20 待买家退货`、且还没填寄回物流时才出现， */
  return_deadline_at? : string
  /** 到账时间 */
  refunded_at? : string
  created_at : string
  updated_at? : string
}

export type OrderDetail = {
  order_no : string
  /** 履约门店。**必返**（DB 上是 `NOT NULL`）。 */
  store_id : number
  /** 下单时那家门店所属的大区。**冗余在订单上，不靠 `stores.region_id` 推**： */
  region_id? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status : OrderStatus
  /** 售后状态，与 status 正交，必返字段（DB 上是 `NOT NULL DEFAULT 0`）。 */
  refund_status : OrderRefundStatus
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 这一单用的券。没用券时不出现。 */
  user_coupon_id? : number
  /** 这一单用的券的名字，**下单时的快照**。没用券时不出现（与 `user_coupon_id` 同进同出）。 */
  coupon_name? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents? : Money
  /** 这一单命中的活动，**下单时的快照**。没命中任何活动时为空数组。 */
  promotions? : OrderPromotion[]
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_cents? : Money
  expire_at? : string
  created_at : string
  paid_at? : string
  /** 发货时间。「发货后 N 天自动确认收货」的倒计时从这里算 */
  shipped_at? : string
  finished_at? : string
  /** 下单时的收货信息快照 */
  receiver? : ReceiverSnapshot
  /** 下单时的门店与大区展示信息快照。 */
  store? : OrderStoreSnapshot
  /** 下单那一刻的运费计算明细快照（`orders.freight_snapshot`）：用的哪个模板、 */
  freight? : FreightBreakdown
  items? : OrderItem[]
  payments? : PaymentRecord[]
  /** 该订单下的全部退款单，按申请时间倒序。 */
  refunds? : Refund[]
  /** 自动确认收货的截止时间：只有 `30 已发货` 的订单才出现， */
  auto_confirm_at? : string
}

/** 试算的一行。**本轮从内联 schema 提成了具名类型**（数据模型 §15 记过的那笔债）： */
export type OrderPreviewItem = {
  sku_id : number
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  list_price_cents : Money
  /** 改了这一行单价的那个限时折扣 / 秒杀活动。没有就不出现。 */
  price_promotion_id? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents : Money
}

export type OrderPreview = {
  /** 本次试算按哪家门店算的（回显请求里的 `store_id`）。 */
  store_id : number
  /** 那家门店所属大区。价格的中间一层按它算（数据模型 §4）。 */
  region_id? : number
  /** 金额，单位「分」。禁止使用浮点。 */
  goods_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  freight_discount_cents : Money
  /** 运费的明细：按模板分组、命中哪条规则、为什么包邮 */
  freight : FreightBreakdown
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  payable_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  promotion_discount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  coupon_discount_cents : Money
  /** 含单价类活动的活动价与优惠分摊结果（活动与券各自一份、合计一份）。 */
  items : OrderPreviewItem[]
  /** 本单各活动的结果（`PromotionHit`）：命中了哪些、各减多少、还差多少凑满。 */
  promotions : PromotionHit[]
  /** 本次试算用上的券（回显请求里的 `user_coupon_id`）。没带券时不出现。 */
  user_coupon_id? : number
  /** 这个买家手里本单可用的全部券，按优惠额降序——与 `POST /coupons/applicable` */
  applicable_coupons? : ApplicableCoupon[]
}

export type PageMeta = {
  page : number
  page_size : number
  total : number
}

export type PaymentCreateRequest = {
  /** 渠道。**沙箱与否不在这个枚举里** —— 「用哪个渠道付」和「这是不是 */
  channel : string
}

export type PaymentIntent = {
  payment_no : string
  /** 对外字符串 ↔ `payments.channel`：wechat=1 / alipay=2 / balance=3 */
  channel : string
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 渠道特定的调起参数（如微信 JSAPI 的 prepay 参数） */
  payload? : UTSJSONObject
}

/** RFC 9457 Problem Details */
export type Problem = {
  type : string
  title : string
  status : number
  detail? : string
  instance? : string
  trace_id? : string
  /** 字段级校验错误 */
  errors? : FieldError[]
  /** 只在 `region-not-deliverable`（试算 / 下单时有商品送不到这个收货地址）时出现： */
  undeliverable_items? : FreightUndeliverableLine[]
}

/** **没有 `status` 也没有 `merchant_id`。** 前者因为创建与发布是两个动作， */
export type ProductCreateRequest = {
  /** 必填。`products.category_id` 是 NOT NULL 的复合外键，没有「未分类」这个态。 */
  category_id : number
  title : string
  subtitle? : string
  description? : string
  brand_id? : number | null
  /** 单独挂的运费模板（全店模板的 id）。不填或 null = 不单独挂。指向门店模板、不存在或已删除时 422。 */
  freight_template_id? : number | null
}

export type Sku = {
  id : number
  sku_code : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  available_qty : number
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  promo_price_cents? : Money
  /** 给出 `promo_price_cents` 的那个活动。与 `promo_price_cents` 同进同出。 */
  promotion_id? : number
}

export type ProductDetail = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  /** 这家店里任意一个在售 SKU 可售数 > 0。`GET /products` 与 `POST /search` 都按解析出的门店填 */
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** 这件商品在响应里 `store` 那家门店**此刻生效**的活动标签（满减满折、限时折扣、秒杀）。 */
  promotion_tags? : PromotionTag[]
  description? : string
  category_id? : number
  images? : string[]
  skus : Sku[]
}

/** 只收 `upload_id`，不收 URL。收 URL 意味着客户端能往商品上挂任意地址， */
export type ProductImageInput = {
  upload_id : number
}

export type ProductImagesReplaceRequest = {
  /** **整组替换**，数组顺序即展示顺序，第 0 个是主图。 */
  images : ProductImageInput[]
}

export type ProductImportCategoryCandidate = {
  category_id : number
  /** 从一级到这一级的名字，用「 > 」连接 */
  path_name : string
  /** 标题向量与类目路径名向量的余弦相似度，[-1, 1]，越大越像 */
  score : number
}

export type ProductImportCategoryChoice = {
  /** 商品在文件里的首行行号（预检结果里的 `products[].first_row`） */
  first_row : number
  category_id : number
}

/** 一件商品的类目怎么定。 */
export type ProductImportCategoryDecision = {
  status : string
  category_id? : number
  path_name? : string
  /** 按分数降序的候选（`matched` 与 `unavailable` 时为空） */
  candidates : ProductImportCategoryCandidate[]
}

/** 导入文件格式。服务端按内容判断，不按文件名。 */
export type ProductImportFormat = string

/** 一行里的一条问题。`code` 给程序认，`message` 给人看。 */
export type ProductImportIssue = {
  /** 出问题的那一列的表头名。与某一列无关时缺席。 */
  column? : string
  code : string
  message : string
}

export type ProductImportOutcome = {
  first_row : number
  rows : number[]
  title : string
  status : string
  /** `created` 时有：新建的草稿商品 */
  product_id? : number
  /** `created` 时有：建了几个 SKU */
  sku_count? : number
  category_id? : number
  /** `failed` 时有：为什么没导入（每条带行号） */
  reasons? : string[]
  /** 文件里给这件商品填的图片地址，**只记录、没有下载**，请在商品页上传 */
  image_urls? : string[]
}

/** 文件里的一件商品（同一标题的若干行） */
export type ProductImportProduct = {
  first_row : number
  /** 这件商品包含的行号 */
  rows : number[]
  title : string
  /** 每一行都没有错误。为 false 时确认导入会跳过它。 */
  importable : boolean
  /** 一件商品的类目怎么定。 */
  category : ProductImportCategoryDecision
}

/** 文件里的一行（一个 SKU）。有错的格对应的字段缺席（比如价格写错了就没有 `price_cents`）。 */
export type ProductImportRow = {
  /** 行号，与 Excel 左侧的行号一致（表头是第 1 行）。整行空白的行被跳过，但不重新编号。 */
  row : number
  /** 这一行所属商品的首行行号（同一件商品的各行相同） */
  first_row : number
  title? : string
  subtitle? : string
  /** 类目列的原文 */
  category? : string
  description? : string
  sku_code : string
  /** 规格名 → 规格值；单规格商品为空对象 */
  spec_values : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents? : Money
  stock? : number
  weight_gram? : number
  image_urls? : string[]
  errors : ProductImportIssue[]
  warnings : ProductImportIssue[]
  /** 广告法违禁词命中（`field` 是 title / subtitle / description，`offset` / `length` */
  violations : FieldError[]
}

export type ProductImportPreviewCategoryGate = {
  min_score : number
  min_margin : number
}

export type ProductImportPreviewPreviousImport = {
  import_id : number
  created_at : string
}

export type ProductImportPreview = {
  /** 文件字节的 sha256（十六进制）。「同一份文件」的判据。 */
  file_sha256 : string
  /** 导入文件格式。服务端按内容判断，不按文件名。 */
  format : ProductImportFormat
  /** 数据行数（不含表头与整行空白） */
  total_rows : number
  /** 自身有错误的行数 */
  error_rows : number
  products : ProductImportProduct[]
  rows : ProductImportRow[]
  /** 文件级提示（不阻断），如「csv 按 GBK 读取」「列『备注』不认得，已忽略」 */
  notices : string[]
  /** 这次预检的类目推荐跑成了没有：`not_configured` 是部署没配推理引擎， */
  category_engine : string
  /** 自动选中类目的两道门（见 ProductImportCategoryDecision） */
  category_gate : ProductImportPreviewCategoryGate
  /** 同一份文件（sha256 相同）在本店已经确认导入过时出现：再确认不会重复建。 */
  previous_import? : ProductImportPreviewPreviousImport
}

export type ProductImportResult = {
  import_id : number
  file_sha256 : string
  /** 同一份文件此前已经确认导入过，这一次什么都没建，下面是那一次的结果 */
  already_imported : boolean
  total_rows : number
  created_products : number
  created_skus : number
  /** 没有导入的行数（含被同组错误拖累的行） */
  failed_rows : number
  products : ProductImportOutcome[]
  created_at : string
}

/** `listed = false` 写一行排除，`listed = true` 删掉那一行。 */
export type ProductListingRequest = {
  /** 这一层卖不卖它。注意这不保证买家看得见—— */
  listed : boolean
}

export type ProductPublicationRequest = {
  /** `publish` → `status = 1`；`unpublish` → `status = 2`。 */
  action : string
}

/** 只改文案与归属。**不含 `status` / `published_at` / `deleted_at`**， */
export type ProductUpdateRequest = {
  title? : string
  subtitle? : string
  description? : string
  category_id? : number
  brand_id? : number | null
  /** 改挂的运费模板（全店模板的 id）；传 null 解除单独挂的模板。 */
  freight_template_id? : number | null
}

export type PromotionSkuInput = {
  sku_id : number
  /** 金额，单位「分」。禁止使用浮点。 */
  promo_price_cents? : Money
  discount_rate? : number
  per_user_limit? : number
  stock_qty? : number
}

export type PromotionCreateRequest = {
  name : string
  /** 1 满减 · 2 满折 · 3 限时折扣（特价） · 4 秒杀 · 5 新人礼。 */
  promotion_type : PromotionType
  threshold_unit? : number
  stack_with_coupon? : boolean
  starts_at : string
  ends_at : string
  tiers? : PromotionTier[]
  scopes? : CouponScopeInput[]
  skus? : PromotionSkuInput[]
  gift_coupon_template_id? : number
}

/** 只改传了的字段；`tiers` / `scopes` / `skus` 传了即整组替换。 */
export type PromotionPatchRequest = {
  name? : string
  threshold_unit? : number
  stack_with_coupon? : boolean
  starts_at? : string
  ends_at? : string
  tiers? : PromotionTier[]
  scopes? : CouponScopeInput[]
  skus? : PromotionSkuInput[]
  gift_coupon_template_id? : number
  status? : number
}

export type RefundItemInput = {
  /** 必须属于该订单。服务端强制校验「该 item 属于该 order */
  order_item_id : number
  quantity : number
}

export type RefundCreateRequest = {
  items : RefundItemInput[]
  /** 1 仅退款 / 2 退货退款。对应 `refunds.refund_type`。 */
  refund_type : RefundType
  /** 对应 `refunds.reason_code`： */
  reason_code : RefundReasonCode
  /** 补充说明。reason_code=5（其他）时建议必填 */
  reason_text? : string
  /** 凭证图片，先走 `POST /uploads`（`purpose=3 退款凭证`）拿到 `Upload.url`，原样填在这里。 */
  evidence_urls? : string[]
}

export type RegionCreateRequest = {
  code : string
  name : string
}

/** 只给要改的字段。`code` 改了要重查唯一性。 */
export type RegionUpdateRequest = {
  code? : string
  name? : string
  /** 0 停用 1 启用。**停用大区 = 名下门店一律按停业处理**：不参与围栏判定、 */
  status? : number
}

export type ReportInventoryAlert = {
  store_id : number
  store_name : string
  region_id : number
  sku_id : number
  sku_code : string
  /** SKU 的规格值，如 `{"颜色":"红","尺码":"M"}` */
  spec_values : UTSJSONObject
  product_id : number
  product_title : string
  available_qty : number
  warning_qty : number
}

export type ReportInventoryAlerts = {
  /** 符合条件的总条数（不受 limit 影响） */
  total : number
  items : ReportInventoryAlert[]
}

/** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
export type ReportMetrics = {
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  /** 支付订单数：上述订单的笔数。 */
  order_count : number
  /** 支付买家数：上述订单的下单买家去重数。 */
  buyer_count : number
  /** 金额，单位「分」。禁止使用浮点。 */
  avg_order_value_cents : Money
  /** 退款笔数：窗口内到账的退款单张数。 */
  refund_count : number
  /** 退款率 = 退款金额 ÷ 支付金额（同一窗口），支付金额为 0 时为 `null`（不是 0）。 */
  refund_rate : number | null
}

/** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
export type ReportRange = {
  /** 区间起点（含），UTC */
  start_at : string
  /** 区间终点（**不含**），UTC */
  end_at : string
  /** 起点在店铺时区里的日期 */
  start_date : string
  /** 最后一个被覆盖的自然日（含），店铺时区 */
  end_date : string
}

/** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
export type ReportWindow = {
  period : string
  timezone : string
  /** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
  current : ReportRange
  /** 一段半开区间 `[start_at, end_at)`，同时给出它在店铺时区里的起止日期（都含）。 */
  previous : ReportRange
}

export type ReportOverview = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  /** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
  current : ReportMetrics
  /** 一段窗口里的核心指标。**订单口径**：已支付的五种状态 */
  previous : ReportMetrics
}

export type ReportProductRankItem = {
  /** 名次，从 1 开始 */
  rank : number
  product_id : number
  /** 商品当前的标题 */
  title : string
  category_id : number
  /** 销量（件） */
  quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  amount_cents : Money
  /** 含这件商品的支付订单数 */
  order_count : number
  /** 这些订单行截至查询时已退的件数。 */
  refunded_quantity : number
  /** 金额，单位「分」。禁止使用浮点。 */
  refunded_amount_cents : Money
}

export type ReportProductRanking = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  sort_by : string
  items : ReportProductRankItem[]
}

export type ReportRegionRow = {
  region_id : number
  region_name : string
  /** 这个大区在 stores 里出现的门店数 */
  store_count : number
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportSearchTerm = {
  /** 归并后的搜索词（去首尾空白、小写） */
  query : string
  search_count : number
  zero_result_count : number
}

export type ReportSearchOverview = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  search_count : number
  zero_result_count : number
  /** 无结果次数 ÷ 搜索次数；没有搜索时为 `null`。 */
  zero_result_rate : number | null
  click_count : number
  /** 热门搜索词 Top N。 */
  top_queries : ReportSearchTerm[]
  /** 无结果搜索词 Top N（按无结果次数排）。 */
  zero_result_queries : ReportSearchTerm[]
}

export type ReportStoreRow = {
  store_id : number
  store_name : string
  store_code : string
  /** 门店此刻所属的大区 */
  region_id : number
  region_name : string
  /** 门店已删除（只在窗口内有成交或退款时出现） */
  deleted : boolean
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportStoreComparison = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  stores : ReportStoreRow[]
  regions : ReportRegionRow[]
}

export type ReportTrendPoint = {
  /** 桶的起点，UTC */
  bucket_start_at : string
  /** 桶在店铺时区里的显示名：按天是 `MM-DD`，按小时是 `HH:00`。 */
  label : string
  /** 金额，单位「分」。禁止使用浮点。 */
  paid_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  refund_amount_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  net_sales_cents : Money
  order_count : number
}

export type ReportTrend = {
  /** 一次报表查询的时间窗口。**六条报表共用这一份口径**： */
  window : ReportWindow
  /** 窗口只有一个自然日时按小时，否则按天。 */
  granularity : string
  /** 按时间升序，每个桶一个点，没有数据的桶是 0。 */
  points : ReportTrendPoint[]
}

export type ReturnShipmentRequest = {
  /** 承运商标识，如 sf / jd / yto（与发货的 `Shipment.carrier_code` 同一套） */
  carrier_code : string
  tracking_no : string
}

/** 一件商品在某个作用域（大区或门店）下的可见性与生效价。 */
export type ScopedProductListing = {
  product_id : number
  title : string
  image_url? : string
  /** 租户级的 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status? : number
  /** **本作用域**有没有把它下架。`true` 表示这一层没有排除它—— */
  listed : boolean
  /** 两层都算完之后买家到底看不看得见。 */
  effective_listed : boolean
  /** 本作用域下这件商品各 SKU 生效价的最小值。 */
  min_price_cents? : Money
  /** 最大值。 */
  max_price_cents? : Money
  /** 这个价来自哪一层：**1 基准价 / 2 大区价 / 3 门店价**。 */
  price_source : number
}

/** 一个 SKU 在某个作用域（大区或门店）下的价格覆盖与生效价。 */
export type ScopedSkuPrice = {
  sku_id : number
  sku_code? : string
  /** `skus.price_cents`，最外层的基准价。 */
  base_price_cents? : Money
  /** **本作用域**自己定的价。为 null 表示这一层没有覆盖， */
  override_price_cents? : number | null
  /** 三层 `COALESCE` 之后真正生效的价。 */
  effective_price_cents : Money
  /** 1 基准价 / 2 大区价 / 3 门店价。 */
  price_source : number
}

export type SearchFilters = {
  category_id? : number
  /** 按**当前门店的生效价**过滤（三层 `COALESCE` 之后的值）， */
  min_price_cents? : Money
  /** 同上。 */
  max_price_cents? : Money
  /** 只要当前门店有货的。**默认值本轮从 `true` 改成 `false`**， */
  in_stock_only? : boolean
}

export type SearchHitScores = {
  vector? : number
  keyword? : number
  rrf? : number
  rerank? : number
  business? : number
  final? : number
}

export type SearchHit = {
  id : number
  title : string
  subtitle? : string
  image_url? : string
  /** 金额，单位「分」。禁止使用浮点。 */
  min_price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  max_price_cents? : Money
  /** 这家店里任意一个在售 SKU 可售数 > 0。`GET /products` 与 `POST /search` 都按解析出的门店填 */
  in_stock? : boolean
  sales_count? : number
  /** 对应 `products.status`：0 草稿 / 1 上架 / 2 下架。 */
  status : number
  /** 这件商品在响应里 `store` 那家门店**此刻生效**的活动标签（满减满折、限时折扣、秒杀）。 */
  promotion_tags? : PromotionTag[]
  /** explain=true 时返回，用于效果调优 */
  scores? : SearchHitScores
  /** 该结果来自哪一路召回，`explain=true` 时返回。 */
  recall_source? : string
}

/** `POST /search` 的请求体。**本轮从内联 schema 提成具名的**—— */
export type SearchRequest = {
  query : string
  /** 按哪家门店检索。与 `GET /products` 的同名查询参数逐字同义、 */
  store_id? : number
  filters? : SearchFilters
  size? : number
  /** 排序策略标识，用于 A/B 对比。记入检索日志后可按策略分组 */
  strategy? : string
  /** 返回各阶段得分，用于调试与效果评估 */
  explain? : boolean
}

/** 一期不接受发货明细——整单发货，包裹内容即订单全部商品。 */
export type ShipmentCreateRequest = {
  carrier_code : string
  tracking_no : string
}

export type ShopSettings = {
  /** 店铺名称（只读，`merchants` 目录里的当前名称；由平台改） */
  shop_name : string
  /** 客服电话；没设为 null */
  service_phone : string | null
  /** IANA 时区名。经营报表按它切自然日 */
  timezone : string
  /** 发货后多少天由系统自动确认收货 */
  auto_confirm_days : number
  /** 退货退款审核通过后多少天未填寄回物流即自动关闭 */
  return_ship_days : number
  /** 最近一次修改的时间；从没改过（全是默认值）为 null */
  updated_at : string | null
}

export type ShopSettingsInput = {
  /** 客服电话。不给即清空 */
  service_phone? : string
  /** IANA 时区名，如 `Asia/Shanghai` */
  timezone : string
  auto_confirm_days : number
  return_ship_days : number
}

/** `available_qty` 在这里是**允许的**，而在 `SkuUpdateRequest` 里不允许： */
export type SkuCreateRequest = {
  sku_code : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  /** 重量（克），按重量计费的运费模板用它。省略即 0 */
  weight_gram? : number
  /** 该规格小图的 `uploads.id`，服务端据此写出 `skus.image_url`。 */
  image_upload_id? : number | null
  /** 初始库存。服务端在同一事务里建出 `inventories` 行，省略即 0。 */
  available_qty? : number
  /** 低库存预警线，省略即 0。 */
  warning_qty? : number
}

/** 设置本作用域的价格覆盖（upsert）。 */
export type SkuPriceSetRequest = {
  /** 本作用域的价，单位分，非负。 */
  price_cents : Money
}

/** **刻意没有 `available_qty`**：库存有自己的端点，因为它要表达乐观并发。 */
export type SkuUpdateRequest = {
  sku_code? : string
  spec_values? : UTSJSONObject
  /** 金额，单位「分」。禁止使用浮点。 */
  price_cents? : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  cost_cents? : Money
  /** 重量（克），按重量计费的运费模板用它 */
  weight_gram? : number
  image_upload_id? : number | null
  /** 0 停售 / 1 在售 */
  status? : number
}

/** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
export type StaffRole = number

export type Staff = {
  id : number
  email : string
  name? : string
  /** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
  role : StaffRole
  /** 1 正常 2 停用 */
  status : number
  /** 所属商家。**为 null 表示平台级操作员**——他不属于任何一家店， */
  merchant_id : number | null
  /** 管辖的大区（仅 role 3 非空）。按 id 升序 */
  region_ids : number[]
  /** 管辖的门店（仅 role 4 非空）。按 id 升序 */
  store_ids : number[]
  last_login_at? : string
  created_at : string
}

/** **没有 `merchant_id` 字段，这是刻意的。** 租户归属从调用者的会话继承。 */
export type StaffCreateRequest = {
  email : string
  name? : string
  /** 1 管理员 · 2 操作员 · 3 大区管理员 · 4 门店管理员 */
  role : StaffRole
  /** role 3 必填且至少一个；其余角色不带 */
  region_ids? : number[]
  /** role 4 必填且至少一个；其余角色不带 */
  store_ids? : number[]
}

/** 一串一次性登录 token，与新建员工时服务端签的那一串同一种（15 分钟、用掉即失效）， */
export type StaffLoginToken = {
  /** 这串 token 属于谁 */
  staff_id : number
  /** 一次性登录 token 明文。**服务端只存它的 sha256**，明文只在这一次响应 */
  token : string
  expire_at : string
}

export type StaffSession = {
  /** 会话 token，放进 `Authorization: Bearer`。默认 7 天。 */
  token : string
  expire_at : string
  staff : Staff
}

/** 买家视角的门店。不含围栏——围栏是运营数据，不该发给客户端。 */
export type Store = {
  id : number
  name : string
  phone? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 是否是这家商家的「全国配送」回落门店。 */
  is_default : boolean
}

/** **围栏不在这里传**，走 `PUT /admin/stores/{store_id}/fence`。 */
export type StoreCreateRequest = {
  /** 必填。大区不存在或不属于当前租户时返回 422。 */
  region_id : number
  code : string
  name : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  /** 必填。门店自身坐标的纬度（WGS-84），`/stores/resolve` 的 `distance_m` 按它算。 */
  lat? : number
  /** 必填。经度（WGS-84）。 */
  lng? : number
  /** 建出来就是默认门店。已经有一家时返回 409——切换默认店请用 */
  is_default? : boolean
}

/** 整体替换这家门店的围栏。 */
export type StoreFenceRequest = {
  /** 传 `null` 即清空围栏。**清空只对默认门店合法**—— */
  fence : any
}

export type StoreMatch = {
  id : number
  name : string
  phone? : string
  address? : string
  lat? : number | null
  lng? : number | null
  /** 是否是这家商家的「全国配送」回落门店。 */
  is_default : boolean
  /** 买家坐标到门店坐标的球面距离，**单位米**。 */
  distance_m : number | null
}

export type StoreResolveResult = {
  /** 「当前门店」是怎么定下来的。这三个值是产品规则的对外形状， */
  match_type : StoreMatchType
  /** `fence` 时是命中的全部门店按 `distance_m` 升序； */
  stores : StoreMatch[]
}

/** 只给要改的字段。**改不了两样**：`fence` 走 `PUT .../fence`（要过 */
export type StoreUpdateRequest = {
  region_id? : number
  code? : string
  name? : string
  phone? : string
  province? : string
  city? : string
  district? : string
  address? : string
  /** 与 `lng` 同时给或同时不给。坐标只能改、不能清空。 */
  lat? : number
  lng? : number
  status? : number
}

export type Upload = {
  id : number
  /** 可直接写入业务字段（如 `evidence_urls`、`avatar_url`）的访问地址， */
  url : string
  content_type : string
  size_bytes : number
  created_at : string
}

/** 文件用途，取值与 `uploads.purpose` 逐值一致： */
export type UploadTarget = number

export type UserCoupon = {
  id : number
  coupon_code : string
  template_id : number
  name : string
  /** 1 满减 · 2 折扣 · 3 立减 · 4 包邮。 */
  coupon_type : CouponType
  /** 金额，单位「分」。禁止使用浮点。 */
  threshold_cents : Money
  /** 金额，单位「分」。禁止使用浮点。 */
  discount_cents : Money
  /** 千分比，850 = 8.5 折 */
  discount_rate : number
  /** 金额，单位「分」。禁止使用浮点。 */
  max_discount_cents : Money
  /** 1 未使用 · 2 锁定 · 3 已使用 · 4 已过期 */
  status : number
  /** 1 领券中心领取 · 2 商家定向发放 · 3 新人礼（营销活动自动发放，数据模型 §7） */
  source : number
  valid_start_at : string
  valid_end_at : string
  used_at? : string
  /** 这张券的适用范围（来自模板）。空数组即全场、全店。 */
  scopes : CouponScope[]
}

export type UserIdentity = {
  id : number
  /** 第三方身份来源，对应 `user_identities.provider`： */
  provider : IdentityProvider
  /** 是否已取到 unionid（能否跨应用打通） */
  has_union_id? : boolean
  /** 绑定时间 */
  created_at : string
}

/** GET /products 的 query 参数 */
export type ListProductsQuery = {
  page? : number
  page_size? : number
  store_id? : number
  in_stock_only? : boolean
  category_id? : number
  sort? : string
  min_price_cents? : number
  max_price_cents? : number
}

/** GET /products 的 200 响应体 */
export type ListProductsResponse = {
  page : number
  page_size : number
  total : number
  items : ProductSummary[]
  /** 本次结果是按哪家门店算的。**必返。** */
  store : StoreContext
}

/** GET /products/{product_id} 的 query 参数 */
export type GetProductQuery = {
  store_id? : number
}

/** POST /auth/login 的请求体 */
export type LoginRequest = {
  phone : string
  /** 短信验证码 */
  code? : string
  password? : string
}

/** POST /auth/refresh 的请求体 */
export type RefreshTokenRequest = {
  refresh_token : string
}

/** GET /orders 的 query 参数 */
export type ListOrdersQuery = {
  page? : number
  page_size? : number
  /** **履约维度** —— 货走到哪儿了。资金维度另见 `Order.refund_status`。 */
  status? : OrderStatus
  /** **资金维度** —— 钱退了多少，与 `status` 正交，由退款单驱动。 */
  refund_status? : OrderRefundStatus
}

/** GET /orders 的 200 响应体 */
export type ListOrdersResponse = {
  page : number
  page_size : number
  total : number
  items : Order[]
}

/** POST /search 的 200 响应体 */
export type SearchResponse = {
  items : SearchHit[]
  /** 本次检索是按哪家门店算的。**必返**，与 `GET /products` */
  store : StoreContext
  latency_ms : number
  /** 本次召回并排序后的结果总数（上限即 `size`）。 */
  total? : number
  /** 本次实际生效的策略标识（回显）。服务端做分流时， */
  strategy : string
  /** 本次检索在 `search_logs` 里那一行的定位键（128 位随机数的十六进制， */
  trace_id? : string
}

/** POST /search/events 的请求体 */
export type ReportSearchEventRequest = {
  /** `POST /search` 响应里的 `trace_id`，原样带回 */
  trace_id : string
  event : string
  /** 被点击 / 加购 / 下单的商品。必须是这次检索返回的 `items[].id` 之一。 */
  product_id : number
}

/** GET /coupon-templates 的 query 参数 */
export type ListCouponTemplatesQuery = {
  page? : number
  page_size? : number
}

/** GET /coupon-templates 的 200 响应体 */
export type ListCouponTemplatesResponse = {
  page : number
  page_size : number
  total : number
  items : ClaimableCouponTemplate[]
}

/** GET /coupons 的 query 参数 */
export type ListCouponsQuery = {
  page? : number
  page_size? : number
  status? : string
}

/** GET /coupons 的 200 响应体 */
export type ListCouponsResponse = {
  page : number
  page_size : number
  total : number
  items : UserCoupon[]
}

/** PATCH /me 的请求体 */
export type UpdateMeRequest = {
  nickname? : string
  /** 本人用 `POST /uploads`（`purpose=2`）传的头像的 `url`，形如 `/api/v1/uploads/{upload_id}`； */
  avatar_url? : string
  /** 0 未知 / 1 男 / 2 女 */
  gender? : number
}

/** GET /cart 的 query 参数 */
export type GetCartQuery = {
  store_id? : number
  address_id? : number
}

/** POST /cart/items 的 query 参数 */
export type AddCartItemQuery = {
  store_id? : number
  address_id? : number
}

/** POST /cart/items 的请求体 */
export type AddCartItemRequest = {
  sku_id : number
  quantity : number
}

/** PATCH /cart/items/{item_id} 的 query 参数 */
export type UpdateCartItemQuery = {
  store_id? : number
  address_id? : number
}

/** PATCH /cart/items/{item_id} 的请求体 */
export type UpdateCartItemRequest = {
  quantity? : number
  selected? : boolean
}

/** PUT /cart/selection 的 query 参数 */
export type SelectCartItemsQuery = {
  store_id? : number
  address_id? : number
}

/** PUT /cart/selection 的请求体 */
export type SelectCartItemsRequest = {
  selected : boolean
  /** 省略则作用于全部条目 */
  item_ids? : number[]
}

/** POST /cart/items/batch-delete 的 query 参数 */
export type BatchDeleteCartItemsQuery = {
  store_id? : number
  address_id? : number
}

/** POST /cart/items/batch-delete 的请求体 */
export type BatchDeleteCartItemsRequest = {
  item_ids? : number[]
  /** 为 true 时删除全部已勾选条目，与 `item_ids` 互斥 */
  selected? : boolean
}

/** GET /refunds 的 query 参数 */
export type ListRefundsQuery = {
  page? : number
  page_size? : number
  /** 退款单状态机，与 `refunds.status` 的 SMALLINT 取值逐值一致。 */
  status? : RefundStatus
}

/** GET /refunds 的 200 响应体 */
export type ListRefundsResponse = {
  page : number
  page_size : number
  total : number
  items : Refund[]
}

/** GET /me/notifications 的 query 参数 */
export type ListNotificationsQuery = {
  page? : number
  page_size? : number
  unread_only? : boolean
}
