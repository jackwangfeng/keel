// 契约类型 -> 页面要显示的东西。
//
// ## 为什么这一层存在，而不是让模板直接 `{{ item.min_price_cents }}`
//
// 两个理由，第二个是硬的：
//
//  1. 金额一律是「分」的整数（契约约定 1），展示要除以 100。散在各个模板里
//     写 `/100` 迟早漏一处，而漏掉的那处会把 4900 分显示成 4900 元。
//
//  2. **类型闸门看不见 .uvue 里的模板表达式。** scripts/check_app_types.py 跑的是
//     tsc，tsc 不解析 SFC；模板里写 `item.min_price_cents` 时契约把这个字段改了名，
//     tsc 不会红。把所有契约字段的读取收进 .uts，闸门的视野就覆盖了全部读取点，
//     模板只碰下面这些**我们自己**的 Row 类型。
//
//     （uni-app x 自带的 UTS 编译器确实会检查 .uvue，但它把类型错误打成 warning
//     并且照样 exit 0 —— 见 app/README.md「类型检查」那一节。所以它是第二道，
//     不是第一道。）

import {
  AddCartItemRequest,
  Address,
  AddressInput,
  BatchDeleteCartItemsRequest,
  Cart,
  CartItem,
  Problem,
  SelectCartItemsRequest,
  UpdateCartItemRequest,
  UpdateMeRequest,
  User,
  UserIdentity,
  ApplicableCoupon,
  Category,
  ClaimableCouponTemplate,
  CouponScope,
  ListCouponTemplatesQuery,
  ListCouponsQuery,
  ListProductsQuery,
  Money,
  Order,
  OrderCreateRequest,
  OrderDetail,
  OrderItem,
  OrderItemInput,
  OrderPreview,
  OrderStatus,
  PaymentRecord,
  ProductDetail,
  ProductSummary,
  SearchHit,
  SearchRequest,
  Sku,
  UserCoupon,
} from './schema.uts'

// ---------------------------------------------------------------------------
// 金额
// ---------------------------------------------------------------------------

/**
 * 分 -> 「¥12.90」。契约约定 1：金额一律 integer 分，禁止浮点。
 *
 * 参数写成**可选**（`cents ?: Money`）而不是 `Money | null`，是为了同时对上两套
 * 语言：契约里非 required 的金额字段生成出来是 `freight_cents?: Money`，
 * 在 UTS 下那是 `Money | null`，在 tsc 下那是 `Money | undefined`。
 * 声明成 `Money | null` 的话 tsc 会拒绝传 undefined，而声明成可选参数两边都成立。
 */
export function yuan(cents ?: Money) : string {
  const c = cents != null ? cents! : 0
  const neg = c < 0
  const abs = neg ? -c : c
  const intPart = Math.floor(abs / 100)
  const frac = abs % 100
  const fracText = frac < 10 ? '0' + frac.toString() : frac.toString()
  return (neg ? '-¥' : '¥') + intPart.toString() + '.' + fracText
}

// ---------------------------------------------------------------------------
// 封面
// ---------------------------------------------------------------------------

/**
 * 契约声明了 image_url，但服务端目前从不填（见 app/README.md）。没有图时用一块
 * 按 id 取色的色块 + 标题首字占位：同一件商品在列表、详情、订单里颜色一致，
 * 而且一眼看得出是占位，不会被当成「图挂了」。
 */
const COVER_TONES : string[] = ['#C9A27E', '#A7B49A', '#D4B896', '#B98A6E', '#9FA8A3', '#C7A9A0']

export type Cover = {
  imageUrl : string
  color : string
  glyph : string
}

export function coverOf(key : number, title : string, imageUrl ?: string) : Cover {
  const idx = Math.abs(Math.floor(key)) % COVER_TONES.length
  return {
    imageUrl: imageUrl != null ? imageUrl! : '',
    color: COVER_TONES[idx],
    glyph: title.length > 0 ? title.substring(0, 1) : '·',
  } as Cover
}

// ---------------------------------------------------------------------------
// 商品
// ---------------------------------------------------------------------------

export type ProductRow = {
  id : number
  title : string
  subtitle : string
  priceText : string
  /** 契约里 status: 0 草稿 / 1 上架 / 2 下架。下架的要显式说出来。 */
  offShelf : boolean
  soldOut : boolean
  cover : Cover
}

export function productRow(p : ProductSummary) : ProductRow {
  const min = p.min_price_cents
  const max = p.max_price_cents
  let priceText = yuan(min)
  if (max != null && min != null && max! > min!) {
    priceText = yuan(min) + ' ~ ' + yuan(max)
  }
  return {
    id: p.id,
    title: p.title,
    subtitle: p.subtitle != null ? p.subtitle! : '',
    priceText: priceText,
    offShelf: p.status == 2,
    // in_stock 是可选字段：契约没保证一定返回。没返回时不敢说它没货。
    soldOut: p.in_stock != null && !p.in_stock!,
    cover: coverOf(p.id, p.title, p.image_url),
  } as ProductRow
}

/**
 * 搜索结果 -> 和商品列表同一种 Row，页面复用同一套卡片。
 *
 * 这里**不能**写 `productRow(hit)`：SearchHit 与 ProductSummary 在契约里是两个
 * 独立的 schema，TS 的结构化类型下可以互相赋值，UTS 落到 Kotlin 就是两个无关的类
 * （同 orderDetailView 那段注释的道理）。所以字段在这里重新取一遍。
 */
export function searchHitRow(h : SearchHit) : ProductRow {
  const min = h.min_price_cents
  const max = h.max_price_cents
  let priceText = yuan(min)
  if (max != null && max! > min) {
    priceText = yuan(min) + ' ~ ' + yuan(max)
  }
  return {
    id: h.id,
    title: h.title,
    subtitle: h.subtitle != null ? h.subtitle! : '',
    priceText: priceText,
    offShelf: h.status == 2,
    soldOut: h.in_stock != null && !h.in_stock!,
    cover: coverOf(h.id, h.title, h.image_url),
  } as ProductRow
}

export type SkuRow = {
  id : number
  /** 规格值拼成的短标签，例如「中度」「900ml」；没有规格时退回 sku_code。 */
  label : string
  /** 规格名，例如「烘焙」「容量」；页面拿它当规格区的标题。 */
  specName : string
  priceText : string
  availableQty : number
  soldOut : boolean
}

/**
 * 把 JSON 文本里的字符串字面量按顺序取出来：{"烘焙":"中度"} -> ["烘焙", "中度"]。
 *
 * 为什么不直接遍历 spec_values：契约里它是 `additionalProperties: {type: string}`，
 * 生成到 UTS 是 UTSJSONObject，而 UTSJSONObject 的 toMap()/getString() 在 web 端
 * 运行时并不存在（UTS 编译器原样透传，页面当场 TypeError —— 实测记录在 app/README.md）。
 * JSON.stringify 两端都有，所以绕一道文本。契约约定值都是字符串，这里只认字符串。
 */
function jsonStrings(raw : string) : string[] {
  const out : string[] = []
  let i = 0
  while (i < raw.length) {
    if (raw.substring(i, i + 1) != '"') {
      i++
      continue
    }
    let j = i + 1
    let buf = ''
    while (j < raw.length) {
      const c = raw.substring(j, j + 1)
      if (c == '\\' && j + 1 < raw.length) {
        buf += raw.substring(j + 1, j + 2)
        j += 2
        continue
      }
      if (c == '"') {
        break
      }
      buf += c
      j++
    }
    out.push(buf)
    i = j + 1
  }
  return out
}

export function skuRow(s : Sku) : SkuRow {
  const names : string[] = []
  const values : string[] = []
  const sv = s.spec_values
  if (sv != null) {
    const parts = jsonStrings(JSON.stringify(sv))
    for (let k = 0; k + 1 < parts.length; k += 2) {
      names.push(parts[k])
      values.push(parts[k + 1])
    }
  }
  return {
    id: s.id,
    label: values.length > 0 ? values.join(' / ') : s.sku_code,
    specName: names.length > 0 ? names.join(' / ') : '规格',
    priceText: yuan(s.price_cents),
    availableQty: s.available_qty,
    soldOut: s.available_qty <= 0,
  } as SkuRow
}

export type ProductDetailView = {
  id : number
  title : string
  subtitle : string
  description : string
  priceText : string
  offShelf : boolean
  skus : SkuRow[]
  cover : Cover
}

export function productDetailView(p : ProductDetail) : ProductDetailView {
  const rows : SkuRow[] = []
  for (let i = 0; i < p.skus.length; i++) {
    rows.push(skuRow(p.skus[i]))
  }
  return {
    id: p.id,
    title: p.title,
    subtitle: p.subtitle != null ? p.subtitle! : '',
    description: p.description != null ? p.description! : '',
    priceText: yuan(p.min_price_cents),
    offShelf: p.status == 2,
    skus: rows,
    cover: coverOf(p.id, p.title, p.image_url),
  } as ProductDetailView
}

// ---------------------------------------------------------------------------
// 订单
// ---------------------------------------------------------------------------

/**
 * 履约维度的文案。契约 OrderStatus：
 * 10 待支付 / 20 已支付 / 30 已发货 / 40 已完成 / 50 退款中 / 60 已退款 / 90 已关闭。
 */
export function orderStatusText(status : OrderStatus) : string {
  if (status == 10) return '待支付'
  if (status == 20) return '已支付'
  if (status == 30) return '已发货'
  if (status == 40) return '已完成'
  if (status == 50) return '退款中'
  if (status == 60) return '已退款'
  if (status == 90) return '已关闭'
  return '未知状态 ' + status.toString()
}

/**
 * 状态徽章的色调，页面按它挑样式类：warn 待支付 / ok 已支付·已发货·已完成 /
 * refund 退款中·已退款 / muted 已关闭。
 */
export function orderStatusTone(status : OrderStatus) : string {
  if (status == 10) return 'warn'
  if (status == 20 || status == 30 || status == 40) return 'ok'
  if (status == 50 || status == 60) return 'refund'
  return 'muted'
}

/**
 * 售后维度的文案。**必须和 status 组合渲染**（契约 OrderRefundStatus 的注释写着
 * 这件事）：只看 status 的话，「买三退一的已发货订单」和「完全没有售后的订单」
 * 长得一模一样。没有售后时返回空串，由页面决定不显示。
 */
export function refundStatusText(refundStatus : number) : string {
  if (refundStatus == 1) return '退款中'
  if (refundStatus == 2) return '部分退款'
  if (refundStatus == 3) return '已全额退款'
  return ''
}

/**
 * 「2026-09-26T08:05:12+08:00」->「09-26 08:05」。列表里年份和秒都是噪音。
 * 不是这个形状（服务端改了格式）就原样返回，而不是显示一截切坏的字符串。
 */
export function shortTime(iso : string) : string {
  if (iso.length >= 16 && iso.substring(10, 11) == 'T') {
    return iso.substring(5, 10) + ' ' + iso.substring(11, 16)
  }
  return iso
}

export type OrderRow = {
  orderNo : string
  statusText : string
  statusTone : string
  refundText : string
  payableText : string
  createdAt : string
  payable : boolean
}

export function orderRow(o : Order) : OrderRow {
  return {
    orderNo: o.order_no,
    statusText: orderStatusText(o.status),
    statusTone: orderStatusTone(o.status),
    refundText: refundStatusText(o.refund_status),
    payableText: yuan(o.payable_cents),
    createdAt: shortTime(o.created_at),
    // 契约：仅 status=10（待支付）能发起支付。
    payable: o.status == 10,
  } as OrderRow
}

export type OrderItemRow = {
  title : string
  quantity : number
  priceText : string
  amountText : string
  cover : Cover
}

export function orderItemRow(it : OrderItem) : OrderItemRow {
  return {
    title: it.title,
    quantity: it.quantity,
    priceText: yuan(it.price_cents),
    amountText: yuan(it.amount_cents),
    // 按 product_id 取色，和商品列表里那块一致；老订单没带 product_id 时退到 sku_id。
    cover: coverOf(it.product_id != null ? it.product_id! : it.sku_id, it.title, it.image_url),
  } as OrderItemRow
}

export type PaymentRow = {
  channelText : string
  statusText : string
  amountText : string
}

/** 渠道字符串 -> 中文。契约 PaymentRecord.channel 的枚举是 wechat/alipay/balance。 */
export function paymentRow(p : PaymentRecord) : PaymentRow {
  const ch = p.channel != null ? p.channel! : ''
  let channelText = ch
  if (ch == 'wechat') channelText = '微信'
  if (ch == 'alipay') channelText = '支付宝'
  if (ch == 'balance') channelText = '余额'
  // 契约 PaymentRecord.status：0 待支付 / 1 成功 / 2 失败 / 3 已关闭。
  const st = p.status != null ? p.status! : -1
  let statusText = '未知'
  if (st == 0) statusText = '待支付'
  if (st == 1) statusText = '成功'
  if (st == 2) statusText = '失败'
  if (st == 3) statusText = '已关闭'
  return {
    channelText: channelText,
    statusText: statusText,
    amountText: yuan(p.amount_cents),
  } as PaymentRow
}

export type OrderDetailView = {
  head : OrderRow
  receiver : string
  goodsAmountText : string
  freightText : string
  discountText : string
  paidText : string
  /** 这一单用的券（user_coupon_id），0 = 没用券。 */
  couponId : number
  /** 券名，**下单时的快照**（Order.coupon_name）；没用券是空串。 */
  couponName : string
  items : OrderItemRow[]
  payments : PaymentRow[]
}

export function orderDetailView(o : OrderDetail) : OrderDetailView {
  const rows : OrderItemRow[] = []
  const items = o.items
  if (items != null) {
    for (let i = 0; i < items!.length; i++) {
      rows.push(orderItemRow(items![i]))
    }
  }
  let receiver = ''
  const r = o.receiver
  if (r != null) {
    receiver = r!.receiver_name + ' ' + r!.phone + ' ' + r!.province + r!.city + r!.district + r!.detail
  }
  // 这里**不能**写 `orderRow(o)`：OrderDetail 在契约里是 `allOf: [Order, {...}]`，
  // 生成到 UTS 之后是一个展平出来的独立类型。TS 的结构化类型下它可以直接当 Order 用，
  // 但 UTS 要落到 Kotlin/Swift，那边只有名义类型 —— 两个类没有继承关系就是两个类。
  // 所以字段在这里重新取一遍，而不是靠一个只在 TS 下成立的赋值兼容。
  const head = {
    orderNo: o.order_no,
    statusText: orderStatusText(o.status),
    statusTone: orderStatusTone(o.status),
    refundText: refundStatusText(o.refund_status),
    payableText: yuan(o.payable_cents),
    createdAt: shortTime(o.created_at),
    payable: o.status == 10,
  } as OrderRow
  const pays : PaymentRow[] = []
  const payments = o.payments
  if (payments != null) {
    for (let i = 0; i < payments!.length; i++) {
      pays.push(paymentRow(payments![i]))
    }
  }
  return {
    head: head,
    payments: pays,
    receiver: receiver,
    goodsAmountText: yuan(o.goods_amount_cents),
    freightText: yuan(o.freight_cents),
    discountText: yuan(o.discount_cents),
    paidText: yuan(o.paid_cents),
    couponId: o.user_coupon_id != null ? o.user_coupon_id! : 0,
    couponName: o.coupon_name != null ? o.coupon_name! : '',
    items: rows,
  } as OrderDetailView
}

// ---------------------------------------------------------------------------
// 下单试算
// ---------------------------------------------------------------------------

export type PreviewView = {
  goodsAmountText : string
  freightText : string
  discountText : string
  payableText : string
  /** 提交订单时要回填给服务端的 expected_payable_cents（契约：对不上回 409）。 */
  payableCents : number
  /** 服务端认下的券（回显的 user_coupon_id），0 = 这次试算没用券。 */
  couponId : number
  /** 这一单能用的券，按优惠金额从大到小（服务端排好的，第一张就是最省的）。 */
  coupons : CouponOption[]
}

export function previewView(p : OrderPreview) : PreviewView {
  const options : CouponOption[] = []
  const list = p.applicable_coupons
  if (list != null) {
    for (let i = 0; i < list!.length; i++) {
      options.push(couponOption(list![i]))
    }
  }
  return {
    goodsAmountText: yuan(p.goods_amount_cents),
    freightText: yuan(p.freight_cents),
    discountText: yuan(p.discount_cents),
    payableText: yuan(p.payable_cents),
    payableCents: p.payable_cents,
    couponId: p.user_coupon_id != null ? p.user_coupon_id! : 0,
    coupons: options,
  } as PreviewView
}

// ---------------------------------------------------------------------------
// 优惠券
// ---------------------------------------------------------------------------
//
// 三种券的形状（可领的模板 / 我的券 / 这一单能用的券）字段大半重合，但在 UTS 里是
// 三个互不相干的类（名义类型，理由同 orderDetailView 里那段），所以共用的文案函数
// 只收原始字段，不收对象。

/** 「¥50.00」->「¥50」，「¥9.90」照旧。券面上的整数金额带 .00 是噪音。 */
function faceYuan(cents : number) : string {
  const t = yuan(cents)
  return t.endsWith('.00') ? t.substring(0, t.length - 3) : t
}

/** 折扣率（千分比，900 = 9 折）->「9折」「8.5折」。 */
function rateText(rate : number) : string {
  const tenth = Math.round(rate / 10)
  const whole = Math.floor(tenth / 10)
  const frac = tenth % 10
  return (frac == 0 ? whole.toString() : whole.toString() + '.' + frac.toString()) + '折'
}

/** 券面上最大的那几个字：减多少 / 几折 / 包邮。 */
export function couponValueText(couponType : number, discountCents : number, discountRate : number) : string {
  if (couponType == 2) return rateText(discountRate)
  if (couponType == 4) return '包邮'
  return faceYuan(discountCents)
}

/** 使用规则：满 50 减 10 / 满 100 打 9 折，最高减 30 / 立减 5 / 满 99 包邮。 */
export function couponRuleText(
  couponType : number,
  thresholdCents : number,
  discountCents : number,
  discountRate : number,
  maxDiscountCents : number
) : string {
  const gate = thresholdCents > 0 ? '满' + faceYuan(thresholdCents) : ''
  if (couponType == 1) {
    return gate != '' ? gate + '减' + faceYuan(discountCents) : '无门槛减' + faceYuan(discountCents)
  }
  if (couponType == 2) {
    let t = (gate != '' ? gate + '打' : '全场') + rateText(discountRate)
    if (maxDiscountCents > 0) t += '，最高减' + faceYuan(maxDiscountCents)
    return t
  }
  if (couponType == 3) return '立减' + faceYuan(discountCents)
  if (couponType == 4) return gate != '' ? gate + '包邮' : '无门槛包邮'
  return ''
}

/**
 * 适用范围：「全场可用」/「限华北」/「限咖啡豆、挂耳；不含 xx 店」。
 * 没有范围行、或只有全场那一行 = 全场。target_name 缺了（服务端查不到名字）就写编号，
 * 不写一个空的「限」。
 */
export function couponScopeText(scopes : CouponScope[]) : string {
  const inc : string[] = []
  const exc : string[] = []
  for (let i = 0; i < scopes.length; i++) {
    const sc = scopes[i]
    if (sc.scope_type == 1) continue
    let name = sc.target_name != null ? sc.target_name! : ''
    if (name == '') name = '#' + (sc.target_id != null ? sc.target_id!.toString() : '?')
    if (sc.include) inc.push(name)
    else exc.push(name)
  }
  let t = inc.length > 0 ? '限' + inc.join('、') : '全场可用'
  if (exc.length > 0) t += '；不含' + exc.join('、')
  return t
}

/** 「2026-10-26T…」->「2026-10-26」。 */
function day(iso : string) : string {
  return iso.length >= 10 ? iso.substring(0, 10) : iso
}

/** 领券中心的一行。 */
export type ClaimRow = {
  id : number
  name : string
  valueText : string
  ruleText : string
  scopeText : string
  validText : string
  canClaim : boolean
  /** 按钮上的字：领取 / 已领取 / 已领完 / 不可领。 */
  actionText : string
  /** 「剩 12 张」；不限量（remaining 为 null）就是空串，不写「剩 ∞ 张」。 */
  remainingText : string
}

export function claimRow(t : ClaimableCouponTemplate) : ClaimRow {
  let valid = ''
  if (t.valid_mode == 2) {
    valid = '领取后 ' + t.valid_days.toString() + ' 天内有效'
  } else {
    const a = t.valid_start_at != null ? day(t.valid_start_at!) : ''
    const b = t.valid_end_at != null ? day(t.valid_end_at!) : ''
    valid = a + ' 至 ' + b
  }
  let action = '领取'
  if (!t.can_claim) {
    // 次序有讲究：领过又领完了的，对这个人来说是「已领取」—— 那是他关心的那件事。
    if (t.claimed_count > 0) action = '已领取'
    else if (t.remaining != null && t.remaining! <= 0) action = '已领完'
    else action = '不可领'
  }
  return {
    id: t.id,
    name: t.name,
    valueText: couponValueText(t.coupon_type, t.discount_cents, t.discount_rate),
    ruleText: couponRuleText(t.coupon_type, t.threshold_cents, t.discount_cents, t.discount_rate, t.max_discount_cents),
    scopeText: couponScopeText(t.scopes),
    validText: valid,
    canClaim: t.can_claim,
    actionText: action,
    remainingText: t.remaining != null ? '剩 ' + t.remaining!.toString() + ' 张' : '',
  } as ClaimRow
}

/** 我的优惠券的一行。 */
export type CouponRow = {
  id : number
  name : string
  valueText : string
  ruleText : string
  scopeText : string
  validText : string
}

export function couponRow(c : UserCoupon) : CouponRow {
  const used = c.used_at
  return {
    id: c.id,
    name: c.name,
    valueText: couponValueText(c.coupon_type, c.discount_cents, c.discount_rate),
    ruleText: couponRuleText(c.coupon_type, c.threshold_cents, c.discount_cents, c.discount_rate, c.max_discount_cents),
    scopeText: couponScopeText(c.scopes),
    validText: used != null ? '使用于 ' + shortTime(used!) : day(c.valid_start_at) + ' 至 ' + day(c.valid_end_at),
  } as CouponRow
}

/** 结算页选券列表里的一项。 */
export type CouponOption = {
  id : number
  name : string
  ruleText : string
  validText : string
  /**
   * 「-¥10」：**这一单**能省多少（applicable_discount_cents），不是券面额。
   * 9 折券的面额字段是 0，用面额的话它在列表里显示「省 ¥0」。
   */
  saveText : string
}

export function couponOption(c : ApplicableCoupon) : CouponOption {
  return {
    id: c.id,
    name: c.name,
    ruleText: couponRuleText(c.coupon_type, c.threshold_cents, c.discount_cents, c.discount_rate, c.max_discount_cents),
    validText: day(c.valid_end_at) + ' 到期',
    saveText: '-' + yuan(c.applicable_discount_cents),
  } as CouponOption
}

/** 领券中心的查询。 */
export function templateListQuery(page : number, pageSize : number) : ListCouponTemplatesQuery {
  return { page: page, page_size: pageSize } as ListCouponTemplatesQuery
}

/** 我的优惠券的查询。status：available / locked / used / expired。 */
export function couponListQuery(status : string, page : number, pageSize : number) : ListCouponsQuery {
  return { status: status, page: page, page_size: pageSize } as ListCouponsQuery
}

// ---------------------------------------------------------------------------
// 请求那一侧：页面要发的东西 -> 契约类型
// ---------------------------------------------------------------------------
//
// 文件头那条理由对**写**同样成立，而且这一侧出过一次真事故：多门店（00020）把
// store_id 加进了 OrderCreateRequest 的 required，而结算页在 .uvue 里直接写着
// `const req: OrderCreateRequest = { items, address_id }`。
//
//   · tsc 闸门看不见它 —— check_app_types.py 只编 .uts，不编 .uvue；
//   · DCloud 那道闸门（check_app_build.py）**看得见也拦得住** —— 实测把旧写法
//     塞回去，它 exit 1，报的正是 `Property 'store_id' is missing`。但它要
//     500 多个 npm 包，只在 CI 的独立 client job 里跑，不在 check-all.sh 里。
//
// 所以合并时本地跑的那几道全绿，能抓住它的那一道没被跑到。列表页与搜索页
// 当时也在 .uvue 里写着 `{ page: 1, page_size: 20 }` 这种字面量 —— 那两处没出事
// 只是因为这一轮没改那两个类型的必填字段。
//
// 所以请求的构造也收进这里。页面只传「我们自己的」原始值，契约字段名一个都不写。
// 这条约定现在有执行者：check_app_types.py 会拒绝 .uvue 里直接 import schema.uts，
// 以及把字面量直接塞给那几个收契约请求的接口函数。它的价值是**把发现的时间提前**
// —— 从「CI 里那个要装 500 个包的 job」挪进每个人本地都跑的 check-all.sh。

/**
 * 商品列表的查询。storeId 来自 store.uts —— 与结算用的是同一家店，
 * 列表上的价格区间才和最后扣的钱对得上。null 表示还没解析出门店，服务端回落默认店。
 */
export function productListQuery(
  page : number,
  pageSize : number,
  storeId : number | null,
  categoryId : number | null
) : ListProductsQuery {
  const q : ListProductsQuery = { page: page, page_size: pageSize }
  if (storeId != null) {
    q.store_id = storeId!
  }
  // null = 「全部」，不带这个参数。
  if (categoryId != null) {
    q.category_id = categoryId!
  }
  return q
}

// ---------------------------------------------------------------------------
// 分类
// ---------------------------------------------------------------------------

export type CategoryChip = {
  id : number
  name : string
}

/**
 * 分类树 -> 首页那一排 chip：只取根分类（契约里顶层数组就是根，子分类在 children）。
 * 一排横向的 chip 放不下两层；有了多层的店再做分类页，那时 children 就用上了。
 */
export function categoryChips(tree : Category[]) : CategoryChip[] {
  const out : CategoryChip[] = []
  for (let i = 0; i < tree.length; i++) {
    out.push({ id: tree[i].id, name: tree[i].name } as CategoryChip)
  }
  return out
}

/** 检索请求。store_id 与 GET /products 的同名参数逐字同义（契约原话）。 */
export function searchRequest(query : string, size : number, storeId : number | null) : SearchRequest {
  const r : SearchRequest = { query: query, size: size }
  if (storeId != null) {
    r.store_id = storeId!
  }
  return r
}

/** 结算的一行：哪个规格、几件。单品直购是一行，从购物车来是勾选的那几行。 */
export type OrderLine = {
  skuId : number
  quantity : number
}

/**
 * 结算 / 试算的请求体（两条接口共用一个 schema）。
 *
 * storeId 是 number 而不是 number | null：契约里它是必填，**服务端不替客户端猜**。
 * 「不在服务范围」（store.uts 里 storeId 为 null）的时候页面根本不该走到这里 ——
 * 让类型挡住这件事，比在这里塞一个 0 进去、再让服务端回 422 要早一步。
 *
 * expectedPayableCents：试算过才带。契约说服务端复算不一致时回 409
 * price-changed，防止以旧价成交；没试算过就带一个瞎猜的值，只会把每一单都变成 409。
 *
 * 写成必填的 `Money | null`、没试算过就显式传 null，而**不是**可选参数 `?: Money`：
 * UTS 的可选参数落到 Kotlin 是 `Money?` 且**没有默认值**，调用处一省略就编不过
 * （"No value passed for parameter 'expectedPayableCents'"，make app-apk 实测；
 * tsc 与 uni build 都是绿的，因为 Kotlin 编译只在打 apk 时才发生）。
 *
 * userCouponId 同理写成必填的 `number | null`，null = 不用券。一单只能用一张。
 */
export function orderRequest(
  lines : OrderLine[],
  addressId : number,
  storeId : number,
  expectedPayableCents : Money | null,
  userCouponId : number | null
) : OrderCreateRequest {
  const items : OrderItemInput[] = []
  for (let i = 0; i < lines.length; i++) {
    items.push({ sku_id: lines[i].skuId, quantity: lines[i].quantity } as OrderItemInput)
  }
  const req : OrderCreateRequest = {
    items: items,
    store_id: storeId,
    address_id: addressId,
  }
  if (expectedPayableCents != null) {
    req.expected_payable_cents = expectedPayableCents!
  }
  if (userCouponId != null) {
    req.user_coupon_id = userCouponId!
  }
  return req
}

// ---------------------------------------------------------------------------
// 字段级错误（422 的 Problem.errors）
// ---------------------------------------------------------------------------

export type FieldErr = {
  field : string
  message : string
}

/** Problem.errors -> 页面按 field 标红对应输入框。没有 errors 就是空数组。 */
export function fieldErrors(p : Problem | null) : FieldErr[] {
  const out : FieldErr[] = []
  if (p == null) return out
  const errs = p!.errors
  if (errs == null) return out
  for (let i = 0; i < errs!.length; i++) {
    const e = errs![i]
    out.push({
      field: e.field != null ? e.field! : '',
      message: e.message != null ? e.message! : '',
    } as FieldErr)
  }
  return out
}

// ---------------------------------------------------------------------------
// 地址簿
// ---------------------------------------------------------------------------

export type AddressRow = {
  id : number
  name : string
  phone : string
  /** 「上海市 上海市 徐汇区」 */
  regionText : string
  detail : string
  /** 一行写完：地区 + 街道 + 门牌。结算页与列表的副标题用它。 */
  fullText : string
  isDefault : boolean
  /** 家 / 公司 / 学校；没有标签是空串。 */
  tagText : string
}

function tagText(tag ?: number) : string {
  if (tag == 1) return '家'
  if (tag == 2) return '公司'
  if (tag == 3) return '学校'
  return ''
}

export function addressRow(a : Address) : AddressRow {
  const region = a.province + ' ' + a.city + ' ' + a.district
  const street = a.street != null ? a.street! : ''
  return {
    id: a.id,
    name: a.receiver_name,
    phone: a.phone,
    regionText: region,
    detail: a.detail,
    fullText: region + ' ' + (street != '' ? street + ' ' : '') + a.detail,
    isDefault: a.is_default,
    tagText: tagText(a.tag),
  } as AddressRow
}

/** 编辑页的表单：全是页面自己的字段名，契约字段名只在这里和 addressRequest 里出现。 */
export type AddressForm = {
  receiverName : string
  phone : string
  province : string
  city : string
  district : string
  detail : string
  isDefault : boolean
}

export function addressForm(a : Address) : AddressForm {
  return {
    receiverName: a.receiver_name,
    phone: a.phone,
    province: a.province,
    city: a.city,
    district: a.district,
    detail: a.detail,
    isDefault: a.is_default,
  } as AddressForm
}

/** 表单字段 -> 契约字段名（422 的 errors[].field 是契约名，标红要映射回表单）。 */
export function addressFormField(contractField : string) : string {
  if (contractField == 'receiver_name') return 'receiverName'
  if (contractField == 'is_default') return 'isDefault'
  return contractField
}

/**
 * AddressInput。isDefault 的含义取决于用在哪：
 *   · 新增：true = 设为默认（服务端同事务先清旧默认）；
 *   · 修改：**只能传这条地址当前的值**。PUT 不负责切默认，false 改 true 会被 422
 *     use-default-endpoint 打回 —— 页面要切默认，PUT 之后另调 setDefaultAddress。
 */
export function addressRequest(f : AddressForm, isDefault : boolean) : AddressInput {
  return {
    receiver_name: f.receiverName,
    phone: f.phone,
    province: f.province,
    city: f.city,
    district: f.district,
    detail: f.detail,
    is_default: isDefault,
  } as AddressInput
}

// ---------------------------------------------------------------------------
// 购物车
// ---------------------------------------------------------------------------

export type CartRow = {
  id : number
  skuId : number
  productId : number
  title : string
  specText : string
  /** 失效 / 本店不售的行 price_cents 是 null：显示「—」，不显示 ¥0.00。 */
  priceText : string
  quantity : number
  selected : boolean
  /** 能按这个数量买下（status == available）。只有这种行能勾选、能结算。 */
  available : boolean
  /** 不能买的原因；available 的行是空串。 */
  statusText : string
  cover : Cover
}

/** CartItem.status -> 给买家看的原因。 */
export function cartStatusText(status : string) : string {
  if (status == 'off_shelf') return '已失效'
  if (status == 'not_sold_in_store') return '当前门店不售'
  if (status == 'out_of_stock') return '暂时无货'
  if (status == 'insufficient_stock') return '库存不足'
  return ''
}

export function cartRow(it : CartItem) : CartRow {
  const values : string[] = []
  const sv = it.spec_values
  if (sv != null) {
    const parts = jsonStrings(JSON.stringify(sv))
    for (let k = 0; k + 1 < parts.length; k += 2) {
      values.push(parts[k + 1])
    }
  }
  const title = it.title != null ? it.title! : '规格 #' + it.sku_id.toString()
  const pid = it.product_id != null ? it.product_id! : 0
  const available = it.status == 'available'
  return {
    id: it.id,
    skuId: it.sku_id,
    productId: pid,
    title: title,
    specText: values.join(' / '),
    priceText: it.price_cents != null ? yuan(it.price_cents!) : '—',
    quantity: it.quantity,
    // 不能买的行，页面上不显示为勾选：服务端的 selected 可能还是 true（加购时勾上的），
    // 但合计不算它、结算也不带它 —— 显示成勾选会让人以为它在这一单里。
    selected: it.selected && available,
    available: available,
    statusText: cartStatusText(it.status),
    cover: coverOf(pid > 0 ? pid : it.sku_id, title, it.image_url),
  } as CartRow
}

export type CartView = {
  rows : CartRow[]
  /** 已勾选且能买的那几行的合计（服务端算的 selected_total_cents）。 */
  selectedText : string
  selectedCents : number
  /** 勾选且能买的行数。结算按钮上写「去结算(2)」。 */
  selectedCount : number
  /** 能买的行都勾上了（且至少有一行能买）：全选框显示为勾选。 */
  allSelected : boolean
  availableCount : number
  /** 这次按哪家门店算的（服务端回显）；0 = 没有门店（match_type = none）。 */
  storeId : number
}

export function cartView(c : Cart) : CartView {
  const rows : CartRow[] = []
  let selected = 0
  let avail = 0
  for (let i = 0; i < c.items.length; i++) {
    const r = cartRow(c.items[i])
    rows.push(r)
    if (r.available) avail++
    if (r.selected) selected++
  }
  const sid = c.store.store_id
  return {
    rows: rows,
    selectedText: yuan(c.selected_total_cents),
    selectedCents: c.selected_total_cents,
    selectedCount: selected,
    allSelected: avail > 0 && selected == avail,
    availableCount: avail,
    storeId: sid != null ? sid! : 0,
  } as CartView
}

/** 去结算带哪些行：能买且勾选的。与服务端 selected_total_cents 的口径一致。 */
export function checkoutLines(rows : CartRow[]) : OrderLine[] {
  const out : OrderLine[] = []
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].available && rows[i].selected) {
      out.push({ skuId: rows[i].skuId, quantity: rows[i].quantity } as OrderLine)
    }
  }
  return out
}

export function addCartRequest(skuId : number, quantity : number) : AddCartItemRequest {
  return { sku_id: skuId, quantity: quantity } as AddCartItemRequest
}

export function cartQuantityRequest(quantity : number) : UpdateCartItemRequest {
  return { quantity: quantity } as UpdateCartItemRequest
}

export function cartCheckRequest(selected : boolean) : UpdateCartItemRequest {
  return { selected: selected } as UpdateCartItemRequest
}

/** 全选 / 全不选：item_ids 省略即全车。 */
export function cartSelectAllRequest(selected : boolean) : SelectCartItemsRequest {
  return { selected: selected } as SelectCartItemsRequest
}

export function cartDeleteRequest(itemIds : number[]) : BatchDeleteCartItemsRequest {
  return { item_ids: itemIds } as BatchDeleteCartItemsRequest
}

// ---------------------------------------------------------------------------
// 个人信息
// ---------------------------------------------------------------------------

export type MeView = {
  nickname : string
  /** 脱敏的手机号（138****8000）；没绑是空串。 */
  phone : string
  gender : number
  genderText : string
  hasPassword : boolean
}

export function genderText(g : number) : string {
  if (g == 1) return '男'
  if (g == 2) return '女'
  return '未设置'
}

export function meView(u : User) : MeView {
  const g = u.gender != null ? u.gender! : 0
  return {
    nickname: u.nickname,
    phone: u.phone != null ? u.phone! : '',
    gender: g,
    genderText: genderText(g),
    hasPassword: u.has_password == true,
  } as MeView
}

/** PATCH /me 的请求体。只带改了的字段（契约 minProperties: 1）。 */
export function meUpdateRequest(nickname : string | null, gender : number | null) : UpdateMeRequest {
  const r : UpdateMeRequest = {}
  if (nickname != null) r.nickname = nickname!
  if (gender != null) r.gender = gender!
  return r
}

export type IdentityRow = {
  provider : number
  name : string
  boundAt : string
}

export function identityName(provider : number) : string {
  if (provider == 1) return '微信小程序'
  if (provider == 2) return '微信公众号'
  if (provider == 3) return '微信开放平台'
  if (provider == 4) return '支付宝'
  if (provider == 5) return 'Apple'
  return '第三方账号 #' + provider.toString()
}

export function identityRow(i : UserIdentity) : IdentityRow {
  return {
    provider: i.provider,
    name: identityName(i.provider),
    boundAt: shortTime(i.created_at),
  } as IdentityRow
}
