<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="head" :style="{ paddingTop: (statusBarHeight + 28) + 'px' }">
        <view class="row" @click="onProfile">
          <view class="avatar"><text class="avatar-text">{{ avatarGlyph }}</text></view>
          <view class="fill">
            <text class="t-title">{{ loggedIn ? displayName : '登录 / 注册' }}</text>
            <text class="t-sub">{{ loggedIn ? '欢迎回来' : '登录后可以下单、查看订单' }}</text>
          </view>
          <text v-if="!loggedIn" class="chev">›</text>
        </view>
      </view>

      <view class="body">
        <view class="card-flat">
          <view class="item" @click="goOrders">
            <text class="t-body fill">我的订单</text>
            <text class="chev">›</text>
          </view>
          <view class="line"></view>
          <view class="item" @click="goCoupons">
            <text class="t-body fill">我的优惠券</text>
            <text class="chev">›</text>
          </view>
          <view class="line"></view>
          <view class="item" @click="goCouponCenter">
            <text class="t-body fill">领券中心</text>
            <text class="chev">›</text>
          </view>
          <view class="line"></view>
          <view class="item" @click="goSettings">
            <text class="t-body fill">服务地址</text>
            <text class="t-hint">{{ host }}</text>
            <text class="chev">›</text>
          </view>
        </view>

        <view v-if="loggedIn" class="card-flat">
          <view class="item center" @click="doLogout">
            <text class="t-link">退出登录</text>
          </view>
        </view>
        <text v-if="message != ''" class="t-hint msg">{{ message }}</text>

        <view class="foot">
          <text class="t-hint">Keel 买家端 · v0.1.0</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { logout, ApiFailure } from '@/api/client.uts'
import { clearSession, getBaseUrl, isLoggedIn, loadSession } from '@/api/config.uts'

export default {
  data() {
    return {
      loggedIn: false,
      displayName: '',
      host: '',
      message: '',
      statusBarHeight: 0,
    }
  },
  computed: {
    avatarGlyph(): string {
      if (!this.loggedIn || this.displayName == '') return '客'
      return this.displayName.substring(0, 1)
    },
  },
  onLoad() {
    this.statusBarHeight = uni.getWindowInfo().statusBarHeight
  },
  onShow() {
    this.message = ''
    this.refresh()
  },
  methods: {
    refresh() {
      this.loggedIn = isLoggedIn()
      const s = loadSession()
      this.displayName = s != null && s.nickname != '' ? s.nickname : '买家'
      // 只显示主机部分：完整地址在「服务地址」页里。
      let u = getBaseUrl()
      const i = u.indexOf('://')
      if (i >= 0) u = u.substring(i + 3)
      const j = u.indexOf('/')
      this.host = j > 0 ? u.substring(0, j) : (j == 0 ? '本站' : u)
    },
    onProfile() {
      if (!this.loggedIn) {
        uni.navigateTo({ url: '/pages/auth/login' })
      }
    },
    goOrders() {
      uni.switchTab({ url: '/pages/order/list' })
    },
    // 两个券页自己会在未登录时显示登录入口，这里不拦。
    goCoupons() {
      uni.navigateTo({ url: '/pages/coupon/mine' })
    },
    goCouponCenter() {
      uni.navigateTo({ url: '/pages/coupon/center' })
    },
    goSettings() {
      uni.navigateTo({ url: '/pages/settings/base' })
    },
    doLogout() {
      logout(
        () => {
          clearSession()
          this.refresh()
          this.message = '已退出'
        },
        (f: ApiFailure) => {
          // 服务端吊销失败也要把本地清掉，理由见登录页。
          clearSession()
          this.refresh()
          this.message = '已在本机退出（服务端吊销失败：' + f.message + '）'
        }
      )
    },
  },
}
</script>

<style>
.head {
  padding-left: 20px;
  padding-right: 20px;
  padding-bottom: 12px;
}
.avatar {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  background-color: #3B2A20;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
}
.avatar-text {
  font-size: 24px;
  font-weight: bold;
  color: #F6F1EA;
}
.item {
  flex-direction: row;
  align-items: center;
  height: 56px;
  padding: 0 18px;
}
.center {
  justify-content: center;
}
.line {
  height: 1px;
  background-color: #ECE4DA;
  margin-left: 18px;
}
.chev {
  font-size: 20px;
  color: #C4B8AA;
  margin-left: 8px;
}
.msg {
  text-align: center;
  margin-top: 12px;
}
.foot {
  align-items: center;
  margin-top: 40px;
}
</style>
