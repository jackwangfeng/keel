<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <!-- 状态 -->
        <view class="status">
          <view class="row">
            <text class="t-display">{{ view != null ? view!.head.statusText : (notImplemented ? '待支付' : '') }}</text>
            <view v-if="view != null && view!.head.refundText != ''" class="badge badge-refund refund">
              <text class="badge-text badge-refund-text">{{ view!.head.refundText }}</text>
            </view>
          </view>
          <text class="t-sub">{{ statusLine }}</text>
        </view>

        <!-- 只有服务端真的回了路由层 404/405 才显示。接口通了它自然不出现。 -->
        <view v-if="notImplemented" class="card">
          <text class="t-section">订单详情暂时无法加载</text>
          <text class="t-sub">
            订单已经创建成功，但服务器还没有开放详情查询（{{ error }}）。你仍然可以在下面发起支付。
          </text>
        </view>
        <view v-else-if="error != ''" class="card"><text class="t-err">{{ error }}</text></view>

        <view v-if="view != null && view!.receiver != ''" class="card">
          <text class="t-overline">收货信息</text>
          <view class="gap-s"></view>
          <text class="t-body">{{ view!.receiver }}</text>
        </view>

        <view v-if="view != null && view!.items.length > 0" class="card">
          <view v-for="(it, idx) in view!.items" :key="idx" :class="['row', idx > 0 ? 'item-next' : '']">
            <view class="cover thumb" :style="{ backgroundColor: it.cover.color }">
              <image v-if="it.cover.imageUrl != ''" class="cover-img" :src="it.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ it.cover.glyph }}</text>
            </view>
            <view class="fill item-info">
              <text class="t-section">{{ it.title }}</text>
              <text class="t-hint">{{ it.priceText }} × {{ it.quantity }}</text>
            </view>
            <text class="t-price">{{ it.amountText }}</text>
          </view>

          <view class="divider"></view>
          <view class="kv"><text class="t-sub">商品金额</text><text class="t-body">{{ view!.goodsAmountText }}</text></view>
          <view class="kv">
            <text class="t-sub">运费</text>
            <view class="row">
              <text v-if="view!.freightNote != ''" class="t-hint freight-note">{{ view!.freightNote }}</text>
              <text class="t-body">{{ view!.freightText }}</text>
            </view>
          </view>
          <view v-if="view!.promotionDiscountText != ''" class="kv"><text class="t-sub">活动优惠</text><text class="t-body">{{ view!.promotionDiscountText }}</text></view>
          <text v-for="(pl, pi) in view!.promotionLines" :key="pi" class="t-hint promo-line">{{ pl }}</text>
          <!-- discount_cents 是合计（活动分摊 + 券 + 包邮券抵的运费）。订单上没有单独的「券抵了多少」，
               所以这里不做减法去推它：列出活动与运费抵扣，用了券就注明哪张，最后是合计。 -->
          <view v-if="view!.freightDiscountText != ''" class="kv"><text class="t-sub">运费抵扣</text><text class="t-body">{{ view!.freightDiscountText }}</text></view>
          <text v-if="view!.couponId > 0" class="t-hint promo-line coupon-used">用券：{{ view!.couponName != '' ? view!.couponName : '优惠券' }}</text>
          <view class="kv">
            <text class="t-sub">优惠合计</text>
            <text class="t-body">-{{ view!.discountText }}</text>
          </view>
          <view class="kv"><text class="t-sub">已付</text><text class="t-body">{{ view!.paidText }}</text></view>
          <view v-if="view!.refundedText != ''" class="kv"><text class="t-sub">已退</text><text class="t-body">{{ view!.refundedText }}</text></view>
          <view class="divider"></view>
          <view class="kv"><text class="t-section">应付</text><text class="t-price">{{ view!.head.payableText }}</text></view>
        </view>

        <view v-if="view != null && view!.payments.length > 0" class="card">
          <text class="t-overline">支付记录</text>
          <view v-for="(p, idx) in view!.payments" :key="idx" class="kv">
            <text class="t-body">{{ p.channelText }}</text>
            <view class="row">
              <text class="t-hint pay-state">{{ p.statusText }}</text>
              <text class="t-body">{{ p.amountText }}</text>
            </view>
          </view>
        </view>

        <!-- 支付方式。契约：POST /orders/{order_no}/payments，同样要 Idempotency-Key。
             这里的键是进这个页面时生成的那一个，重复点不会开出第二张支付调起。 -->
        <view v-if="payable" class="card-flat">
          <text class="t-overline pay-head">支付方式</text>
          <view v-for="c in channels" :key="c.key" class="pay-row" @click="pick(c.key)">
            <view class="pay-icon" :style="{ backgroundColor: c.color }"><text class="pay-icon-text">{{ c.glyph }}</text></view>
            <text class="t-body fill">{{ c.name }}</text>
            <view :class="['radio', channel == c.key ? 'radio-on' : '']">
              <view v-if="channel == c.key" class="radio-dot"></view>
            </view>
          </view>
        </view>
        <view v-if="payMessage != ''" class="msg">
          <text :class="payFailed ? 't-err' : 't-ok'">{{ payMessage }}</text>
        </view>

        <!-- 沙箱这件事必须写在脸上。截图里看不出「这是沙箱」的话，
             它看起来就像接了真的微信支付 —— 那是在骗人。 -->
        <view v-if="sandboxNotice != ''" class="notice">
          <text class="notice-title">⚠ 沙箱支付，没有真实资金流动</text>
          <text class="notice-text">{{ sandboxNotice }}</text>
          <view v-if="canSettle">
            <view class="gap-m"></view>
            <view :class="['btn-ghost', 'settle', settling ? 'btn-off' : '']" @click="settle">
              <text class="btn-ghost-text">模拟支付完成（投递沙箱回调）</text>
            </view>
          </view>
          <text v-if="settleMessage != ''" :class="settleFailed ? 't-err' : 't-ok'">{{ settleMessage }}</text>
        </view>

        <!-- 售后单。点进去看进度、撤回。 -->
        <view v-if="view != null && view!.refunds.length > 0" class="card">
          <text class="t-overline">售后</text>
          <view v-for="r in view!.refunds" :key="r.refundNo" class="refund-row between" @click="openRefund(r.refundNo)">
            <view class="fill">
              <text class="t-body">{{ r.typeText }} · {{ r.itemsText }}</text>
              <text class="t-hint">{{ r.createdAt }}</text>
            </view>
            <view class="row">
              <view :class="['badge', 'badge-' + r.statusTone]"><text :class="['badge-text', 'badge-' + r.statusTone + '-text']">{{ r.statusText }}</text></view>
              <text class="chev">›</text>
            </view>
          </view>
        </view>

        <!-- 订单动作。取消与确认收货都是「点两下」：第一下变成「再点一次确认」，第二下才发请求。
             不用系统弹窗：结果一样防误触，而且留在页面里、看得见。 -->
        <view v-if="view != null && (view!.canCancel || view!.canConfirm || view!.canRefund)" class="actions row">
          <view v-if="view!.canCancel" :class="['btn-ghost', 'act', 'cancel-btn', acting ? 'btn-off' : '']" @click="cancel">
            <text class="btn-ghost-text">{{ armed == 'cancel' ? '再点一次确认取消' : '取消订单' }}</text>
          </view>
          <view v-if="view!.canRefund" class="btn-ghost act refund-btn" @click="applyRefund">
            <text class="btn-ghost-text">申请售后</text>
          </view>
          <view v-if="view!.canConfirm" :class="['btn', 'act', 'confirm-btn', acting ? 'btn-off' : '']" @click="confirmReceipt">
            <text class="btn-text">{{ armed == 'confirm' ? '再点一次确认收货' : '确认收货' }}</text>
          </view>
        </view>
        <view v-if="actMessage != ''" class="msg">
          <text :class="actFailed ? 't-err' : 't-ok'">{{ actMessage }}</text>
        </view>

        <view class="meta">
          <view class="kv"><text class="t-hint">订单号</text><text class="t-mono">{{ orderNo }}</text></view>
          <view v-if="view != null" class="kv"><text class="t-hint">下单时间</text><text class="t-hint">{{ view!.head.createdAt }}</text></view>
        </view>
      </view>
    </scroll-view>

    <view v-if="payable" class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="fill">
        <text class="t-hint">应付</text>
        <text class="t-price-l">{{ view != null ? view!.head.payableText : '—' }}</text>
      </view>
      <view :class="['btn', 'bar-btn', paying ? 'btn-off' : '']" @click="pay">
        <text class="btn-text">{{ paying ? '处理中…' : '立即支付' }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import {
  cancelOrder,
  confirmOrder,
  createPayment,
  getOrder,
  sandboxPayloadOf,
  settleSandbox,
  ApiFailure,
  SandboxSettle,
} from '@/api/client.uts'
import { newIdempotencyKey } from '@/api/idempotency.uts'
import { orderDetailView, yuan, OrderDetailView } from '@/api/view.uts'

type Channel = {
  key : string
  name : string
  glyph : string
  color : string
}

export default {
  data() {
    return {
      orderNo: '',
      view: null as OrderDetailView | null,
      payable: false,
      error: '',
      notImplemented: false,
      channel: 'wechat',
      channels: [
        { key: 'wechat', name: '微信支付', glyph: '微', color: '#6F9A6A' },
        { key: 'alipay', name: '支付宝', glyph: '支', color: '#6A8BB0' },
        { key: 'balance', name: '余额', glyph: '余', color: '#B5733A' },
      ] as Channel[],
      payKey: '',
      paying: false,
      payMessage: '',
      payFailed: false,
      sandboxNotice: '',
      settleEnvelope: null as SandboxSettle | null,
      canSettle: false,
      settling: false,
      settleMessage: '',
      settleFailed: false,
      safeBottom: 0,
      // 取消 / 确认收货：各自一个幂等键，进页面生成一次，重试复用。
      cancelKey: '',
      confirmKey: '',
      // 'cancel' / 'confirm'：第一下点过了，等第二下。
      armed: '',
      acting: false,
      actMessage: '',
      actFailed: false,
      loadedOnce: false,
    }
  },
  computed: {
    statusLine(): string {
      const v = this.view
      if (v == null) return ''
      const t = v.head.statusText
      if (t == '待支付') return '订单已创建，完成支付后商家开始备货'
      if (t == '已支付') return '支付成功，商家正在准备发货'
      // 系统自动确认收货的时间照服务端的 auto_confirm_at（有在途售后时会顺延 / 暂停）；
      // 老版本服务端没有这个字段，退回「发货 7 天」的说法。
      if (t == '已发货') {
        return v.autoConfirmAt != ''
          ? '包裹已在路上，' + v.autoConfirmAt + ' 未确认将自动确认收货'
          : '包裹已在路上，发货 7 天后未确认将自动确认收货'
      }
      if (t == '已完成') return '订单已完成，感谢光临'
      if (t == '已关闭') return '订单已关闭'
      // 50 / 60 只用于未发货的整单退款（契约 OrderStatus）；部分退款不改 status。
      if (t == '退款中') return '整单退款处理中'
      if (t == '已退款') return '整单已退款，钱已原路退回'
      return ''
    },
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    const raw = options['order_no']
    this.orderNo = raw != null ? '' + raw : ''
    // 支付的幂等键同样是「进页面生成一次」。
    this.payKey = newIdempotencyKey()
    this.cancelKey = newIdempotencyKey()
    this.confirmKey = newIdempotencyKey()
    this.load()
  },
  onShow() {
    // 从售后申请 / 售后详情回来：售后状态和可退件数都可能变了。
    if (this.loadedOnce) this.load()
  },
  methods: {
    cancel() {
      if (this.acting) return
      if (this.armed != 'cancel') {
        this.armed = 'cancel'
        return
      }
      this.armed = ''
      this.acting = true
      this.actMessage = ''
      cancelOrder(this.orderNo, this.cancelKey,
        (_o, _r) => {
          this.acting = false
          this.actFailed = false
          this.actMessage = '订单已取消，库存与优惠券已退回'
          this.payable = false
          this.load()
        },
        (f: ApiFailure) => {
          this.acting = false
          this.actFailed = true
          // 多半是刚付完或刚超时关闭：照实说，并刷新成现在的状态。
          this.actMessage = f.message
          this.load()
        })
    },
    confirmReceipt() {
      if (this.acting) return
      if (this.armed != 'confirm') {
        this.armed = 'confirm'
        return
      }
      this.armed = ''
      this.acting = true
      this.actMessage = ''
      confirmOrder(this.orderNo, this.confirmKey,
        (_o, _r) => {
          this.acting = false
          this.actFailed = false
          this.actMessage = '已确认收货'
          this.load()
        },
        (f: ApiFailure) => {
          this.acting = false
          this.actFailed = true
          this.actMessage = f.message
          this.load()
        })
    },
    applyRefund() {
      uni.navigateTo({ url: '/pages/refund/apply?order_no=' + encodeURIComponent(this.orderNo) })
    },
    openRefund(no: string) {
      uni.navigateTo({ url: '/pages/refund/detail?refund_no=' + encodeURIComponent(no) })
    },
    load() {
      if (this.orderNo == '') {
        this.error = '没有指定订单'
        return
      }
      getOrder(
        this.orderNo,
        (d) => {
          const v = orderDetailView(d)
          this.view = v
          this.loadedOnce = true
          this.payable = v.head.payable
          this.error = ''
          this.notImplemented = false
        },
        (f: ApiFailure) => {
          this.notImplemented = f.notImplemented
          this.error = f.message
          // 详情拿不到时也要让人能发起支付：下单成功那一刻就知道这单是待支付的。
          this.payable = true
        }
      )
    },
    pick(c: string) {
      this.channel = c
    },
    pay() {
      if (this.paying) return
      this.paying = true
      this.payFailed = false
      this.payMessage = ''
      createPayment(
        this.orderNo,
        { channel: this.channel },
        this.payKey,
        (intent, replayed) => {
          this.paying = false
          this.payMessage =
            (replayed ? '这笔支付之前已经发起过，本次没有重复发起：' : '已发起支付：') +
            intent.payment_no + ' ' + yuan(intent.amount_cents)
          const payload = sandboxPayloadOf(intent)
          if (payload == null || payload!.sandbox != true) {
            return
          }
          this.sandboxNotice = payload!.sandbox_notice != null ? payload!.sandbox_notice! : '沙箱支付'
          const envelope = payload!.settle
          if (envelope != null) {
            this.settleEnvelope = envelope
            this.canSettle = true
          } else {
            this.settleMessage = '这个渠道没有沙箱结算指令，只能等真实回调'
          }
        },
        (f: ApiFailure) => {
          this.paying = false
          this.payFailed = true
          this.payMessage = f.notImplemented
            ? '服务器还没有开放支付（' + f.status.toString() + '）'
            : f.message
        }
      )
    },
    settle() {
      const envelope = this.settleEnvelope
      if (envelope == null || this.settling) {
        return
      }
      this.settling = true
      this.settleFailed = false
      this.settleMessage = ''
      settleSandbox(
        envelope!,
        () => {
          this.settling = false
          this.canSettle = false
          this.settleMessage = '回调已入账，订单状态已刷新。'
          this.payMessage = ''
          this.load()
        },
        (f: ApiFailure) => {
          this.settling = false
          this.settleFailed = true
          this.settleMessage = f.message
        }
      )
    },
  },
}
</script>

<style>
.status {
  padding: 20px 4px 8px 4px;
}
.refund {
  margin-left: 10px;
}
.thumb {
  width: 56px;
  height: 56px;
  border-radius: 10px;
}
.thumb-glyph {
  font-size: 22px;
}
.item-info {
  margin-left: 12px;
  margin-right: 8px;
}
.item-next {
  margin-top: 14px;
}
.pay-state {
  margin-right: 10px;
}
.pay-head {
  padding: 18px 18px 6px 18px;
}
.pay-row {
  flex-direction: row;
  align-items: center;
  padding: 12px 18px;
}
.pay-icon {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}
.pay-icon-text {
  font-size: 13px;
  color: #FFFDF9;
  font-weight: bold;
}
.radio {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  border-width: 1px;
  border-style: solid;
  border-color: #D3C8BA;
  align-items: center;
  justify-content: center;
}
.radio-on {
  border-color: #3B2A20;
}
.radio-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  background-color: #3B2A20;
}
.msg {
  padding: 12px 4px 0 4px;
}
.settle {
  border-color: #B7791F;
}
.meta {
  padding: 20px 4px 0 4px;
}
.bar-btn {
  width: 160px;
}
.coupon-used {
  color: #B4462E;
}
.refund-row {
  padding: 12px 0 2px 0;
}
.actions {
  justify-content: flex-end;
  margin-top: 16px;
}
.act {
  padding: 0 18px;
  margin-left: 10px;
}
.chev {
  margin-left: 6px;
  font-size: 16px;
  color: #A89C90;
}
.freight-note {
  margin-right: 8px;
}
.promo-line {
  text-align: right;
  margin-bottom: 4px;
}
</style>
