<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <!-- 收货地址：GET /addresses 的默认地址（排第一且 is_default）。没有默认就让用户选，
             一条地址都没有就引导去新建 —— 不替用户挑一个「第一条」当默认。 -->
        <view class="card addr-card" @click="pickAddress">
          <text class="t-overline">收货地址</text>
          <view class="gap-s"></view>
          <view v-if="address != null" class="row">
            <view class="fill">
              <view class="row">
                <text class="t-section">{{ address!.name }}</text>
                <text class="t-sub addr-phone">{{ address!.phone }}</text>
              </view>
              <text class="t-hint addr-line">{{ address!.fullText }}</text>
            </view>
            <text class="chev">›</text>
          </view>
          <view v-else-if="!loggedIn" class="row">
            <text class="t-hint fill">登录后选择收货地址</text>
          </view>
          <view v-else-if="addressError != ''" class="row">
            <text class="t-err fill">{{ addressError }}</text>
          </view>
          <view v-else-if="addressLoaded" class="row">
            <text class="t-link fill">{{ addressCount == 0 ? '还没有收货地址，去新建' : '请选择收货地址' }}</text>
            <text class="chev">›</text>
          </view>
          <view v-else class="row"><text class="t-hint">正在读取地址…</text></view>
        </view>

        <!-- 商品。从购物车来是勾选的那几行（只读，改数量回购物车改）；立即购买是一行，可以调数量。 -->
        <view v-if="fromCart" class="card">
          <view v-for="(it, idx) in cartRows" :key="it.id" :class="['row', idx > 0 ? 'line-next' : '']">
            <view class="cover thumb" :style="{ backgroundColor: it.cover.color }">
              <image v-if="it.cover.imageUrl != ''" class="cover-img" :src="it.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ it.cover.glyph }}</text>
            </view>
            <view class="fill item-info">
              <text class="t-section">{{ it.title }}</text>
              <text class="t-hint">{{ it.specText }}</text>
              <text v-if="undeliverableOf(it.skuId) != ''" class="t-err undeliverable">{{ undeliverableOf(it.skuId) }}</text>
              <view class="gap-s"></view>
              <view class="between">
                <text class="t-price">{{ it.priceText }}</text>
                <text class="t-sub">× {{ it.quantity }}</text>
              </view>
            </view>
          </view>
          <text v-if="cartRows.length == 0 && cartLoaded" class="t-hint">购物车里没有勾选的商品</text>
        </view>
        <view v-else class="card">
          <view class="row">
            <view class="cover thumb" :style="{ backgroundColor: coverColor }">
              <image v-if="coverImage != ''" class="cover-img" :src="coverImage" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ coverGlyph }}</text>
            </view>
            <view class="fill item-info">
              <text class="t-section">{{ itemTitle }}</text>
              <text class="t-hint">{{ itemSpec }}</text>
              <text v-if="undeliverableOf(parseInt(skuIdText)) != ''" class="t-err undeliverable">{{ undeliverableOf(parseInt(skuIdText)) }}</text>
              <view class="gap-s"></view>
              <view class="between">
                <text class="t-price">{{ unitPrice }}</text>
                <view class="stepper row">
                  <view :class="['step', quantity <= 1 ? 'btn-off' : '']" @click="changeQty(-1)"><text class="step-text">−</text></view>
                  <text class="step-num">{{ quantity }}</text>
                  <view class="step" @click="changeQty(1)"><text class="step-text">+</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 优惠券。一单一张。第一次试算后自动选最省的那张（服务端排好序的第一张），
             之后以用户的选择为准 —— 包括「不使用」，不会被下一次试算悄悄改回去。
             用不了（409 coupon-not-applicable）时照实显示原因并展开列表让用户换，
             **不**自动退回原价：那样应付金额会在用户眼皮底下变大而他不知道为什么。 -->
        <view v-if="loggedIn && (coupons.length > 0 || couponId > 0)" class="card">
          <view class="between" @click="couponOpen = !couponOpen">
            <text class="t-overline">优惠券</text>
            <view class="row">
              <text :class="couponId > 0 ? 'coupon-on' : 't-hint'">{{ couponSummary }}</text>
              <text class="chev">{{ couponOpen ? '⌃' : '›' }}</text>
            </view>
          </view>
          <view v-if="couponOpen">
            <view v-for="c in coupons" :key="c.id" class="coupon-opt row" @click="pickCoupon(c.id)">
              <view class="fill">
                <text class="t-body">{{ c.name }}</text>
                <text class="t-hint">{{ c.ruleText }} · {{ c.validText }}</text>
              </view>
              <text class="coupon-save">{{ c.saveText }}</text>
              <view :class="['radio', c.id == couponId ? 'radio-on' : '']"></view>
            </view>
            <view class="coupon-opt row" @click="pickCoupon(0)">
              <text class="t-body fill">不使用优惠券</text>
              <view :class="['radio', couponId == 0 ? 'radio-on' : '']"></view>
            </view>
          </view>
        </view>

        <!-- 金额 -->
        <view class="card">
          <view v-if="!loggedIn" class="center">
            <text class="t-sub">登录后查看应付金额</text>
            <view class="gap-m"></view>
            <view class="btn-ghost login-btn" @click="goLogin"><text class="btn-ghost-text">去登录</text></view>
          </view>
          <view v-else-if="pv != null">
            <view class="kv"><text class="t-sub">商品金额</text><text class="t-body">{{ pv!.goodsAmountText }}</text></view>
            <!-- 运费用服务端算的 freight_cents，不自己算；说明来自 freight.groups（满额包邮、首件续件）。 -->
            <view class="kv">
              <text class="t-sub">运费</text>
              <view class="row">
                <text v-if="pv!.freightNote != ''" class="t-hint freight-note">{{ pv!.freightNote }}</text>
                <text class="t-body">{{ pv!.freightText }}</text>
              </view>
            </view>
            <view v-if="pv!.freightDiscountText != ''" class="kv"><text class="t-sub">运费抵扣</text><text class="t-body">{{ pv!.freightDiscountText }}</text></view>
            <view class="kv"><text class="t-sub">优惠</text><text class="t-body">{{ pv!.discountText }}</text></view>
            <view class="divider"></view>
            <view class="kv"><text class="t-section">应付</text><text class="t-price">{{ pv!.payableText }}</text></view>
          </view>
          <view v-else-if="previewing" class="center"><text class="t-hint">正在计算…</text></view>
          <view v-else-if="addressLoaded && addressId == 0" class="center"><text class="t-hint">选好收货地址后计算应付金额</text></view>
          <view v-else class="center">
            <text class="t-hint">金额待计算</text>
            <view class="gap-s"></view>
            <text class="t-link" @click="preview">重新计算</text>
          </view>
        </view>

        <!-- 结果 -->
        <view v-if="message != ''" :class="['card', failed ? 'result-err' : 'result-ok']">
          <text :class="failed ? 't-err' : 't-ok'">{{ message }}</text>
          <view v-if="provinceUnknown">
            <view class="gap-m"></view>
            <view class="btn-ghost fix-addr" @click="fixAddress"><text class="btn-ghost-text">去补全地址</text></view>
          </view>
          <view v-if="needNewKey">
            <view class="gap-m"></view>
            <view class="btn-ghost" @click="rotate"><text class="btn-ghost-text">作为新订单提交</text></view>
          </view>
        </view>

        <!-- 技术信息：幂等键。进这个页面时生成一次，之后每次提交都复用它。
             每次点击重新生成等于把幂等整个废掉：用户手抖点两下就是两笔订单。
             服务端对重放返回 201 + Idempotency-Replayed: true，对同键异体返回 422。
             对买家它不是主信息，收起来；但不藏掉 —— 排查「为什么没下成」时要看得到。 -->
        <view class="tech">
          <text class="t-hint" @click="showTech = !showTech">{{ showTech ? '收起技术信息' : '技术信息' }}</text>
          <view v-if="showTech" class="tech-body">
            <text class="t-hint">幂等键（重复提交不会重复下单）</text>
            <text class="t-mono">{{ idemKey }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="fill">
        <text class="t-hint">应付</text>
        <text class="t-price-l">{{ pv != null ? pv!.payableText : '—' }}</text>
      </view>
      <view v-if="orderNo != '' && !needNewKey" class="btn bar-btn" @click="openOrder">
        <text class="btn-text">查看订单</text>
      </view>
      <view v-else :class="['btn', 'bar-btn', pv == null || busy || addressId == 0 ? 'btn-off' : '']" @click="submit">
        <text class="btn-text">{{ busy ? '提交中…' : '提交订单' }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { batchDeleteCartItems, createOrder, getCart, getProduct, listAddresses, previewOrder, ApiFailure, PROBLEM_REGION_NOT_DELIVERABLE, PROBLEM_COUPON_NOT_APPLICABLE, PROBLEM_IDEMPOTENCY_KEY_IN_FLIGHT, PROBLEM_IDEMPOTENCY_KEY_REUSED } from '@/api/client.uts'
import { newIdempotencyKey } from '@/api/idempotency.uts'
import { isLoggedIn, rememberOrder, takePickedAddress } from '@/api/config.uts'
import { undeliverableLines, UndeliverableLine, addressRow, cartDeleteRequest, cartView, checkoutLines, coverOf, orderRequest, previewView, productDetailView, AddressRow, CartRow, CouponOption, OrderLine, PreviewView } from '@/api/view.uts'
import { ensureStore, CurrentStore } from '@/api/store.uts'
import { searchConverted } from '@/api/search-trace.uts'

export default {
  data() {
    return {
      skuIdText: '1',
      productId: 0,
      quantity: 1,
      // 收货地址。0 = 还没定（没有默认地址 / 一条都没有）。
      addressId: 0,
      address: null as AddressRow | null,
      addressLoaded: false,
      addressCount: 0,
      addressError: '',
      // 从购物车来（?from=cart）：结算的是车里「能买且勾选」的那几行。
      fromCart: false,
      cartRows: [] as CartRow[],
      cartLoaded: false,
      // 最近一次 422 region-not-deliverable 里送不到的行（按 skuId 标在商品上）；成功试算后清空。
      undeliverable: [] as UndeliverableLine[],
      provinceUnknown: false,
      idemKey: '',
      pv: null as PreviewView | null,
      previewing: false,
      loggedIn: false,
      message: '',
      failed: false,
      busy: false,
      needNewKey: false,
      orderNo: '',
      showTech: false,
      safeBottom: 0,
      // 商品展示信息。只用于展示；下单只认 sku_id。
      itemTitle: '',
      itemSpec: '',
      unitPrice: '',
      coverColor: '#D4B896',
      coverGlyph: '·',
      coverImage: '',
      // 由哪家门店履约。0 表示还没解析出来；不在服务范围时 outOfRange 为 true。
      // 试算成功的前提是它已经非 0，所以提交时（pv != null）可以直接用。
      storeId: 0,
      outOfRange: false,
      // 选中的券（user_coupon_id），0 = 不用券。
      couponId: 0,
      // 还没替用户选过券：第一次试算回来时自动选最省的那张，选过一次（或用户自己选了）就关掉。
      couponAuto: true,
      couponOpen: false,
      // 最近一次**成功**试算给出的可用券。单独存一份而不是只放在 pv 里：
      // 选的券用不了时 pv 是 null，这时候列表恰恰最需要还在，好让用户换一张。
      coupons: [] as CouponOption[],
    }
  },
  computed: {
    couponSummary(): string {
      if (this.couponId > 0) {
        for (let i = 0; i < this.coupons.length; i++) {
          if (this.coupons[i].id == this.couponId) return this.coupons[i].name + ' ' + this.coupons[i].saveText
        }
        return '已选 1 张'
      }
      return this.coupons.length > 0 ? this.coupons.length.toString() + ' 张可用' : '暂无可用'
    },
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    const raw = options['sku_id']
    if (raw != null) {
      this.skuIdText = '' + raw
    }
    const pid = options['product_id']
    this.productId = pid != null ? parseInt('' + pid) : 0
    this.fromCart = options['from'] == 'cart'
    this.itemTitle = '规格 #' + this.skuIdText
    // **这里，且只有这里。** 见模板里「技术信息」那段说明。
    this.idemKey = newIdempotencyKey()
    if (!this.fromCart) this.loadItem()
  },
  onShow() {
    // onShow：从登录页、地址页回来时要接着算。
    this.loggedIn = isLoggedIn()
    if (!this.loggedIn || this.orderNo != '') return
    const picked = takePickedAddress()
    if (picked > 0 && picked != this.addressId) {
      this.addressId = picked
      this.invalidate()
    }
    // 每次回来都重读地址簿：在地址页里可能新建、改了、删了。
    this.loadAddresses()
  },
  methods: {
    // 先定门店再做事。价格跟着门店所在的大区走（多门店，00020），而下单的
    // store_id 是必填 —— 服务端不替客户端猜。ensureStore 解析过就同步回调，
    // 所以 loadItem 与 preview 各调一次不会定位两次。
    withStore(then: (storeId: number) => void) {
      ensureStore(
        (s: CurrentStore) => {
          if (s.storeId == null) {
            // match_type = none：这家商家不送这里，也没配默认店。
            // pv 保持 null，提交按钮因此是灰的 —— 不需要再单独拦一次。
            this.outOfRange = true
            this.failed = true
            this.message = '当前位置暂不在配送范围内，无法下单'
            return
          }
          this.outOfRange = false
          this.storeId = s.storeId!
          then(s.storeId!)
        },
        (f: ApiFailure) => {
          this.failed = true
          this.message = f.message
        }
      )
    },
    loadItem() {
      if (this.productId <= 0) return
      this.withStore((storeId: number) => {
        this.fetchItem(storeId)
      })
    },
    fetchItem(storeId: number) {
      getProduct(
        this.productId,
        storeId,
        (d) => {
          const v = productDetailView(d)
          const skuId = parseInt(this.skuIdText)
          this.itemTitle = v.title
          const c = coverOf(v.id, v.title, v.cover.imageUrl)
          this.coverColor = c.color
          this.coverGlyph = c.glyph
          this.coverImage = c.imageUrl
          for (let i = 0; i < v.skus.length; i++) {
            if (v.skus[i].id == skuId) {
              this.itemSpec = v.skus[i].specName + '：' + v.skus[i].label
              this.unitPrice = v.skus[i].priceText
            }
          }
        },
        (_f: ApiFailure) => {
          // 展示信息拿不到不影响下单：标题留着「规格 #N」。
        }
      )
    },
    // 请求体的构造在 view.uts 的 orderRequest 里，这里一个契约字段名都不写。
    // 理由写在 view.uts「请求那一侧」那一节：.uvue 不在 tsc 闸门的视野里，
    // 而 store_id 变成必填那一次，这里写着的字面量两道检查都没拦住。
    //
    // 试算过才带 expected_payable_cents（防以旧价成交），没试算过不带。
    undeliverableOf(skuId: number): string {
      for (let i = 0; i < this.undeliverable.length; i++) {
        if (this.undeliverable[i].skuId == skuId) return this.undeliverable[i].reason
      }
      return ''
    },
    // 422 region-not-deliverable：逐行标出，并告诉用户能怎么办。省份判不了（地址不全）时引导补全地址，
    // 而不是让他去掉商品 —— 商品本身没问题。
    notDeliverable(f: ApiFailure): boolean {
      if (f.problem == null || f.problem!.type != PROBLEM_REGION_NOT_DELIVERABLE) return false
      const lines = undeliverableLines(f.problem)
      this.undeliverable = lines
      let unknown = false
      for (let i = 0; i < lines.length; i++) {
        if (lines[i].provinceUnknown) unknown = true
      }
      this.provinceUnknown = unknown
      this.failed = true
      this.message = unknown
        ? '收货地址缺少省份信息，判断不了能不能配送，请补全地址'
        : '有商品送不到这个收货地址，请换一个地址' + (this.fromCart ? '，或回购物车去掉标红的商品' : '')
      return true
    },
    fixAddress() {
      if (this.addressId > 0) uni.navigateTo({ url: '/pages/address/edit?id=' + this.addressId.toString() })
    },
    lines(): OrderLine[] {
      if (this.fromCart) return checkoutLines(this.cartRows)
      return [{ skuId: parseInt(this.skuIdText), quantity: this.quantity } as OrderLine]
    },
    body(storeId: number) {
      const coupon: number | null = this.couponId > 0 ? this.couponId : null
      if (this.pv != null) {
        return orderRequest(this.lines(), this.addressId, storeId, this.pv!.payableCents, coupon)
      }
      return orderRequest(this.lines(), this.addressId, storeId, null, coupon)
    },
    loadAddresses() {
      listAddresses(
        (list) => {
          this.addressLoaded = true
          this.addressError = ''
          this.addressCount = list.length
          let found: AddressRow | null = null
          for (let i = 0; i < list.length; i++) {
            if (list[i].id == this.addressId) found = addressRow(list[i])
          }
          // 还没选过（或选的那条被删了）：用默认地址。契约：默认地址排第一。
          // 第一条不是默认（删掉默认之后服务端不会补一个）就不替用户挑，让他选。
          if (found == null && list.length > 0 && list[0].is_default) {
            found = addressRow(list[0])
          }
          const nextId = found != null ? found!.id : 0
          this.address = found
          if (nextId != this.addressId) {
            this.addressId = nextId
            this.invalidate()
          }
          if (this.addressId > 0 && this.pv == null && !this.previewing) {
            this.preview()
          }
        },
        (f: ApiFailure) => {
          this.addressLoaded = true
          this.addressError = '读取收货地址失败：' + f.message
        }
      )
    },
    pickAddress() {
      if (!this.loggedIn) {
        this.goLogin()
        return
      }
      if (this.addressLoaded && this.addressCount == 0) {
        uni.navigateTo({ url: '/pages/address/edit' })
        return
      }
      uni.navigateTo({ url: '/pages/address/list?select=1' })
    },
    // 改了订单内容就把试算结果作废。
    //
    // 两件事：(1) expected_payable_cents 是**上一份内容**算出来的，带着它提交
    // 服务端会以 409 price-changed 打回 —— 那句话对用户是误导，价格没变，是数量变了；
    // (2) 契约里下单要用户先看见应付金额再确认，试算结果过期了就不该还摆在那儿。
    invalidate() {
      this.pv = null
      if (!this.needNewKey) {
        this.message = ''
      }
    },
    changeQty(delta: number) {
      const next = this.quantity + delta
      if (next < 1) return
      this.quantity = next
      this.invalidate()
      this.preview()
    },
    preview() {
      if (!isLoggedIn()) {
        this.loggedIn = false
        return
      }
      // 试算与下单共用一个请求体，address_id 必填：没有地址就不算，页面提示去选。
      if (this.addressId == 0) return
      this.withStore((storeId: number) => {
        if (this.fromCart && !this.cartLoaded) {
          this.loadCart(storeId)
          return
        }
        if (this.lines().length == 0) return
        this.runPreview(storeId)
      })
    },
    // 从购物车来：按**同一家门店**重读一次车，取能买且勾选的行。不从上一页带数据过来 ——
    // 车在服务端，上一页那份到这里可能已经过时（别的设备改过、库存变了）。
    loadCart(storeId: number) {
      getCart(
        storeId,
        this.addressId > 0 ? this.addressId : null,
        (c) => {
          const v = cartView(c)
          const rows: CartRow[] = []
          for (let i = 0; i < v.rows.length; i++) {
            if (v.rows[i].available && v.rows[i].selected) rows.push(v.rows[i])
          }
          this.cartRows = rows
          this.cartLoaded = true
          if (rows.length > 0) this.runPreview(storeId)
        },
        (f: ApiFailure) => {
          this.failed = true
          this.message = '读取购物车失败：' + f.message
        }
      )
    },
    runPreview(storeId: number) {
      this.previewing = true
      // 请求发出时的数量与券。连点 + 号、连着换券时，只有最后一次的结果算数。
      const qty = this.quantity
      const coupon = this.couponId
      previewOrder(
        this.body(storeId),
        (p) => {
          if (qty != this.quantity || coupon != this.couponId) return
          const v = previewView(p)
          this.coupons = v.coupons
          if (this.couponAuto) {
            this.couponAuto = false
            if (coupon == 0 && v.coupons.length > 0) {
              // 先不带券算一次拿到可用列表，再带上最省的那张算一次。
              // 中间这份不带券的结果不摆出来：应付金额闪一下大、再变小，没有意义。
              this.couponId = v.coupons[0].id
              this.runPreview(storeId)
              return
            }
          }
          this.previewing = false
          this.pv = v
          this.undeliverable = []
          this.provinceUnknown = false
        },
        (f: ApiFailure) => {
          if (qty != this.quantity || coupon != this.couponId) return
          this.previewing = false
          if (this.notDeliverable(f)) return
          this.failed = true
          // coupon-not-applicable 的 detail 就是原因（「未满 ¥50」之类），failureOf 已经把它
          // 放进 message 了。展开券列表，让用户换一张或不用 —— 由他决定，不替他退回原价。
          if (f.problem != null && f.problem!.type == PROBLEM_COUPON_NOT_APPLICABLE) {
            this.couponOpen = true
          }
          this.message = f.message
        }
      )
    },
    pickCoupon(id: number) {
      this.couponAuto = false
      this.couponOpen = false
      if (id == this.couponId && this.pv != null) return
      this.couponId = id
      this.failed = false
      this.message = ''
      this.invalidate()
      this.preview()
    },
    submit() {
      if (!isLoggedIn()) {
        this.goLogin()
        return
      }
      if (this.pv == null || this.busy || this.addressId == 0) return
      this.busy = true
      this.failed = false
      this.message = ''
      this.send(0)
    },
    // 重试用递归而不是循环：uni.request 是回调式的。attempt 只用来封顶。
    send(attempt: number) {
      createOrder(
        this.body(this.storeId),
        this.idemKey,
        (order, replayed) => {
          this.busy = false
          this.failed = false
          this.needNewKey = false
          this.orderNo = order.order_no
          // 刻意**不**自动跳走：跳走的话「这次到底是真下了单还是重放」这句话
          // 用户根本来不及看见，而那正是 Idempotency-Replayed 存在的理由。
          this.message = replayed
            ? '这笔订单之前已经提交过，本次没有重复下单。订单号 ' + order.order_no
            : '下单成功，订单号 ' + order.order_no
          rememberOrder(order.order_no)
          this.reportSearchOrders()
          this.clearOrderedCartRows()
        },
        (f: ApiFailure) => {
          const t = f.problem != null ? f.problem!.type : ''
          if (t == PROBLEM_IDEMPOTENCY_KEY_IN_FLIGHT && attempt < 3) {
            // 契约：这不是业务失败，客户端应按 Retry-After 退避重试。
            // 弹窗说「下单失败」是错的 —— 那一单很可能正在成功。
            this.message = '订单正在处理中，' + f.retryAfter.toString() + ' 秒后自动重试…'
            const wait = (f.retryAfter > 0 ? f.retryAfter : 1) * 1000
            setTimeout(() => {
              this.send(attempt + 1)
            }, wait)
            return
          }
          this.busy = false
          this.failed = true
          if (this.notDeliverable(f)) {
            // 这一单没建成；换了地址再提交是新请求，换个键免得撞「同键异体」。
            this.idemKey = newIdempotencyKey()
            this.pv = null
            return
          }
          if (t == PROBLEM_IDEMPOTENCY_KEY_REUSED) {
            // 同键异体。服务端宁可显式失败也不把不同的请求当重放吞掉 ——
            // 那会让用户以为下单成功而实际什么都没发生。这里照实说，
            // 并且把「换新键」做成一个要用户按的按钮，而不是偷偷换掉。
            this.needNewKey = true
            this.message = '订单内容和刚才提交的那笔不一样了。如果要按现在的内容再下一单，请作为新订单提交。'
            return
          }
          if (t == PROBLEM_COUPON_NOT_APPLICABLE) {
            // 试算时还能用，提交时被别的订单锁走了（或刚好过期）。这一单没建成，
            // 所以换一个幂等键不会造成重复下单；不换的话，换了券再提交就是「同键异体」422。
            // 不自动改成不用券：应付金额会变，得让用户重新看一眼再按提交。
            this.idemKey = newIdempotencyKey()
            this.pv = null
            this.couponOpen = true
            this.message = f.message + '。请换一张优惠券或选择不使用。'
            return
          }
          this.message = f.message
        }
      )
    },
    // 这一单里从搜索结果点进来过的商品，回传 order。重放命中也照发：服务端对重复上报回 204。
    reportSearchOrders() {
      if (this.fromCart) {
        for (let i = 0; i < this.cartRows.length; i++) searchConverted('order', this.cartRows[i].productId)
        return
      }
      searchConverted('order', this.productId)
    },
    // 下单成功后把这几行从购物车里删掉 —— 服务端下单**不碰**购物车（契约没这么写，
    // 服务端也确认过），不删的话买过的东西还躺在车里。
    //
    // 失败不打扰用户：订单已经成了，车里多留几行最多让他自己删，不值得在「下单成功」
    // 旁边再弹一个错。静默重试一次，用**同一个**幂等键 —— 第一次其实删成了、只是响应丢了的话，
    // 第二次是重放，而不是对已经不在车里的行再删一遍（那会 404）。
    clearOrderedCartRows() {
      if (!this.fromCart || this.cartRows.length == 0) return
      const ids: number[] = []
      for (let i = 0; i < this.cartRows.length; i++) ids.push(this.cartRows[i].id)
      const key = newIdempotencyKey()
      this.deleteCartRows(ids, key, 0)
    },
    deleteCartRows(ids: number[], key: string, attempt: number) {
      batchDeleteCartItems(cartDeleteRequest(ids), this.storeId, this.addressId > 0 ? this.addressId : null, key,
        (_c) => {},
        (_f: ApiFailure) => {
          if (attempt == 0) {
            setTimeout(() => {
              this.deleteCartRows(ids, key, 1)
            }, 1000)
          }
        })
    },
    goLogin() {
      uni.navigateTo({ url: '/pages/auth/login' })
    },
    openOrder() {
      uni.navigateTo({ url: '/pages/order/detail?order_no=' + this.orderNo })
    },
    rotate() {
      this.idemKey = newIdempotencyKey()
      this.needNewKey = false
      this.orderNo = ''
      this.failed = false
      this.message = ''
      if (this.pv == null) {
        this.preview()
      }
    },
  },
}
</script>

