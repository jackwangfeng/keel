<template>
  <view class="page">
    <view v-if="notImplemented" class="card">
      <text class="title">GET /orders 后端尚未接上</text>
      <text class="muted">
        这条接口打过去是 {{ error }}。页面是按契约写好的，接口一通就能用。
        下面列的是这台设备自己下过的单（订单号是 POST /orders 真的返回的），
        不是列表接口给的 —— 别的设备下的单在这里看不到。
      </text>
    </view>
    <text v-else-if="error != ''" class="err pad">{{ error }}</text>

    <scroll-view class="list" direction="vertical">
      <view v-for="row in rows" :key="row.orderNo" class="card" @click="open(row.orderNo)">
        <view class="row">
          <text class="title">{{ row.orderNo }}</text>
          <view class="spacer"></view>
          <text class="price">{{ row.payableText }}</text>
        </view>
        <view class="row">
          <text class="muted">{{ row.statusText }}</text>
          <text v-if="row.refundText != ''" class="muted refund">{{ row.refundText }}</text>
          <view class="spacer"></view>
          <text class="muted">{{ row.createdAt }}</text>
        </view>
      </view>
      <!-- 只有服务端那条接口没通时才拿本机记录兜底。两个都显示会让同一单出现两次，
           而且会让人以为「本机记录」是列表接口的一部分。 -->
      <view v-if="notImplemented" v-for="no in localNos" :key="no" class="card" @click="open(no)">
        <text class="title">{{ no }}</text>
        <text class="muted">本机记录</text>
      </view>
      <text v-if="rows.length == 0 && !notImplemented && error == ''" class="muted pad">还没有订单</text>
    </scroll-view>
  </view>
</template>

<script>
import { listOrders, ApiFailure } from '@/api/client.uts'
import { localOrders } from '@/api/config.uts'
import { orderRow, OrderRow } from '@/api/view.uts'

export default {
  data() {
    return {
      rows: [] as OrderRow[],
      localNos: [] as string[],
      error: '',
      notImplemented: false,
    }
  },
  onShow() {
    this.localNos = localOrders()
    this.load()
  },
  methods: {
    load() {
      this.error = ''
      this.notImplemented = false
      listOrders(
        { page: 1, page_size: 20 },
        (page) => {
          const rows: OrderRow[] = []
          for (let i = 0; i < page.items.length; i++) {
            rows.push(orderRow(page.items[i]))
          }
          this.rows = rows
        },
        (f: ApiFailure) => {
          this.notImplemented = f.notImplemented
          this.error = f.message
        }
      )
    },
    open(orderNo: string) {
      uni.navigateTo({ url: '/pages/order/detail?order_no=' + orderNo })
    },
  },
}
</script>

<style>
.title {
  font-size: 14px;
  font-weight: bold;
}
.list {
  flex: 1;
}
.spacer {
  flex: 1;
}
.refund {
  margin-left: 8px;
  color: #d4380d;
}
.pad {
  padding: 12px;
}
</style>
