<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="!loggedIn" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">☰</text></view>
          <text class="t-sub">登录后查看你的订单</text>
          <view class="gap-m"></view>
          <view class="btn cta" @click="goLogin"><text class="btn-text">登录</text></view>
        </view>

        <view v-else-if="notImplemented" class="card">
          <text class="t-section">订单列表暂时无法加载</text>
          <text class="t-sub">
            服务器还没有开放这项功能（{{ error }}）。下面是这台设备下过的订单，
            在别的设备上下的单这里看不到。
          </text>
        </view>
        <view v-else-if="error != ''" class="card">
          <text class="t-err">{{ error }}</text>
          <view class="gap-m"></view>
          <view class="btn-ghost" @click="load"><text class="btn-ghost-text">重新加载</text></view>
        </view>

        <view v-for="row in rows" :key="row.orderNo" class="card" @click="open(row.orderNo)">
          <view class="between">
            <view class="row">
              <view :class="['badge', 'badge-' + row.statusTone]">
                <text :class="['badge-text', 'badge-' + row.statusTone + '-text']">{{ row.statusText }}</text>
              </view>
              <view v-if="row.refundText != ''" class="badge badge-refund refund">
                <text class="badge-text badge-refund-text">{{ row.refundText }}</text>
              </view>
            </view>
            <text class="t-hint">{{ row.createdAt }}</text>
          </view>
          <view class="gap-m"></view>
          <view class="between">
            <view>
              <text class="t-hint">订单号</text>
              <text class="t-mono">{{ row.orderNo }}</text>
            </view>
            <text class="t-price">{{ row.payableText }}</text>
          </view>
          <view v-if="row.payable">
            <view class="divider"></view>
            <view class="between">
              <text class="t-sub">等待付款</text>
              <text class="t-link">去支付 ›</text>
            </view>
          </view>
        </view>

        <!-- 只有服务端那条接口没通时才拿本机记录兜底。两个都显示会让同一单出现两次，
             而且会让人以为「本机记录」是列表接口的一部分。 -->
        <view v-if="notImplemented" v-for="no in localNos" :key="no" class="card" @click="open(no)">
          <text class="t-mono">{{ no }}</text>
          <text class="t-hint">本机记录</text>
        </view>

        <view v-if="loggedIn && loaded && rows.length == 0 && !notImplemented && error == ''" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">☕</text></view>
          <text class="t-sub">还没有订单，去挑点好东西吧</text>
          <view class="gap-m"></view>
          <view class="btn-ghost cta" @click="goHome"><text class="btn-ghost-text">去逛逛</text></view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { listOrders, ApiFailure } from '@/api/client.uts'
import { isLoggedIn, localOrders } from '@/api/config.uts'
import { orderRow, OrderRow } from '@/api/view.uts'

export default {
  data() {
    return {
      rows: [] as OrderRow[],
      localNos: [] as string[],
      error: '',
      notImplemented: false,
      loggedIn: false,
      loaded: false,
    }
  },
  onShow() {
    this.loggedIn = isLoggedIn()
    this.localNos = localOrders()
    if (!this.loggedIn) {
      this.rows = []
      return
    }
    this.load()
  },
  methods: {
    load() {
      this.error = ''
      this.notImplemented = false
      listOrders(
        { page: 1, page_size: 20 },
        (page) => {
          const rows: OrderRow[] = []
          for (let i = 0; i < page.items.length; i++) {
            rows.push(orderRow(page.items[i]))
          }
          this.rows = rows
          this.loaded = true
        },
        (f: ApiFailure) => {
          this.notImplemented = f.notImplemented
          this.error = f.message
          this.loaded = true
        }
      )
    },
    open(orderNo: string) {
      uni.navigateTo({ url: '/pages/order/detail?order_no=' + orderNo })
    },
    goLogin() {
      uni.navigateTo({ url: '/pages/auth/login' })
    },
    goHome() {
      uni.switchTab({ url: '/pages/products/list' })
    },
  },
}
</script>

<style>
.refund {
  margin-left: 6px;
}
.cta {
  width: 160px;
}
</style>
