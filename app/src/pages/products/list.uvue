<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="head" :style="{ paddingTop: (statusBarHeight + 20) + 'px' }">
        <text class="t-overline">KEEL · 精选好物</text>
        <view class="gap-s"></view>
        <text class="t-display">{{ greeting }}</text>
        <text class="t-sub head-sub">慢一点，好好喝一杯</text>
        <!-- 「由哪家店服务你」要看得见：价格与在售范围都跟着它走（多门店，00020）。
             不显示的话，用户换个地方打开 App、同一件商品价格变了，他不会知道为什么。 -->
        <text v-if="storeLine != ''" class="t-hint store-line">{{ storeLine }}</text>

        <!-- 首页只放一个入口，真正的输入框在搜索页：首页的输入框一获得焦点就弹键盘、
             挡住商品，而搜索结果本来就要一整页来放。 -->
        <view class="search row" @click="goSearch">
          <text class="search-icon">⌕</text>
          <text class="t-hint">搜索商品</text>
        </view>
      </view>

      <!-- 分类：拉不到（包括服务端还没实现 GET /categories 的 404）就整排不显示，
           首页照常 —— 分类是浏览的捷径，不是浏览的前提。 -->
      <scroll-view v-if="categories.length > 0" class="cat-row" direction="horizontal" :show-scrollbar="false">
        <view class="cat-track row">
          <view :class="['cat-chip', categoryId == 0 ? 'cat-chip-on' : '']" @click="pickCategory(0)">
            <text :class="categoryId == 0 ? 'cat-text-on' : 'cat-text'">全部</text>
          </view>
          <view v-for="c in categories" :key="c.id" :class="['cat-chip', categoryId == c.id ? 'cat-chip-on' : '']" @click="pickCategory(c.id)">
            <text :class="categoryId == c.id ? 'cat-text-on' : 'cat-text'">{{ c.name }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="section between">
        <text class="t-section">{{ sectionTitle }}</text>
        <text v-if="total > 0" class="t-hint list-count">共 {{ total }} 件</text>
      </view>

      <view v-if="error != ''" class="body">
        <view class="card">
          <text class="t-err">{{ error }}</text>
          <view class="gap-m"></view>
          <view class="btn-ghost" @click="load"><text class="btn-ghost-text">重新加载</text></view>
        </view>
      </view>

      <view class="grid">
        <view v-for="item in rows" :key="item.id" class="cell" @click="openDetail(item.id)">
          <view class="tile">
            <view class="cover tile-cover" :style="{ backgroundColor: item.cover.color }">
              <image v-if="item.cover.imageUrl != ''" class="cover-img" :src="item.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph tile-glyph">{{ item.cover.glyph }}</text>
              <view v-if="item.offShelf || item.soldOut" class="tile-flag">
                <text class="tile-flag-text">{{ item.offShelf ? '已下架' : '暂时无货' }}</text>
              </view>
            </view>
            <view class="tile-info">
              <text class="tile-title">{{ item.title }}</text>
              <text v-if="item.subtitle != ''" class="t-hint">{{ item.subtitle }}</text>
              <view v-if="item.promoTags.length > 0" class="tag-row">
                <text v-for="(tag, ti) in item.promoTags" :key="ti" class="promo-tag">{{ tag }}</text>
              </view>
              <view class="gap-s"></view>
              <text class="t-price">{{ item.priceText }}</text>
            </view>
          </view>
        </view>
      </view>

      <view v-if="!loading && rows.length == 0 && error == ''" class="empty">
        <view class="empty-mark"><text class="empty-mark-text">☕</text></view>
        <text class="t-sub">{{ outOfRange ? '当前位置暂不在配送范围内' : '店里还没有上架商品' }}</text>
      </view>
      <view v-if="loading && rows.length == 0" class="empty">
        <text class="t-hint">正在加载…</text>
      </view>
      <view class="gap-l"></view>
    </scroll-view>
  </view>
</template>

<script>
import { listCategories, listProducts, ApiFailure } from '@/api/client.uts'
import { categoryChips, productRow, productListQuery, CategoryChip, ProductRow } from '@/api/view.uts'
import { ensureStore, CurrentStore } from '@/api/store.uts'
import { refreshUnreadBadge } from '@/api/badge.uts'

export default {
  data() {
    return {
      rows: [] as ProductRow[],
      total: 0,
      loading: false,
      error: '',
      greeting: '',
      statusBarHeight: 0,
      storeLine: '',
      outOfRange: false,
      categories: [] as CategoryChip[],
      // 0 = 全部。
      categoryId: 0,
      storeId: 0,
    }
  },
  computed: {
    sectionTitle(): string {
      for (let i = 0; i < this.categories.length; i++) {
        if (this.categories[i].id == this.categoryId) return this.categories[i].name
      }
      return '全部商品'
    },
  },
  onLoad() {
    this.statusBarHeight = uni.getWindowInfo().statusBarHeight
  },
  onShow() {
    // onShow 而不是 onLoad：从「服务地址」页改完地址切回来时要重新拉。
    const h = new Date().getHours()
    this.greeting = h < 11 ? '早上好' : (h < 18 ? '下午好' : '晚上好')
    this.load()
    // 进 App 第一个看到的是首页：在这里就把「我的」上的未读角标挂上。
    refreshUnreadBadge(null)
  },
  methods: {
    load() {
      this.loading = true
      this.error = ''
      this.loadCategories()
      // 先定门店，再拉列表：列表的价格与在售范围是按门店算的。
      // 定位被拒绝不会走到 onErr —— 那是回落默认店的正常路径（store.uts 文件头）。
      ensureStore(
        (s: CurrentStore) => {
          this.storeLine = s.storeId == null ? '' : ('由「' + s.name + '」为你配送')
          if (s.storeId == null) {
            // match_type = none：这家商家不送这里，也没配默认店。
            // 这是一个成功的结果，不是错误 —— 不显示「重新加载」。
            this.outOfRange = true
            this.rows = []
            this.total = 0
            this.loading = false
            return
          }
          this.outOfRange = false
          this.storeId = s.storeId!
          this.fetch()
        },
        (f: ApiFailure) => {
          this.error = f.message
          this.loading = false
        }
      )
    },
    loadCategories() {
      listCategories(
        (tree) => {
          const chips = categoryChips(tree)
          this.categories = chips
          // 选中的分类被停用 / 删掉了就回到「全部」，不然标题和列表对不上。
          let still = this.categoryId == 0
          for (let i = 0; i < chips.length; i++) {
            if (chips[i].id == this.categoryId) still = true
          }
          if (!still) this.categoryId = 0
        },
        (_f: ApiFailure) => {
          // 包括服务端还没实现这条路由的 404：没有分类栏，首页照常。
          this.categories = []
          this.categoryId = 0
        }
      )
    },
    pickCategory(id: number) {
      if (id == this.categoryId || this.storeId == 0) return
      this.categoryId = id
      this.loading = true
      this.fetch()
    },
    fetch() {
      // 连着点两个分类时只认最后一次：请求发出时的分类与返回时不同就丢掉结果。
      const asked = this.categoryId
      listProducts(
        productListQuery(1, 20, this.storeId, asked == 0 ? null : asked),
        (page) => {
          if (asked != this.categoryId) return
          const rows: ProductRow[] = []
          for (let i = 0; i < page.items.length; i++) {
            rows.push(productRow(page.items[i]))
          }
          this.rows = rows
          this.total = page.total
          this.loading = false
        },
        (f: ApiFailure) => {
          if (asked != this.categoryId) return
          this.error = f.message
          this.loading = false
        }
      )
    },
    goSearch() {
      uni.navigateTo({ url: '/pages/search/index' })
    },
    openDetail(id: number) {
      uni.navigateTo({ url: '/pages/products/detail?id=' + id.toString() })
    },
  },
}
</script>

<style>
.cat-row {
  margin-top: 16px;
}
.cat-track {
  padding: 0 20px;
}
.cat-chip {
  padding: 7px 16px;
  border-radius: 17px;
  border-width: 1px;
  border-style: solid;
  border-color: #E3D9CC;
  background-color: #FFFDF9;
  margin-right: 8px;
}
.cat-chip-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.cat-text {
  font-size: 13px;
  color: #2A211B;
}
.cat-text-on {
  font-size: 13px;
  color: #FFFDF9;
}
.store-line {
  margin-top: 6px;
}
.head {
  padding-left: 20px;
  padding-right: 20px;
  padding-bottom: 8px;
}
.head-sub {
  margin-top: 4px;
}
.search {
  margin-top: 20px;
  height: 44px;
  border-radius: 22px;
  background-color: #EFE7DC;
  padding: 0 18px;
}
.search-icon {
  font-size: 18px;
  color: #A89C90;
  margin-right: 8px;
}
.section {
  padding: 24px 20px 4px 20px;
}
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 10px;
}
.cell {
  width: 50%;
  padding: 6px;
}
.tile {
  background-color: #FFFDF9;
  border-radius: 16px;
  overflow: hidden;
}
.tile-cover {
  width: 100%;
  height: 156px;
}
.tile-glyph {
  font-size: 44px;
}
.tile-flag {
  position: absolute;
  left: 10px;
  top: 10px;
  padding: 2px 8px;
  border-radius: 8px;
  background-color: rgba(42, 33, 27, 0.6);
}
.tile-flag-text {
  font-size: 11px;
  color: #FFFDF9;
}
.tile-info {
  padding: 12px 12px 14px 12px;
}
.tile-title {
  font-size: 14px;
  font-weight: bold;
  color: #2A211B;
  margin-bottom: 2px;
}
</style>
