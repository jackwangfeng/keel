<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view v-if="detail != null" class="cover hero" :style="{ backgroundColor: detail!.cover.color }">
        <image v-if="detail!.cover.imageUrl != ''" class="cover-img" :src="detail!.cover.imageUrl" mode="aspectFill"></image>
        <text v-else class="cover-glyph hero-glyph">{{ detail!.cover.glyph }}</text>
      </view>

      <view v-if="detail != null" class="sheet">
        <text class="t-overline">{{ detail!.offShelf ? '已下架' : 'KEEL 精选' }}</text>
        <text class="name">{{ detail!.title }}</text>
        <text v-if="detail!.subtitle != ''" class="t-sub">{{ detail!.subtitle }}</text>
        <view class="gap-m"></view>
        <view class="row">
          <text class="t-price-l">{{ selectedPrice }}</text>
          <text v-if="selectedStock >= 0" class="t-hint stock">库存 {{ selectedStock }}</text>
        </view>

        <view class="divider"></view>

        <text class="t-section">{{ specName }}</text>
        <view class="chips">
          <view
            v-for="sku in detail!.skus"
            :key="sku.id"
            :class="['chip', sku.id == skuId ? 'chip-on' : '', sku.soldOut ? 'btn-off' : '']"
            @click="pick(sku.id, sku.soldOut)"
          >
            <text :class="sku.id == skuId ? 'chip-text-on' : 'chip-text'">{{ sku.label }}</text>
          </view>
        </view>

        <view v-if="detail!.description != ''">
          <view class="divider"></view>
          <text class="t-section">商品介绍</text>
          <view class="gap-s"></view>
          <text class="t-body">{{ detail!.description }}</text>
        </view>
      </view>

      <view class="body">
        <view v-if="loading" class="empty"><text class="t-hint">正在加载…</text></view>

        <!-- 后端还没接上这条接口时，说的是实话，不是「商品不存在」。
             把 404 一律翻译成「没有这件商品」会让人去查种子数据，而真因是路由没挂。 -->
        <view v-if="notImplemented" class="card">
          <text class="t-section">商品详情暂时无法加载</text>
          <text class="t-sub">服务器还没有开放这项功能（{{ error }}）。可以先填规格编号继续下单。</text>
          <!-- 降级形态：拿不到 SKU 列表，只能让用户自己填 sku_id。
               这很难看，但它诚实 —— 比假装有一个规格选择器好。 -->
          <view class="field">
            <text class="field-label">规格编号</text>
            <input class="field-input" type="number" v-model="skuIdText" placeholder="sku_id" />
          </view>
        </view>
        <view v-else-if="error != ''" class="card">
          <text class="t-err">{{ error }}</text>
        </view>
      </view>
    </scroll-view>

    <view class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="bar-info">
        <text v-if="hint != ''" class="t-err">{{ hint }}</text>
        <text v-else-if="added != ''" class="t-ok">{{ added }}</text>
        <text v-else class="t-hint">{{ detail != null ? '已选 ' + selectedLabel : '' }}</text>
      </view>
      <view :class="['btn-ghost', 'cart-btn', canCart && !adding ? '' : 'btn-off']" @click="addToCart">
        <text class="btn-ghost-text">{{ adding ? '加入中…' : '加入购物车' }}</text>
      </view>
      <view :class="['btn', 'bar-btn', canBuy ? '' : 'btn-off']" @click="buy">
        <text class="btn-text">立即购买</text>
      </view>
    </view>
  </view>
</template>

<script>
import { addCartItem, getProduct, ApiFailure, PROBLEM_CART_QUANTITY_EXCEEDED, PROBLEM_INSUFFICIENT_STOCK, PROBLEM_SKU_NOT_SOLD_IN_STORE } from '@/api/client.uts'
import { isLoggedIn } from '@/api/config.uts'
import { newIdempotencyKey } from '@/api/idempotency.uts'
import { ensureStore, CurrentStore } from '@/api/store.uts'
import { addCartRequest, productDetailView, ProductDetailView } from '@/api/view.uts'
import { searchConverted } from '@/api/search-trace.uts'

export default {
  data() {
    return {
      productId: 0,
      detail: null as ProductDetailView | null,
      skuId: 0,
      skuIdText: '',
      loading: false,
      error: '',
      hint: '',
      notImplemented: false,
      safeBottom: 0,
      // 加购用的门店：与列表、结算同一家（store.uts）。0 = 还没解析 / 不在服务范围。
      storeId: 0,
      adding: false,
      added: '',
    }
  },
  computed: {
    specName(): string {
      const d = this.detail
      if (d == null || d.skus.length == 0) return '规格'
      return d.skus[0].specName
    },
    selectedPrice(): string {
      const d = this.detail
      if (d == null) return ''
      for (let i = 0; i < d.skus.length; i++) {
        if (d.skus[i].id == this.skuId) return d.skus[i].priceText
      }
      return d.priceText
    },
    selectedLabel(): string {
      const d = this.detail
      if (d == null) return ''
      for (let i = 0; i < d.skus.length; i++) {
        if (d.skus[i].id == this.skuId) return d.skus[i].label
      }
      return '—'
    },
    selectedStock(): number {
      const d = this.detail
      if (d == null) return -1
      for (let i = 0; i < d.skus.length; i++) {
        if (d.skus[i].id == this.skuId) return d.skus[i].availableQty
      }
      return -1
    },
    canCart(): boolean {
      const d = this.detail
      return d != null && !d.offShelf && this.skuId > 0 && this.storeId > 0
    },
    canBuy(): boolean {
      if (this.notImplemented) return this.skuIdText != ''
      const d = this.detail
      return d != null && !d.offShelf && this.skuId > 0
    },
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    const raw = options['id']
    this.productId = raw != null ? parseInt('' + raw) : 0
    this.load()
  },
  methods: {
    load() {
      if (this.productId <= 0) {
        this.error = '没有指定商品'
        return
      }
      this.loading = true
      // 详情页的 SKU 价格要和列表上那个价格区间、和结算扣的钱是同一家店算的。
      // 从列表点进来时门店已经解析过，这里是同步回调；从分享链接直接打开时
      // 这里才会真的去定位一次。
      ensureStore(
        (s: CurrentStore) => {
          this.storeId = s.storeId != null ? s.storeId! : 0
          this.fetch(s.storeId)
        },
        (f: ApiFailure) => {
          this.loading = false
          this.error = f.message
        }
      )
    },
    fetch(storeId: number | null) {
      getProduct(
        this.productId,
        storeId,
        (d) => {
          const view = productDetailView(d)
          this.detail = view
          // 默认选第一个有货的规格。
          for (let i = 0; i < view.skus.length; i++) {
            if (!view.skus[i].soldOut) {
              this.skuId = view.skus[i].id
              break
            }
          }
          this.loading = false
        },
        (f: ApiFailure) => {
          this.loading = false
          this.notImplemented = f.notImplemented
          this.error = f.message
        }
      )
    },
    pick(id: number, soldOut: boolean) {
      if (soldOut) {
        this.hint = '这个规格暂时无货'
        return
      }
      this.hint = ''
      this.added = ''
      this.skuId = id
    },
    addToCart() {
      if (!isLoggedIn()) {
        uni.navigateTo({ url: '/pages/auth/login' })
        return
      }
      if (!this.canCart || this.adding) return
      this.adding = true
      this.hint = ''
      this.added = ''
      // 每次点击一个新的幂等键：同一个 sku 再点一次**就是**想再加一件（服务端累加），
      // 不能当重放吞掉。手抖连点由 adding 挡住 —— 请求在飞时第二下不发。
      addCartItem(addCartRequest(this.skuId, 1), this.storeId, newIdempotencyKey(),
        (c) => {
          this.adding = false
          this.added = '已加入购物车（共 ' + c.items.length.toString() + ' 种）'
          // 从搜索结果点进来的商品：回传 add_cart（不是就什么都不做）。
          searchConverted('add_cart', this.productId)
        },
        (f: ApiFailure) => {
          this.adding = false
          const t = f.problem != null ? f.problem!.type : ''
          if (t == PROBLEM_SKU_NOT_SOLD_IN_STORE) this.hint = '当前门店不卖这个规格'
          else if (t == PROBLEM_CART_QUANTITY_EXCEEDED) this.hint = '购物车里这个规格已经到上限了（' + f.message + '）'
          else if (t == PROBLEM_INSUFFICIENT_STOCK) this.hint = '库存不够了'
          else this.hint = f.message
        })
    },
    buy() {
      let sku = this.skuId
      if (sku <= 0 && this.skuIdText != '') {
        sku = parseInt(this.skuIdText)
      }
      if (isNaN(sku) || sku <= 0) {
        this.hint = '请先选择规格'
        return
      }
      const d = this.detail
      if (d != null && d.offShelf) {
        this.hint = '这件商品已下架'
        return
      }
      this.hint = ''
      uni.navigateTo({
        url: '/pages/order/create?sku_id=' + sku.toString() + '&product_id=' + this.productId.toString(),
      })
    },
  },
}
</script>

<style>
.hero {
  width: 100%;
  height: 340px;
}
.hero-glyph {
  font-size: 96px;
}
.sheet {
  margin-top: -24px;
  border-top-left-radius: 24px;
  border-top-right-radius: 24px;
  background-color: #FFFDF9;
  padding: 24px 20px 28px 20px;
}
.name {
  font-size: 22px;
  font-weight: bold;
  color: #2A211B;
  margin-top: 8px;
  margin-bottom: 4px;
}
.stock {
  margin-left: 12px;
}
.chips {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.chip {
  padding: 8px 18px;
  border-radius: 18px;
  border-width: 1px;
  border-style: solid;
  border-color: #E3D9CC;
  background-color: #FFFDF9;
  margin-right: 10px;
  margin-bottom: 10px;
}
.chip-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.chip-text {
  font-size: 14px;
  color: #2A211B;
}
.chip-text-on {
  font-size: 14px;
  color: #FFFDF9;
}
.bar-info {
  flex: 1;
  padding-right: 12px;
}
.bar-btn {
  width: 120px;
}
.cart-btn {
  width: 120px;
  height: 48px;
  margin-right: 10px;
}
</style>
