<template>
  <view class="page">
    <view class="tabs row">
      <view v-for="(label, i) in tabLabels" :key="i" :class="['tab', i == tab ? 'tab-on' : '']" @click="pickTab(i)">
        <text :class="i == tab ? 'tab-text-on' : 'tab-text'">{{ label }}</text>
      </view>
    </view>
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="!loggedIn" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">券</text></view>
          <text class="t-sub">登录后查看你的优惠券</text>
          <view class="gap-m"></view>
          <view class="btn cta" @click="goLogin"><text class="btn-text">登录</text></view>
        </view>

        <view v-if="error != ''" class="card">
          <text class="t-err">{{ error }}</text>
          <view class="gap-m"></view>
          <view class="btn-ghost" @click="load"><text class="btn-ghost-text">重新加载</text></view>
        </view>

        <!-- 「使用中」= 锁在一笔还没付款的订单上；订单取消或超时关闭后回到「未使用」。 -->
        <text v-if="tab == 1 && rows.length > 0" class="t-hint tab-note">这些券已用在待支付的订单上，订单取消后会退回</text>

        <view v-for="r in rows" :key="r.id" :class="['ticket', tab >= 2 ? 'ticket-off' : '']">
          <view class="ticket-value"><text class="ticket-value-text">{{ r.valueText }}</text></view>
          <view class="ticket-body">
            <text class="ticket-name">{{ r.name }}</text>
            <text class="t-sub">{{ r.ruleText }}</text>
            <text class="t-hint">{{ r.scopeText }}</text>
            <text class="t-hint">{{ r.validText }}</text>
          </view>
        </view>

        <view v-if="loggedIn && loaded && rows.length == 0 && error == ''" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">券</text></view>
          <text class="t-sub">{{ emptyText }}</text>
          <view v-if="tab == 0">
            <view class="gap-m"></view>
            <view class="btn-ghost cta" @click="goCenter"><text class="btn-ghost-text">去领券</text></view>
          </view>
        </view>
        <view v-if="loggedIn && (rows.length > 0 || tab != 0)" class="foot">
          <text class="t-link" @click="goCenter">领券中心 ›</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { listCoupons, ApiFailure } from '@/api/client.uts'
import { isLoggedIn } from '@/api/config.uts'
import { couponListQuery, couponRow, CouponRow } from '@/api/view.uts'

// 与 GET /coupons 的 status 参数一一对应。
const TAB_STATUS = ['available', 'locked', 'used', 'expired']

export default {
  data() {
    return {
      tabLabels: ['未使用', '使用中', '已使用', '已过期'],
      tab: 0,
      rows: [] as CouponRow[],
      total: 0,
      loggedIn: false,
      loaded: false,
      error: '',
    }
  },
  computed: {
    emptyText(): string {
      if (this.tab == 0) return '没有可用的券'
      if (this.tab == 1) return '没有待支付订单占用的券'
      if (this.tab == 2) return '还没有用过券'
      return '没有过期的券'
    },
  },
  onShow() {
    // onShow：下单 / 取消订单 / 领券之后回来，券的状态都可能变了。
    this.loggedIn = isLoggedIn()
    if (this.loggedIn) this.load()
  },
  methods: {
    pickTab(i: number) {
      if (i == this.tab) return
      this.tab = i
      this.rows = []
      this.loaded = false
      this.load()
    },
    load() {
      this.error = ''
      // 连着切两个 tab 时只认最后一次。
      const asked = this.tab
      listCoupons(
        couponListQuery(TAB_STATUS[asked], 1, 50),
        (page) => {
          if (asked != this.tab) return
          const rows: CouponRow[] = []
          for (let i = 0; i < page.items.length; i++) {
            rows.push(couponRow(page.items[i]))
          }
          this.rows = rows
          this.total = page.total
          this.loaded = true
        },
        (f: ApiFailure) => {
          if (asked != this.tab) return
          this.error = f.message
          this.loaded = true
        }
      )
    },
    goLogin() {
      uni.navigateTo({ url: '/pages/auth/login' })
    },
    goCenter() {
      uni.navigateTo({ url: '/pages/coupon/center' })
    },
  },
}
</script>

<style>
.tabs {
  background-color: #FFFDF9;
  padding: 0 8px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ECE4DA;
}
.tab {
  flex: 1;
  align-items: center;
  padding: 12px 0 10px 0;
  border-bottom-width: 2px;
  border-bottom-style: solid;
  border-bottom-color: #FFFDF9;
}
.tab-on {
  border-bottom-color: #3B2A20;
}
.tab-text {
  font-size: 14px;
  color: #7A6E64;
}
.tab-text-on {
  font-size: 14px;
  font-weight: bold;
  color: #2A211B;
}
.tab-note {
  margin-top: 12px;
}
.cta {
  width: 160px;
}
.foot {
  padding: 24px 0;
  align-items: center;
}
</style>
