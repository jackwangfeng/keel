<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="wrap">
        <view class="logo"><text class="logo-text">K</text></view>
        <text class="t-display">欢迎回来</text>
        <text class="t-sub hello">登录后即可下单、查看订单</text>

        <!-- 契约里 code（短信验证码）与 password 二选一。后端这一版只有口令这条通了，
             所以这里只放口令。 -->
        <view class="form">
          <view class="field">
            <text class="field-label">手机号</text>
            <input class="field-input" type="number" v-model="phone" placeholder="请输入手机号" />
          </view>
          <view class="field">
            <text class="field-label">密码</text>
            <input class="field-input" type="password" v-model="password" placeholder="请输入密码" />
          </view>
        </view>

        <view :class="['btn', busy ? 'btn-off' : '']" @click="submit">
          <text class="btn-text">{{ busy ? '登录中…' : '登录' }}</text>
        </view>
        <text v-if="message != ''" :class="failed ? 't-err msg' : 't-ok msg'">{{ message }}</text>

        <view v-if="loggedIn" class="logout">
          <text class="t-link" @click="doLogout">退出当前账号</text>
        </view>
      </view>
    </scroll-view>

    <!-- 令牌是按「这个服务地址」存的：换了服务地址（= 换了一家店），本地令牌当场作废。
         服务端刻意让 A 店签发的令牌在 B 店被拒。这里把当前是哪家店低调地写出来。 -->
    <view v-if="baseUrl.indexOf('://') > 0" class="foot" :style="{ paddingBottom: (16 + safeBottom) + 'px' }">
      <text class="t-hint">当前店铺 {{ baseUrl }}</text>
    </view>
  </view>
</template>

<script>
import { login, logout, ApiFailure } from '@/api/client.uts'
import { clearSession, getBaseUrl, isLoggedIn, saveSession, Session } from '@/api/config.uts'

export default {
  data() {
    return {
      phone: '13800000000',
      password: 'keel-demo-2026',
      message: '',
      failed: false,
      busy: false,
      loggedIn: false,
      baseUrl: '',
      safeBottom: 0,
    }
  },
  onLoad() {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
  },
  onShow() {
    this.baseUrl = getBaseUrl()
    this.loggedIn = isLoggedIn()
  },
  methods: {
    submit() {
      if (this.busy) return
      this.busy = true
      this.message = ''
      login(
        { phone: this.phone, password: this.password },
        (res) => {
          const user = res.user
          const session: Session = {
            baseUrl: getBaseUrl(),
            accessToken: res.access_token,
            refreshToken: res.refresh_token != null ? res.refresh_token! : '',
            nickname: user.nickname != null ? user.nickname! : '',
          }
          saveSession(session)
          this.busy = false
          this.loggedIn = true
          this.failed = false
          this.message = '登录成功，' + (session.nickname != '' ? session.nickname : this.phone)
          // 从下单页、订单页跳过来的，登录完回去接着做；那些页面在 onShow 里会重新判断登录态。
          if (getCurrentPages().length > 1) {
            setTimeout(() => {
              uni.navigateBack({})
            }, 600)
          }
        },
        (f: ApiFailure) => {
          this.busy = false
          this.failed = true
          this.message = f.message
        }
      )
    },
    doLogout() {
      logout(
        () => {
          clearSession()
          this.loggedIn = false
          this.failed = false
          this.message = '已退出'
        },
        (f: ApiFailure) => {
          // 服务端那边吊销失败也要把本地清掉：留着一串已知不可用的令牌
          // 只会让下一次请求变成一个莫名其妙的 401。
          clearSession()
          this.loggedIn = false
          this.failed = true
          this.message = '已在本机退出（服务端吊销失败：' + f.message + '）'
        }
      )
    },
  },
}
</script>

<style>
.wrap {
  padding: 32px 28px 24px 28px;
}
.logo {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  background-color: #3B2A20;
  align-items: center;
  justify-content: center;
  margin-bottom: 28px;
}
.logo-text {
  font-size: 26px;
  font-weight: bold;
  color: #F6F1EA;
}
.hello {
  margin-top: 6px;
}
.form {
  margin-top: 36px;
  margin-bottom: 36px;
}
.msg {
  margin-top: 14px;
  text-align: center;
}
.logout {
  margin-top: 24px;
  align-items: center;
}
.foot {
  align-items: center;
  padding-top: 12px;
}
</style>
