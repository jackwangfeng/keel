<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="error != ''" class="card">
          <text class="t-err">{{ error }}</text>
          <view class="gap-m"></view>
          <view class="btn-ghost" @click="load"><text class="btn-ghost-text">重新加载</text></view>
        </view>
        <view v-if="message != ''" class="card">
          <text :class="failed ? 't-err' : 't-ok'">{{ message }}</text>
        </view>

        <!-- 删掉默认地址后服务端**不会**自动补一个默认。这时照实说，而不是在前端替用户挑一条。 -->
        <text v-if="rows.length > 0 && !rows[0].isDefault" class="t-hint no-default">还没有默认地址，下单时要手动选择</text>

        <view v-for="r in rows" :key="r.id" class="card addr" @click="onRow(r.id)">
          <view class="row">
            <text class="t-section">{{ r.name }}</text>
            <text class="t-sub addr-phone">{{ r.phone }}</text>
            <view v-if="r.isDefault" class="badge badge-ok addr-badge"><text class="badge-text badge-ok-text">默认</text></view>
            <view v-if="r.tagText != ''" class="badge badge-muted addr-badge"><text class="badge-text badge-muted-text">{{ r.tagText }}</text></view>
          </view>
          <text class="t-hint addr-line">{{ r.fullText }}</text>
          <view class="divider"></view>
          <view class="between">
            <text v-if="!r.isDefault" class="t-link addr-default" @click.stop="makeDefault(r.id)">设为默认</text>
            <text v-else class="t-hint">默认地址</text>
            <view class="row">
              <text class="t-link addr-op" @click.stop="edit(r.id)">编辑</text>
              <text class="t-link addr-op addr-del" @click.stop="remove(r.id)">删除</text>
            </view>
          </view>
        </view>

        <view v-if="loaded && rows.length == 0 && error == ''" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">⌂</text></view>
          <text class="t-sub">还没有收货地址</text>
        </view>
        <view class="gap-l"></view>
      </view>
    </scroll-view>
    <view class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="btn fill add-btn" @click="create"><text class="btn-text">新建收货地址</text></view>
    </view>
  </view>
</template>

<script>
import { deleteAddress, listAddresses, setDefaultAddress, ApiFailure } from '@/api/client.uts'
import { setPickedAddress } from '@/api/config.uts'
import { addressRow, AddressRow } from '@/api/view.uts'

export default {
  data() {
    return {
      rows: [] as AddressRow[],
      loaded: false,
      error: '',
      message: '',
      failed: false,
      // 从结算页进来（?select=1）：点一条就是选它，回结算页。
      selectMode: false,
      safeBottom: 0,
    }
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    this.selectMode = options['select'] == '1'
    if (this.selectMode) uni.setNavigationBarTitle({ title: '选择收货地址' })
  },
  onShow() {
    this.load()
  },
  methods: {
    load() {
      this.error = ''
      listAddresses(
        (list) => {
          const rows: AddressRow[] = []
          for (let i = 0; i < list.length; i++) rows.push(addressRow(list[i]))
          this.rows = rows
          this.loaded = true
        },
        (f: ApiFailure) => {
          this.error = f.message
          this.loaded = true
        }
      )
    },
    onRow(id: number) {
      if (this.selectMode) {
        setPickedAddress(id)
        uni.navigateBack({})
        return
      }
      this.edit(id)
    },
    edit(id: number) {
      uni.navigateTo({ url: '/pages/address/edit?id=' + id.toString() })
    },
    create() {
      uni.navigateTo({ url: '/pages/address/edit' })
    },
    makeDefault(id: number) {
      setDefaultAddress(
        id,
        (_a, _r) => {
          this.failed = false
          this.message = '已设为默认地址'
          this.load()
        },
        (f: ApiFailure) => {
          this.failed = true
          this.message = f.message
        }
      )
    },
    remove(id: number) {
      uni.showModal({
        title: '删除这条地址？',
        content: '已下的订单不受影响（订单里存的是收货信息的快照）。',
        success: (res) => {
          if (!res.confirm) return
          deleteAddress(
            id,
            () => {
              this.failed = false
              this.message = '已删除'
              this.load()
            },
            (f: ApiFailure) => {
              this.failed = true
              this.message = f.message
            }
          )
        },
      })
    },
  },
}
</script>

<style>
.no-default {
  margin-top: 12px;
}
.addr-phone {
  margin-left: 10px;
}
.addr-badge {
  margin-left: 8px;
}
.addr-line {
  margin-top: 6px;
}
.addr-op {
  margin-left: 20px;
}
.addr-del {
  color: #B4462E;
}
.add-btn {
  flex: 1;
}
</style>
