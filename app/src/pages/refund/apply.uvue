<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="error != ''" class="card"><text class="t-err">{{ error }}</text></view>

        <!-- 选哪几件、各退几件。可退件数 = 购买 − 已退 − 在途，服务端给的两个字段算出来。
             **没有金额输入**：每行实退多少由服务端按优惠分摊算，提交后在售后单里看。 -->
        <view v-if="items.length > 0" class="card">
          <text class="t-overline">退哪几件</text>
          <view v-for="(it, idx) in items" :key="it.orderItemId" class="line row">
            <view :class="['check', 'item-check', qty[idx] > 0 ? 'check-on' : '']" @click="toggleItem(idx)">
              <text v-if="qty[idx] > 0" class="check-mark">✓</text>
            </view>
            <view class="cover thumb" :style="{ backgroundColor: it.cover.color }">
              <image v-if="it.cover.imageUrl != ''" class="cover-img" :src="it.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ it.cover.glyph }}</text>
            </view>
            <view class="fill item-info">
              <text class="t-body">{{ it.title }}</text>
              <text class="t-hint">{{ it.specText != '' ? it.specText + ' · ' : '' }}{{ it.priceText }} · 可退 {{ it.maxQty }} 件</text>
              <view v-if="qty[idx] > 0" class="stepper row qty-row">
                <view :class="['step', qty[idx] <= 1 ? 'btn-off' : '']" @click="changeQty(idx, -1)"><text class="step-text">−</text></view>
                <text class="step-num">{{ qty[idx] }}</text>
                <view :class="['step', qty[idx] >= it.maxQty ? 'btn-off' : '']" @click="changeQty(idx, 1)"><text class="step-text">+</text></view>
              </view>
            </view>
          </view>
        </view>
        <view v-if="loaded && items.length == 0 && error == ''" class="card">
          <text class="t-sub">这一单没有可以申请售后的商品了（都已退完或正在售后中）</text>
        </view>

        <!-- 售后类型必须由用户选：已发货没收到货时两种都合法，只有他知道。不给默认值。 -->
        <view v-if="items.length > 0" class="card">
          <text class="t-overline">售后类型</text>
          <view class="row opts">
            <view v-for="t in types" :key="t.value" :class="['opt', 'type-opt', refundType == t.value ? 'opt-on' : '']" @click="refundType = t.value">
              <text :class="refundType == t.value ? 'opt-text-on' : 'opt-text'">{{ t.label }}</text>
            </view>
          </view>
          <text v-if="refundType == 2" class="t-hint type-note">审核通过后需要把商品寄回商家</text>
        </view>

        <view v-if="items.length > 0" class="card">
          <text class="t-overline">原因</text>
          <view class="row opts wrap">
            <view v-for="r in reasons" :key="r.value" :class="['opt', 'reason-opt', reasonCode == r.value ? 'opt-on' : '']" @click="reasonCode = r.value">
              <text :class="reasonCode == r.value ? 'opt-text-on' : 'opt-text'">{{ r.label }}</text>
            </view>
          </view>
          <view class="field">
            <input class="field-input f-reason" v-model="reasonText" maxlength="200" :placeholder="reasonCode == 5 ? '请说明原因（必填）' : '补充说明（选填）'" />
          </view>
        </view>

        <view v-if="message != ''" class="card result-err"><text class="t-err">{{ message }}</text></view>
      </view>
    </scroll-view>
    <view v-if="items.length > 0" class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="fill"><text class="t-hint">退款金额以审核结果为准</text></view>
      <view :class="['btn', 'bar-btn', 'submit-btn', canSubmit && !busy ? '' : 'btn-off']" @click="submit">
        <text class="btn-text">{{ busy ? '提交中…' : '提交申请' }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createRefund, getOrder, ApiFailure } from '@/api/client.uts'
import { newIdempotencyKey } from '@/api/idempotency.uts'
import { refundableItems, refundReasonText, refundRequest, RefundableItem, RefundLine } from '@/api/view.uts'

type Opt = {
  value : number
  label : string
}

export default {
  data() {
    return {
      orderNo: '',
      items: [] as RefundableItem[],
      // qty[i] 对应 items[i]：0 = 这一行不退。
      qty: [] as number[],
      types: [
        { value: 1, label: '仅退款' },
        { value: 2, label: '退货退款' },
      ] as Opt[],
      reasons: [] as Opt[],
      // 0 = 还没选。
      refundType: 0,
      reasonCode: 0,
      reasonText: '',
      loaded: false,
      error: '',
      message: '',
      busy: false,
      // 这张申请表单的幂等键：超时后再点「提交」是重放，不会开出两张售后单。
      // 改了内容再提交是「同键异体」422 —— 那时换一个键。
      idemKey: '',
      safeBottom: 0,
    }
  },
  computed: {
    canSubmit(): boolean {
      let any = false
      for (let i = 0; i < this.qty.length; i++) {
        if (this.qty[i] > 0) any = true
      }
      if (!any || this.refundType == 0 || this.reasonCode == 0) return false
      if (this.reasonCode == 5 && this.reasonText.trim() == '') return false
      return true
    },
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    const raw = options['order_no']
    this.orderNo = raw != null ? (decodeURIComponent('' + raw) ?? '') : ''
    this.idemKey = newIdempotencyKey()
    const rs: Opt[] = []
    for (let c = 1; c <= 5; c++) rs.push({ value: c, label: refundReasonText(c) } as Opt)
    this.reasons = rs
    this.load()
  },
  methods: {
    load() {
      getOrder(this.orderNo,
        (d) => {
          const items = refundableItems(d)
          this.items = items
          const q: number[] = []
          // 只有一行时默认勾上全部可退件数；多行时让用户自己勾。
          for (let i = 0; i < items.length; i++) q.push(items.length == 1 ? items[i].maxQty : 0)
          this.qty = q
          this.loaded = true
        },
        (f: ApiFailure) => {
          this.error = f.message
          this.loaded = true
        })
    },
    toggleItem(idx: number) {
      const q = this.qty.slice()
      q[idx] = q[idx] > 0 ? 0 : this.items[idx].maxQty
      this.qty = q
    },
    changeQty(idx: number, delta: number) {
      const next = this.qty[idx] + delta
      if (next < 1 || next > this.items[idx].maxQty) return
      const q = this.qty.slice()
      q[idx] = next
      this.qty = q
    },
    submit() {
      if (!this.canSubmit || this.busy) return
      const lines: RefundLine[] = []
      for (let i = 0; i < this.items.length; i++) {
        if (this.qty[i] > 0) lines.push({ orderItemId: this.items[i].orderItemId, quantity: this.qty[i] } as RefundLine)
      }
      this.busy = true
      this.message = ''
      createRefund(refundRequest(lines, this.refundType, this.reasonCode, this.reasonText.trim()), this.orderNo, this.idemKey,
        (r, _replayed) => {
          this.busy = false
          // redirectTo 而不是 navigateTo：返回键回到订单详情，不回到这张已经交掉的表单。
          uni.redirectTo({ url: '/pages/refund/detail?refund_no=' + encodeURIComponent(r.refund_no) })
        },
        (f: ApiFailure) => {
          this.busy = false
          // 409（件数超了 / 这一行已有在途售后 / 订单状态不能退）：可退件数变了，重读一次。
          this.message = f.message
          if (f.status == 409) this.load()
          if (f.status == 409 || f.status == 422) this.idemKey = newIdempotencyKey()
        })
    },
  },
}
</script>

<style>
.line {
  margin-top: 14px;
}
.check {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  border-width: 1px;
  border-style: solid;
  border-color: #CFC3B5;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}
.check-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.check-mark {
  font-size: 13px;
  color: #FFFDF9;
}
.thumb {
  width: 60px;
  height: 60px;
  border-radius: 10px;
}
.thumb-glyph {
  font-size: 24px;
}
.item-info {
  margin-left: 12px;
}
.qty-row {
  margin-top: 8px;
  align-self: flex-start;
}
.stepper {
  border-radius: 16px;
  background-color: #F3ECE3;
}
.step {
  width: 30px;
  height: 30px;
  align-items: center;
  justify-content: center;
}
.step-text {
  font-size: 18px;
  color: #3B2A20;
}
.step-num {
  min-width: 24px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  color: #2A211B;
}
.opts {
  margin-top: 12px;
}
.wrap {
  flex-wrap: wrap;
}
.opt {
  padding: 8px 16px;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  border-color: #E3D9CC;
  margin-right: 10px;
  margin-bottom: 10px;
}
.opt-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.opt-text {
  font-size: 14px;
  color: #2A211B;
}
.opt-text-on {
  font-size: 14px;
  color: #FFFDF9;
}
.type-note {
  margin-top: 2px;
}
.result-err {
  background-color: #F8EAE5;
}
.bar-btn {
  width: 140px;
}
</style>
