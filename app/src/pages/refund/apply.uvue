<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="error != ''" class="card"><text class="t-err">{{ error }}</text></view>

        <!-- 选哪几件、各退几件。可退件数 = 购买 − 已退 − 在途，服务端给的两个字段算出来。
             **没有金额输入**：每行实退多少由服务端按优惠分摊算，提交后在售后单里看。 -->
        <view v-if="items.length > 0" class="card">
          <text class="t-overline">退哪几件</text>
          <view v-for="(it, idx) in items" :key="it.orderItemId" class="line row">
            <view :class="['check', 'item-check', qty[idx] > 0 ? 'check-on' : '']" @click="toggleItem(idx)">
              <text v-if="qty[idx] > 0" class="check-mark">✓</text>
            </view>
            <view class="cover thumb" :style="{ backgroundColor: it.cover.color }">
              <image v-if="it.cover.imageUrl != ''" class="cover-img" :src="it.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ it.cover.glyph }}</text>
            </view>
            <view class="fill item-info">
              <text class="t-body">{{ it.title }}</text>
              <text class="t-hint">{{ it.specText != '' ? it.specText + ' · ' : '' }}{{ it.priceText }} · 可退 {{ it.maxQty }} 件</text>
              <view v-if="qty[idx] > 0" class="stepper row qty-row">
                <view :class="['step', qty[idx] <= 1 ? 'btn-off' : '']" @click="changeQty(idx, -1)"><text class="step-text">−</text></view>
                <text class="step-num">{{ qty[idx] }}</text>
                <view :class="['step', qty[idx] >= it.maxQty ? 'btn-off' : '']" @click="changeQty(idx, 1)"><text class="step-text">+</text></view>
              </view>
            </view>
          </view>
        </view>
        <view v-if="loaded && items.length == 0 && error == ''" class="card">
          <text class="t-sub">这一单没有可以申请售后的商品了（都已退完或正在售后中）</text>
        </view>

        <!-- 售后类型必须由用户选：已发货没收到货时两种都合法，只有他知道。不给默认值。 -->
        <view v-if="items.length > 0" class="card">
          <text class="t-overline">售后类型</text>
          <view class="row opts">
            <view v-for="t in types" :key="t.value" :class="['opt', 'type-opt', refundType == t.value ? 'opt-on' : '', t.value == 2 && !returnAllowed ? 'btn-off' : '']" @click="pickType(t.value)">
              <text :class="refundType == t.value ? 'opt-text-on' : 'opt-text'">{{ t.label }}</text>
            </view>
          </view>
          <!-- 未发货的单服务端只收仅退款：没有货可退。选项留着、置灰并写原因，而不是悄悄藏掉。 -->
          <text v-if="!returnAllowed" class="t-hint type-note">订单还没发货，只能申请仅退款</text>
          <text v-else-if="refundType == 2" class="t-hint type-note">审核通过后需要把商品寄回商家，并在售后详情里填写物流单号</text>
        </view>

        <view v-if="items.length > 0" class="card">
          <text class="t-overline">原因</text>
          <view class="row opts wrap">
            <view v-for="r in reasons" :key="r.value" :class="['opt', 'reason-opt', reasonCode == r.value ? 'opt-on' : '']" @click="reasonCode = r.value">
              <text :class="reasonCode == r.value ? 'opt-text-on' : 'opt-text'">{{ r.label }}</text>
            </view>
          </view>
          <view class="field">
            <input class="field-input f-reason" v-model="reasonText" maxlength="200" :placeholder="reasonCode == 5 ? '请说明原因（必填）' : '补充说明（选填）'" />
          </view>
        </view>

        <!-- 凭证图：选图后立刻逐张上传（POST /uploads，purpose=3），拿到的 url 原样放进 evidence_urls。
             显示的是本地临时文件，不用再去服务端读一遍。 -->
        <view v-if="items.length > 0" class="card">
          <view class="between">
            <text class="t-overline">凭证图片（选填，最多 9 张）</text>
            <text class="t-hint">{{ evidence.length }}/9</text>
          </view>
          <view class="row wrap ev-grid">
            <view v-for="(e, idx) in evidence" :key="e.key" class="ev-cell">
              <image class="ev-img" :src="e.path" mode="aspectFill"></image>
              <view v-if="e.state == 'uploading'" class="ev-mask"><text class="ev-mask-text">上传中</text></view>
              <view v-else-if="e.state == 'failed'" class="ev-mask" @click="retryUpload(idx)"><text class="ev-mask-text">失败，点重试</text></view>
              <view class="ev-del" @click="removeEvidence(idx)"><text class="ev-del-text">×</text></view>
            </view>
            <view v-if="evidence.length < 9" class="ev-cell ev-add evidence-add" @click="pickImages"><text class="ev-add-text">＋</text></view>
          </view>
        </view>

        <view v-if="message != ''" class="card result-err"><text class="t-err">{{ message }}</text></view>
      </view>
    </scroll-view>
    <view v-if="items.length > 0" class="bar" :style="{ paddingBottom: (10 + safeBottom) + 'px' }">
      <view class="fill"><text class="t-hint">退款金额以审核结果为准</text></view>
      <view :class="['btn', 'bar-btn', 'submit-btn', canSubmit && !busy ? '' : 'btn-off']" @click="submit">
        <text class="btn-text">{{ busy ? '提交中…' : '提交申请' }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { createRefund, getOrder, uploadEvidence, ApiFailure } from '@/api/client.uts'
import { newIdempotencyKey } from '@/api/idempotency.uts'
import { refundableItems, refundReasonText, refundRequest, refundReturnAllowed, RefundableItem, RefundLine } from '@/api/view.uts'

type Opt = {
  value : number
  label : string
}

// 一张凭证图。state：uploading / done / failed。key 是这张图的幂等键，重试复用它。
type Evidence = {
  key : string
  path : string
  url : string
  state : string
}

export default {
  data() {
    return {
      orderNo: '',
      items: [] as RefundableItem[],
      // qty[i] 对应 items[i]：0 = 这一行不退。
      qty: [] as number[],
      types: [
        { value: 1, label: '仅退款' },
        { value: 2, label: '退货退款' },
      ] as Opt[],
      reasons: [] as Opt[],
      // 0 = 还没选。
      refundType: 0,
      reasonCode: 0,
      reasonText: '',
      returnAllowed: false,
      evidence: [] as Evidence[],
      loaded: false,
      error: '',
      message: '',
      busy: false,
      // 这张申请表单的幂等键：超时后再点「提交」是重放，不会开出两张售后单。
      // 改了内容再提交是「同键异体」422 —— 那时换一个键。
      idemKey: '',
      safeBottom: 0,
    }
  },
  computed: {
    canSubmit(): boolean {
      let any = false
      for (let i = 0; i < this.qty.length; i++) {
        if (this.qty[i] > 0) any = true
      }
      if (!any || this.refundType == 0 || this.reasonCode == 0) return false
      if (this.reasonCode == 5 && this.reasonText.trim() == '') return false
      // 还有图在传 / 传失败：等它传完，或者让用户删掉失败的那张 —— 不悄悄少交一张凭证。
      for (let i = 0; i < this.evidence.length; i++) {
        if (this.evidence[i].state != 'done') return false
      }
      return true
    },
  },
  onLoad(options: OnLoadOptions) {
    this.safeBottom = uni.getWindowInfo().safeAreaInsets.bottom
    const raw = options['order_no']
    this.orderNo = raw != null ? (decodeURIComponent('' + raw) ?? '') : ''
    this.idemKey = newIdempotencyKey()
    const rs: Opt[] = []
    for (let c = 1; c <= 5; c++) rs.push({ value: c, label: refundReasonText(c) } as Opt)
    this.reasons = rs
    this.load()
  },
  methods: {
    load() {
      getOrder(this.orderNo,
        (d) => {
          const items = refundableItems(d)
          this.items = items
          this.returnAllowed = refundReturnAllowed(d)
          if (!this.returnAllowed && this.refundType == 2) this.refundType = 0
          const q: number[] = []
          // 只有一行时默认勾上全部可退件数；多行时让用户自己勾。
          for (let i = 0; i < items.length; i++) q.push(items.length == 1 ? items[i].maxQty : 0)
          this.qty = q
          this.loaded = true
        },
        (f: ApiFailure) => {
          this.error = f.message
          this.loaded = true
        })
    },
    pickType(t: number) {
      if (t == 2 && !this.returnAllowed) return
      this.refundType = t
    },
    pickImages() {
      const left = 9 - this.evidence.length
      if (left <= 0) return
      uni.chooseImage({
        count: left,
        sizeType: ['compressed'],
        // 只开相册：拍照要多申请相机权限，Android 还要配 FileProvider；凭证图通常本来就在相册里。
        sourceType: ['album'],
        success: (res) => {
          for (let i = 0; i < res.tempFilePaths.length && this.evidence.length < 9; i++) {
            const e = { key: newIdempotencyKey(), path: res.tempFilePaths[i], url: '', state: 'uploading' } as Evidence
            this.evidence.push(e)
            this.upload(e.key)
          }
        },
      })
    },
    evidenceAt(key: string): number {
      for (let i = 0; i < this.evidence.length; i++) {
        if (this.evidence[i].key == key) return i
      }
      return -1
    },
    upload(key: string) {
      const at = this.evidenceAt(key)
      if (at < 0) return
      uploadEvidence(this.evidence[at].path, key,
        (u) => {
          const i = this.evidenceAt(key)
          if (i < 0) return
          this.evidence[i].url = u.url
          this.evidence[i].state = 'done'
        },
        (f: ApiFailure) => {
          const i = this.evidenceAt(key)
          if (i < 0) return
          this.evidence[i].state = 'failed'
          this.message = '有一张图片没传上去：' + f.message
        })
    },
    retryUpload(idx: number) {
      this.evidence[idx].state = 'uploading'
      this.message = ''
      this.upload(this.evidence[idx].key)
    },
    removeEvidence(idx: number) {
      this.evidence.splice(idx, 1)
    },
    toggleItem(idx: number) {
      const q = this.qty.slice()
      q[idx] = q[idx] > 0 ? 0 : this.items[idx].maxQty
      this.qty = q
    },
    changeQty(idx: number, delta: number) {
      const next = this.qty[idx] + delta
      if (next < 1 || next > this.items[idx].maxQty) return
      const q = this.qty.slice()
      q[idx] = next
      this.qty = q
    },
    submit() {
      if (!this.canSubmit || this.busy) return
      const lines: RefundLine[] = []
      for (let i = 0; i < this.items.length; i++) {
        if (this.qty[i] > 0) lines.push({ orderItemId: this.items[i].orderItemId, quantity: this.qty[i] } as RefundLine)
      }
      const urls: string[] = []
      for (let i = 0; i < this.evidence.length; i++) urls.push(this.evidence[i].url)
      this.busy = true
      this.message = ''
      createRefund(refundRequest(lines, this.refundType, this.reasonCode, this.reasonText.trim(), urls), this.orderNo, this.idemKey,
        (r, _replayed) => {
          this.busy = false
          // redirectTo 而不是 navigateTo：返回键回到订单详情，不回到这张已经交掉的表单。
          uni.redirectTo({ url: '/pages/refund/detail?refund_no=' + encodeURIComponent(r.refund_no) })
        },
        (f: ApiFailure) => {
          this.busy = false
          // 409（件数超了 / 这一行已有在途售后 / 订单状态不能退）：可退件数变了，重读一次。
          this.message = f.message
          if (f.status == 409) this.load()
          if (f.status == 409 || f.status == 422) this.idemKey = newIdempotencyKey()
        })
    },
  },
}
</script>

<style>
.line {
  margin-top: 14px;
}
.check {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  border-width: 1px;
  border-style: solid;
  border-color: #CFC3B5;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}
.check-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.check-mark {
  font-size: 13px;
  color: #FFFDF9;
}
.thumb {
  width: 60px;
  height: 60px;
  border-radius: 10px;
}
.thumb-glyph {
  font-size: 24px;
}
.item-info {
  margin-left: 12px;
}
.qty-row {
  margin-top: 8px;
  align-self: flex-start;
}
.stepper {
  border-radius: 16px;
  background-color: #F3ECE3;
}
.step {
  width: 30px;
  height: 30px;
  align-items: center;
  justify-content: center;
}
.step-text {
  font-size: 18px;
  color: #3B2A20;
}
.step-num {
  min-width: 24px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  color: #2A211B;
}
.opts {
  margin-top: 12px;
}
.wrap {
  flex-wrap: wrap;
}
.opt {
  padding: 8px 16px;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  border-color: #E3D9CC;
  margin-right: 10px;
  margin-bottom: 10px;
}
.opt-on {
  background-color: #3B2A20;
  border-color: #3B2A20;
}
.opt-text {
  font-size: 14px;
  color: #2A211B;
}
.opt-text-on {
  font-size: 14px;
  color: #FFFDF9;
}
.type-note {
  margin-top: 2px;
}
.result-err {
  background-color: #F8EAE5;
}
.bar-btn {
  width: 140px;
}
.ev-grid {
  margin-top: 12px;
}
.ev-cell {
  width: 72px;
  height: 72px;
  border-radius: 10px;
  overflow: hidden;
  margin-right: 10px;
  margin-bottom: 10px;
  background-color: #F3ECE3;
}
.ev-img {
  width: 72px;
  height: 72px;
}
.ev-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 72px;
  height: 72px;
  background-color: rgba(42, 33, 27, 0.55);
  align-items: center;
  justify-content: center;
}
.ev-mask-text {
  font-size: 11px;
  color: #FFFDF9;
}
.ev-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 20px;
  height: 20px;
  border-bottom-left-radius: 8px;
  background-color: rgba(42, 33, 27, 0.6);
  align-items: center;
  justify-content: center;
}
.ev-del-text {
  font-size: 13px;
  color: #FFFDF9;
}
.ev-add {
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-style: dashed;
  border-color: #CFC3B5;
}
.ev-add-text {
  font-size: 26px;
  color: #A89C90;
}
</style>
