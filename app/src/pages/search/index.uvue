<template>
  <view class="page">
    <view class="bar-top row">
      <view class="box row">
        <text class="box-icon">⌕</text>
        <input
          class="box-input"
          type="text"
          v-model="keyword"
          placeholder="搜索商品，例如「连衣裙」「咖啡」"
          confirm-type="search"
          :maxlength="200"
          :focus="true"
          @confirm="submit"
        />
      </view>
      <text class="go" @click="submit">搜索</text>
    </view>

    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="state == 'idle'" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">⌕</text></view>
          <text class="t-sub">输入关键词，按相关度为你排好</text>
        </view>

        <view v-else-if="state == 'loading'" class="empty">
          <text class="t-hint">正在搜索…</text>
        </view>

        <view v-else-if="state == 'error'" class="card">
          <text class="t-err">{{ error }}</text>
          <view class="gap-m"></view>
          <view class="btn-ghost" @click="submit"><text class="btn-ghost-text">重试</text></view>
        </view>

        <view v-else-if="rows.length == 0" class="empty">
          <view class="empty-mark"><text class="empty-mark-text">☕</text></view>
          <text class="t-sub">没有找到「{{ searched }}」相关的商品</text>
        </view>

        <view v-else>
          <text class="t-hint count">「{{ searched }}」共 {{ rows.length }} 件，按相关度排序</text>
          <!-- 缺货的商品服务端也返回（排在最后，in_stock: false，契约 M3 起如此）：标出来、压暗，
               而不是藏掉 —— 用户搜的就是它时，「有这东西但暂时没货」比「搜不到」有用。 -->
          <view v-for="item in rows" :key="item.id" :class="['card-flat', 'hit', 'row', item.offShelf || item.soldOut ? 'hit-off' : '']" @click="open(item.id)">
            <view class="cover thumb" :style="{ backgroundColor: item.cover.color }">
              <image v-if="item.cover.imageUrl != ''" class="cover-img" :src="item.cover.imageUrl" mode="aspectFill"></image>
              <text v-else class="cover-glyph thumb-glyph">{{ item.cover.glyph }}</text>
            </view>
            <view class="fill hit-info">
              <text class="hit-title">{{ item.title }}</text>
              <text v-if="item.subtitle != ''" class="t-hint">{{ item.subtitle }}</text>
              <view v-if="item.promoTags.length > 0" class="tag-row">
                <text v-for="(tag, ti) in item.promoTags" :key="ti" class="promo-tag">{{ tag }}</text>
              </view>
              <view class="gap-s"></view>
              <view class="row">
                <text class="t-price">{{ item.priceText }}</text>
                <view v-if="item.offShelf || item.soldOut" class="badge badge-muted flag">
                  <text class="badge-text badge-muted-text soldout">{{ item.offShelf ? '已下架' : '缺货' }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { search, ApiFailure } from '@/api/client.uts'
import { searchHitRow, searchRequest, searchTraceId, ProductRow } from '@/api/view.uts'
import { searchClicked } from '@/api/search-trace.uts'
import { ensureStore, CurrentStore } from '@/api/store.uts'

export default {
  data() {
    return {
      keyword: '',
      // idle 还没搜 / loading / done / error
      state: 'idle',
      searched: '',
      rows: [] as ProductRow[],
      error: '',
      // 连着搜两次时，只认最后一次发出去的那个请求的结果。
      seq: 0,
      // 这批结果的 trace_id（效果回传用）。和 rows 同时换，所以点到的一定是这批里的商品。
      traceId: '',
    }
  },
  methods: {
    submit() {
      // 契约：query 1~200 个字符。空串服务端回 422，这里直接不发。
      const q = this.keyword.trim()
      if (q == '') return
      const query = q.length > 200 ? q.substring(0, 200) : q
      this.seq = this.seq + 1
      const mine = this.seq
      this.state = 'loading'
      this.searched = query
      // 检索结果的价格与在售范围同样按门店算（契约：store_id 与 GET /products
      // 的同名参数逐字同义）。门店通常已经在首页解析过了，这里是同步回调。
      ensureStore(
        (s: CurrentStore) => {
          if (mine != this.seq) return
          this.run(query, s.storeId, mine)
        },
        (f: ApiFailure) => {
          if (mine != this.seq) return
          this.error = f.message
          this.state = 'error'
        }
      )
    },
    run(query: string, storeId: number | null, mine: number) {
      search(
        searchRequest(query, 20, storeId),
        (res) => {
          if (mine != this.seq) return
          const rows: ProductRow[] = []
          for (let i = 0; i < res.items.length; i++) {
            rows.push(searchHitRow(res.items[i]))
          }
          this.rows = rows
          this.traceId = searchTraceId(res)
          this.state = 'done'
        },
        (f: ApiFailure) => {
          if (mine != this.seq) return
          this.error = f.message
          this.state = 'error'
        }
      )
    },
    open(id: number) {
      // 回传发了就不管，不等它、不因为它拦跳转。
      searchClicked(this.traceId, id)
      uni.navigateTo({ url: '/pages/products/detail?id=' + id.toString() })
    },
  },
}
</script>

<style>
.bar-top {
  padding: 10px 16px;
  background-color: #F6F1EA;
}
.box {
  flex: 1;
  height: 40px;
  border-radius: 20px;
  background-color: #EFE7DC;
  padding: 0 14px;
}
.box-icon {
  font-size: 17px;
  color: #A89C90;
  margin-right: 6px;
}
.box-input {
  flex: 1;
  height: 40px;
  font-size: 14px;
  color: #2A211B;
}
.go {
  margin-left: 12px;
  font-size: 15px;
  font-weight: bold;
  color: #3B2A20;
}
.count {
  padding: 4px 4px 0 4px;
}
.hit {
  padding: 12px;
}
.thumb {
  width: 72px;
  height: 72px;
  border-radius: 12px;
}
.thumb-glyph {
  font-size: 28px;
}
.hit-info {
  margin-left: 12px;
}
.hit-title {
  font-size: 15px;
  font-weight: bold;
  color: #2A211B;
}
.flag {
  margin-left: 10px;
}
.hit-off {
  opacity: 0.6;
}
</style>
