{
  // scripts/check_app_types.py 用的编译参数表。
  //
  // 它编译的**不是** app/src 本身，而是那个脚本在临时目录里造出来的一份副本：
  // .uts 改名成 .ts、import 里的 './x.uts' 改写成 './x.ts'。tsc 不认 .uts 后缀，
  // 而把源文件本身改名成 .ts 的话 uni-app x 的编译器又不认了 —— 两边都要伺候，
  // 只能在闸门这一侧做这个机械改写。改写规则就那两条，写在脚本里。
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],

    // strict 全开。这一层的全部价值就在于「契约改了，读它的地方会红」，
    // 而 strictNullChecks 关掉的话，可选字段从 `T | undefined` 塌成 `T`，
    // 少写一个判空不会红 —— 那正是这类客户端最常见的崩法。
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false,

    // vue 只用来解析 main.uts 那一个 import（以及 src/vue-shim.d.ts 的模块增强）。
    // 映到本目录的桩上，这道闸门就不需要 node_modules。
    "paths": { "vue": ["./vue.d.ts"] }
  },
  "include": ["."]
}
