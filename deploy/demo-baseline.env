# 演示栈基线：scripts/verify-demo.sh 的期望值。
#
# **这些数字不是随手填的，是 2026-10-06 从演示库实测出来的。**
# 之所以单独成文件、并且要求「相等才算过」：验收的价值在于它是判据，
# 一旦允许「大概差不多」，它就退化成又一份需要人肉对照的清单——而人肉对照
# 正是今天四次翻车的现场。
#
# 什么时候改这里：数据真的变了（演示站被访问过，订单数增长）或迁移动了。
# 注意订单数会涨，它是「≥」判据；授权条数、迁移版本是「=」判据，
# 对不上就是有人动过数据库结构而没同步到这里——**先查清是谁改的，别直接改基线。**

# 迁移版本。00333 删了 promotion_skus 的两列冗余字段。
EXPECT_MIGRATION_CORE=333
# inventory 是另一套迁移序列（版本表名也不同：goose_db_version_inventory），
# 2026-10-06 实测停在 300。
EXPECT_MIGRATION_INVENTORY=300

# keel_app 的授权条数。基线 353 是在 C 档拆分正确（见 verify 的 grants 段）时
# 测出来的。曾因 `GRANT ... ON ALL TABLES` 一度冲到 368，多出来的 15 条正是
# 拆分刻意收回的 inventories / inventory_logs / activity_stocks 等。
EXPECT_GRANT_COUNT=353
# pg_default_acl 至少 2 条（00003 / 00005 建的）。备份恢复后这表会被清空，
# 是 pg_dump -Fc 不含 ACL 的最早信号。
EXPECT_DEFAULT_ACL_MIN=2

# 业务数据存量。订单数会增长，用「≥」；其余为固定演示数据，用「=」更严。
EXPECT_ORDERS_MIN=1000
EXPECT_PRODUCTS_MIN=42
EXPECT_USERS_MIN=22
EXPECT_MERCHANTS_MIN=1

# driver=2 即对象存储（SeaweedFS）。曾丢过 compose.s3.yaml：记录 95 条一条不少，
# 但每条都读不出来。所以基线里的「≥ 95」是给数据用的，真正的护栏是脚本里
# 那条「下载一张图看字节数」。
EXPECT_S3_UPLOADS_MIN=90

# 演示站公网地址。外网不可达时先看本机 nginx/Caddy，别急着改代码。
KEEL_PUBLIC_URL=https://eshop.zzss.fun

# 地图底图来源。demo-env.sh 里天地图那行会被随后的一行覆盖成 osm
# （天地图 WAF 把本机 IP 当攻击封了，见 docs/POI-设计.md）。所以这里只能是 osm。
EXPECT_MAP_TILES=osm

# 查错误日志的时间窗口。
KEEL_LOG_WINDOW=30m