# 复制成 .env.prod 再改：cp .env.prod.example .env.prod，或者直接 make init（会顺手生成三个随机值）。
# compose.prod.yaml 用 ${VAR:?} 读它们，缺任何一项都在 compose 解析阶段就停 ——
# 这正是要的效果：宁可起不来，也不要带着公开在仓库里的默认口令跑起来。

# ── 必填 ──────────────────────────────────────────────

# PostgreSQL 超级用户 keel 的口令。migrate 与 bootstrap.sql 都用它连。
#
# **数据卷一旦初始化，这个值就再也不生效** —— PostgreSQL 只在 initdb 时读一次。
# 忘了改的后果：migrate 用新口令连不上，报的是「密码错误」，而真因是卷还是老的。
# 换口令的正确做法是 ALTER ROLE keel PASSWORD '...'，改完重启栈。
KEEL_ADMIN_PASSWORD=

# 应用角色 keel_app 的口令（不是超级用户，见 compose.yaml:162 那段 RLS 的论证）。
#
# **只在角色首次创建时生效**。db/migrations/00003 刻意不写成无条件 ALTER ROLE：
# 角色是集群级对象而 GRANT 是单库的，无条件的话给第二个库跑 goose up 就会把生产上
# 已经设好的强口令静默重置回开发默认值 —— 没有报错，没有痕迹。
# 所以首次部署后要轮换，得单独执行：ALTER ROLE keel_app PASSWORD '...'; 然后同步改这里。
KEEL_APP_PASSWORD=

# 买家令牌的 HMAC 签名密钥。生成：openssl rand -base64 48
# 留空的话应用会随机取一个并打 WARN，症状是每次重启全体买家被登出一次；
# 多实例部署下各实例密钥不同，症状是「刷新几次就要重新登录」。
KEEL_AUTH_SECRET=

# 商家 code。小写字母数字，deploy/bootstrap.sql 用它建这家店。
# 它同时就是 KEEL_DEFAULT_MERCHANT —— 应用启动时 tenant.Preflight 会核对库里这家店
# 存在且可服务，对不上直接拒绝启动。症状是全站 404，不会有人指向这个变量。
KEEL_DEFAULT_MERCHANT=

# 店名。纯展示用，bootstrap.sql 插进 merchants.name。
KEEL_MERCHANT_NAME=

# ── 选填 ──────────────────────────────────────────────

# 宿主机端口。app 默认只绑 127.0.0.1，对外入口走 console 或宿主机上的反向代理。
KEEL_HTTP_PORT=8080
KEEL_CONSOLE_PORT=8081

# 前面挂了 nginx / Caddy 就填它的网段，例如 10.0.0.0/8、172.18.0.0/16。
# 不填 = 不信任任何代理头，于是限流拿到的全是代理 IP，全站客人共用一个额度。
KEEL_TRUSTED_PROXIES=

# Go module 代理。生产栈默认本地构建，Dockerfile 里那步 `go mod download` 走的就是它。
# 默认的 proxy.golang.org 在中国大陆与部分云网络里连不上（实测 dial i/o timeout），
# 症状是构建在第 4 步失败、报 go mod download exit 1，而日志里只有一行网络超时。
# 传空则用 Go 的默认值。
GOPROXY=https://goproxy.cn,direct

# 只有走 compose.release.yaml（预构建镜像）时才需要，填版本号如 v0.7.0。
KEEL_IMAGE_TAG=
